  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <script is:inline>
    // Mobile browsers (Safari especially) restore the previous scroll position on a plain
    // reload, not just on back/forward. With a 400vh pinned hero, that means a reload can land
    // you deep inside the article text with no obvious hero above it — looks broken even though
    // nothing actually is. Force reloads/direct visits to start at the very top; leave deep-link
    // hashes (e.g. #yoda from the cast-nav) alone since those are an intentional destination.
    if (!location.hash) {
      console.log("[hero-scrub] forcing scroll to top, initial scrollY was", window.scrollY);
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      window.scrollTo(0, 0);
      requestAnimationFrame(() => {
        window.scrollTo(0, 0);
        console.log("[hero-scrub] rAF scroll-to-top, scrollY now", window.scrollY);
      });
      // iOS can re-apply its own restored offset asynchronously right around first paint —
      // pageshow also covers the bfcache-restore case (swipe-back navigation).
      window.addEventListener("pageshow", (e) => {
        console.log("[hero-scrub] pageshow fired, persisted:", e.persisted, "scrollY:", window.scrollY);
        if (!location.hash) window.scrollTo(0, 0);
      });
    }
  </script>

