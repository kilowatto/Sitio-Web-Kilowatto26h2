<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&display=swap"
  rel="stylesheet"
/>

<script>
  // Reveal-on-scroll for every illustration plate.
  const plates = document.querySelectorAll<HTMLElement>("[data-plate]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("tb-is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
    );
    plates.forEach((p) => io.observe(p));
  } else {
    plates.forEach((p) => p.classList.add("tb-is-visible"));
  }

  // The traveling lamp: --tb-scroll tracks 0..1 progress through the page, rAF-throttled.
  const page = document.getElementById("tb-page");
  let ticking = false;
  function updateScroll() {
    ticking = false;
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const frac = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    page?.style.setProperty("--tb-scroll", String(frac));
  }
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateScroll);
      }
    },
    { passive: true }
  );
  updateScroll();

  // Ambient dust motes drifting in the dark -- cheap canvas particles, paused for
  // reduced-motion visitors.
  const canvas = document.getElementById("tb-motes") as HTMLCanvasElement | null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (canvas && !reduceMotion) {
    const ctx = canvas.getContext("2d");
    if (ctx) {
      function resize() {
        canvas!.width = window.innerWidth;
        canvas!.height = window.innerHeight;
      }
      resize();
      window.addEventListener("resize", resize);
      const COUNT = 46;
      const motes = Array.from({ length: COUNT }, () => ({
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        r: Math.random() * 1.4 + 0.4,
        vy: Math.random() * -0.15 - 0.03,
        vx: (Math.random() - 0.5) * 0.08,
        a: Math.random() * 0.5 + 0.15,
      }));
      function frame() {
        if (!ctx) return;
        ctx.clearRect(0, 0, canvas!.width, canvas!.height);
        for (const m of motes) {
          m.x += m.vx;
          m.y += m.vy;
          if (m.y < -5) m.y = canvas!.height + 5;
          if (m.x < -5) m.x = canvas!.width + 5;
          if (m.x > canvas!.width + 5) m.x = -5;
          ctx.beginPath();
          ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(217, 168, 78, ${m.a})`;
          ctx.fill();
        }
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }
  }
</script>
