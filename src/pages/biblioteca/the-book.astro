---
// Secret showcase page for "The Book" (Hungry Minds) -- unlike the Harry Potter/Riordanverse/
// Arrakis themed pages, there is NO portal card pointing here: the only way in is clicking the
// book's own cover thumbnail in the normal /biblioteca list (see BookList.astro's `b.id === 91`
// branch).
//
// V2 (rebuilt per Esteban's direct feedback on the first version): the illustrations ARE the
// background now, not small captioned plates -- a fixed full-bleed filmstrip of his real photos
// that tracks HORIZONTALLY as the visitor scrolls VERTICALLY (deliberately counter-intuitive,
// his own words), while text arrives as floating cards on top. The first version dimmed and
// shrank the artwork to make room for page chrome; this one does the opposite -- the art stays
// large and undimmed, and text gets out of its way except where it's actually reading.
import Site from "../../layouts/Site.astro";
import { env } from "cloudflare:workers";

interface BookRow {
  id: number;
  title: string;
  cover_r2_key: string | null;
}

let book: BookRow | null = null;
if (env?.DB) {
  book = await env.DB.prepare(`SELECT id, title, cover_r2_key FROM books WHERE id = 91`).first<BookRow>();
}

const ILLUS = "biblioteca/the-book-illustrations";

// The horizontal filmstrip, in scroll order. Each frame is a full-viewport background frame;
// scroll position (0..1 down the page) maps to how far the strip has slid left.
const FRAMES = [
  { key: book?.cover_r2_key ?? `${ILLUS}/bee-smoker.webp`, alt: "Portada de The Book" },
  { key: `${ILLUS}/postage-stamps.webp`, alt: "Estampillas de fantasía del empaque original, con el sello EST. 2020" },
  { key: `${ILLUS}/astrolabe-tools.webp`, alt: "Medallón circular con herramientas de precisión" },
  { key: `${ILLUS}/lev-kaplan-portrait.webp`, alt: "Lev Kaplan, ilustrador principal, en Stuttgart" },
  { key: `${ILLUS}/sword-torch-handles.webp`, alt: "Detalle ornamentado de una espada y una antorcha" },
  { key: `${ILLUS}/welding-torch.webp`, alt: "Soldador con máscara y antorcha de inducción" },
  { key: `${ILLUS}/bicycle-mechanism.webp`, alt: "Diagrama numerado de la transmisión de una bicicleta" },
  { key: `${ILLUS}/bicycle-full.webp`, alt: "Bicicleta completa de cuadro alado" },
  { key: `${ILLUS}/combustion-engine.webp`, alt: "Corte de un motor de combustión interna" },
  { key: `${ILLUS}/organ-column.webp`, alt: "Corte de una columna arquitectónica, estilo órgano" },
  { key: `${ILLUS}/bee-anatomy.webp`, alt: "Anatomía de la cabeza de una abeja, numerada" },
  { key: `${ILLUS}/tree-root-creature.webp`, alt: "Bonsái fusionado con una criatura de raíces" },
  { key: `${ILLUS}/shiva-yoga.webp`, alt: "Deidad azul de seis brazos, capítulo de yoga" },
  { key: `${ILLUS}/pedal-carriage.webp`, alt: "Carruaje de pedales con tres caballeros" },
  { key: `${ILLUS}/santa-parachute.webp`, alt: "Santa Claus descendiendo en paracaídas" },
  { key: `${ILLUS}/hungry-minds-founders.webp`, alt: "Los tres fundadores de Hungry Minds" },
];

// Short floating captions for the pure-gallery beats (no big card, just a chip -- the art does
// the talking). Keyed to the frame they should roughly line up with, purely for editorial pacing.
const CAPTIONS = [
  { text: "Soldadura por inducción. El capítulo de oficios no se anda con rodeos.", frame: 5 },
  { text: "Cada pieza de una transmisión, numerada como un plano de patente.", frame: 6 },
  { text: "La misma bicicleta, completa — el marco alado es puro Kaplan.", frame: 7 },
  { text: "Del motor de vapor al de combustión interna, pieza por pieza.", frame: 8 },
  { text: "Arquitectura como mecanismo: ni una columna es solo decorativa aquí.", frame: 9 },
  { text: "Apicultura, con el humo dibujado casi como una criatura aparte.", frame: 10 },
  { text: "Y luego la abeja misma, disecada en tinta hasta la probóscide.", frame: 10 },
  { text: "Uno de los guiños de Kaplan: un bonsái que también es otra cosa.", frame: 11 },
  { text: "El capítulo de yoga no explica solo la postura — explica la mitología detrás.", frame: 12 },
  { text: "Un carruaje a pedales para caballeros que no piensan bajarse a caminar.", frame: 13 },
  { text: "Hasta la logística de Santa Claus se resuelve con la física del libro.", frame: 14 },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: "The Book",
  alternateName: "The Book: La Guía Definitiva para Reconstruir la Civilización",
  author: { "@type": "Organization", name: "Hungry Minds", url: "https://hungryminds.com" },
  illustrator: { "@type": "Person", name: "Lev Kaplan" },
  publisher: { "@type": "Organization", name: "Duomo Ediciones" },
  isbn: "9791387574079",
  numberOfPages: 410,
  bookFormat: "https://schema.org/Hardcover",
  inLanguage: ["es", "en", "de", "it", "fr", "ja"],
  datePublished: "2025-11-03",
  image: book?.cover_r2_key ? `https://kilowatto.com/media/${book.cover_r2_key}?w=1200` : undefined,
  description:
    "Enciclopedia ilustrada de 410 páginas y más de 700 ilustraciones originales que enseña, capítulo a capítulo, cómo reconstruir la civilización desde cero. Nacida de una campaña de Kickstarter/Indiegogo en 2020 del colectivo Hungry Minds, con Lev Kaplan como ilustrador principal.",
  mainEntityOfPage: "https://kilowatto.com/biblioteca/the-book",
};
---

<Site
  title="Un libro para reconstruir la civilización — Esteban Rey"
  description="Por qué Esteban Rey tiene The Book (Hungry Minds) en su biblioteca: su historia, su ilustrador, sus creadores, y las páginas reales del ejemplar."
  active="/biblioteca"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="tb-gate" id="tb-gate">
    <svg viewBox="0 0 24 24" width="52" height="52" aria-hidden="true" class="tb-gate__icon">
      <rect x="6" y="2" width="12" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
      <line x1="10" y1="19" x2="14" y2="19" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <p class="tb-gate__text">Gira tu teléfono.<br />Este libro se lee apaisado.</p>
  </div>

  <div class="tb-page" id="tb-page">
    <div class="tb-bg" aria-hidden="true">
      <div class="tb-strip" id="tb-strip">
        {FRAMES.map((f) => (
          <div class="tb-frame">
            <img
              src={`/media/${f.key}?w=1800`}
              srcset={`/media/${f.key}?w=1000 1000w, /media/${f.key}?w=1800 1800w, /media/${f.key}?w=2400 2400w`}
              sizes="100vw"
              alt=""
              loading="eager"
            />
          </div>
        ))}
      </div>
    </div>
    <div class="tb-vignette" aria-hidden="true"></div>

    <div class="tb-content">
      <section class="tb-beat tb-beat--hero">
        <div class="tb-card tb-card--hero" data-reveal>
          <p class="tb-eyebrow">Biblioteca · fuera de catálogo</p>
          <h1>Cómo reconstruir<br />la civilización</h1>
          <p class="tb-card__sub">
            410 páginas, más de 700 ilustraciones originales, y un plan completo — del fuego a la aviación — por si
            algún día hay que empezar de nuevo.
          </p>
          <p class="tb-hero__scroll">Desliza hacia abajo ↓</p>
        </div>
      </section>

      <section class="tb-beat">
        <div class="tb-card" data-reveal>
          <p class="tb-eyebrow">Origen</p>
          <h2>Nació de una campaña, no de una editorial</h2>
          <p>
            En diciembre de 2020, tres personas con una idea rara —un libro grueso, ilustrado a mano, que enseñara a
            reconstruir la civilización desde el fuego hasta la aviación— la publicaron en Kickstarter e Indiegogo.
            Recaudaron más de <strong>3 millones de dólares</strong>, uno de los proyectos editoriales más
            financiados en la historia de Kickstarter.
          </p>
        </div>
      </section>

      <section class="tb-beat">
        <div class="tb-card tb-card--profile" data-reveal>
          <img
            src={`/media/${ILLUS}/lev-kaplan-portrait.webp?w=400`}
            alt="Retrato de Lev Kaplan"
            class="tb-card__portrait"
            loading="lazy"
          />
          <div>
            <p class="tb-eyebrow">El ilustrador</p>
            <h2>Una mano, miles de líneas</h2>
            <p>
              <strong>Lev Kaplan</strong>, nacido en Ucrania en 1967 y radicado hoy en Stuttgart, lideró al equipo de
              artistas y dibujó buena parte de las piezas él mismo: lápiz, luego plumilla con tinta acrílica,
              acuarela y gouache, sobre papel de algodón. Sus referencias declaradas: Brueghel el Viejo, Durero,
              Klimt, Norman Rockwell.
            </p>
            <p class="tb-card__meta">
              No encontré una cuenta personal suya — el equipo publica en
              <a href="https://www.instagram.com/hungryminds.publishing/" target="_blank" rel="noopener">@hungryminds.publishing</a>.
            </p>
          </div>
        </div>
      </section>

      {CAPTIONS.map((c) => (
        <section class="tb-beat tb-beat--caption">
          <p class="tb-chip" data-reveal>{c.text}</p>
        </section>
      ))}

      <section class="tb-beat">
        <div class="tb-card tb-card--profile" data-reveal>
          <img
            src={`/media/${ILLUS}/hungry-minds-founders.webp?w=500`}
            alt="Los tres fundadores de Hungry Minds"
            class="tb-card__portrait tb-card__portrait--wide"
            loading="lazy"
          />
          <div>
            <p class="tb-eyebrow">Los creadores</p>
            <h2>Hungry Minds</h2>
            <p>
              <strong>Vsevolod "Seva" Batichev</strong> y <strong>Timur Kadyrov</strong> fundaron el colectivo en
              2020, junto con <strong>Artur Stelmakh</strong>, socio experto en financiamiento colectivo. Ninguno
              venía de la industria editorial — vinieron de mecanismos, acertijos y ganas de contar historias.
            </p>
            <p class="tb-card__meta">
              Cuenta oficial: <a href="https://www.instagram.com/hungryminds.publishing/" target="_blank" rel="noopener">@hungryminds.publishing</a>
              · <a href="https://hungryminds.com" target="_blank" rel="noopener">hungryminds.com</a>
            </p>
          </div>
        </div>
      </section>

      <section class="tb-beat">
        <div class="tb-card" data-reveal>
          <p class="tb-eyebrow">Sin atajos</p>
          <blockquote class="tb-quote">
            "The thing you've been expecting. Hefty, in a good way. Hand-illustrated by real artists. No AI
            involved."
          </blockquote>
          <p class="tb-card__meta">— la propia etiqueta de envío de Hungry Minds, escrita a mano.</p>
        </div>
      </section>

      <section class="tb-beat">
        <div class="tb-card" data-reveal>
          <p class="tb-eyebrow">Si lo quieres para ti</p>
          <h2>Existe en seis idiomas</h2>
          <p>
            Español, inglés, alemán, italiano, francés y japonés — más una edición especial en caja. El ejemplar de
            Esteban es la edición en español, publicada por Duomo Ediciones. Se consigue directo con
            <a href="https://hungryminds.com" target="_blank" rel="noopener">Hungry Minds</a>.
          </p>
        </div>
      </section>
    </div>
  </div>
</Site>

<style>
  :root {
    --tb-void: #0b0a08;
    --tb-lamp: #d9a84e;
    --tb-lamp-soft: #f0c878;
    --tb-parchment: #ece2c6;
  }

  .tb-page {
    position: relative;
    background: var(--tb-void);
    color: var(--tb-parchment);
    margin: calc(-1 * var(--space-3)) 0 0;
  }

  /* The background IS the artwork -- fixed, full-bleed, undimmed. Scroll moves it
     horizontally (sideways), on purpose: this page is the one place the art isn't
     competing with page chrome for attention. */
  .tb-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .tb-strip {
    display: flex;
    height: 100%;
    will-change: transform;
  }
  .tb-frame {
    flex: 0 0 100vw;
    height: 100%;
    position: relative;
  }
  .tb-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tb-vignette {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(120% 100% at 50% 50%, transparent 45%, rgba(11, 10, 8, 0.55) 100%);
  }

  .tb-content {
    position: relative;
    z-index: 2;
  }

  .tb-beat {
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
  }
  .tb-beat--caption {
    min-height: 55vh;
  }

  .tb-eyebrow {
    font-family: var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-size: 0.74rem;
    color: var(--tb-lamp);
    margin: 0 0 0.5rem;
  }

  .tb-card {
    max-width: 32rem;
    background: rgba(11, 10, 8, 0.62);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(217, 168, 78, 0.2);
    border-radius: 0.5rem;
    padding: var(--space-3) var(--space-3);
    box-shadow: 0 2rem 4rem -1.5rem rgba(0, 0, 0, 0.7);
  }
  .tb-card h1,
  .tb-card h2 {
    font-family: "Fraunces", var(--font-display), Georgia, serif;
    color: var(--tb-parchment);
    margin: 0 0 0.7rem;
    text-wrap: balance;
    line-height: 1.08;
  }
  .tb-card h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
  }
  .tb-card h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .tb-card p {
    color: #e7dcc0;
    line-height: 1.6;
    margin: 0 0 0.7rem;
  }
  .tb-card p:last-child {
    margin-bottom: 0;
  }
  .tb-card strong {
    color: var(--tb-lamp-soft);
    font-weight: 600;
  }
  .tb-card a {
    color: var(--tb-lamp-soft);
  }
  .tb-card__meta {
    font-size: 0.86rem;
    color: #b7a97f !important;
  }
  .tb-card--hero {
    text-align: center;
  }
  .tb-hero__scroll {
    margin: var(--space-2) 0 0 !important;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    color: #b7a97f !important;
    animation: tb-bob 2.4s ease-in-out infinite;
  }
  @keyframes tb-bob {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(0.4rem); opacity: 1; }
  }

  .tb-card--profile {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    max-width: 40rem;
  }
  .tb-card__portrait {
    width: 8rem;
    height: 8rem;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid rgba(217, 168, 78, 0.4);
    flex-shrink: 0;
  }
  .tb-card__portrait--wide {
    width: 10rem;
    height: 8rem;
    border-radius: 0.4rem;
  }
  @media (max-width: 640px) {
    .tb-card--profile {
      flex-direction: column;
      text-align: center;
    }
  }

  .tb-quote {
    font-family: "Fraunces", var(--font-display), Georgia, serif;
    font-style: italic;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    line-height: 1.5;
    color: var(--tb-lamp-soft);
    margin: 0 0 0.7rem;
  }

  .tb-chip {
    max-width: 26rem;
    background: rgba(11, 10, 8, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 999px;
    padding: 0.7rem 1.3rem;
    color: var(--tb-parchment);
    font-size: 0.95rem;
    line-height: 1.4;
    text-align: center;
    box-shadow: 0 1rem 2.5rem -1rem rgba(0, 0, 0, 0.6);
  }

  /* Reveal-on-scroll for the floating text -- "flotan o llegan o aparecen." */
  [data-reveal] {
    opacity: 0;
    transform: translateY(1.4rem);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  [data-reveal].tb-is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-reveal].tb-is-visible {
      transition: opacity 0.3s ease;
      transform: none;
      opacity: 1;
    }
    .tb-hero__scroll {
      animation: none;
    }
    .tb-strip {
      transition: none !important;
    }
  }

  /* Forced-landscape gate on small portrait screens -- this page reads apaisado. */
  .tb-gate {
    display: none;
  }
  @media (max-width: 900px) and (orientation: portrait) {
    .tb-gate {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 999;
      background: var(--tb-void);
      color: var(--tb-parchment);
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 1.2rem;
      text-align: center;
      padding: 2rem;
    }
    .tb-gate__icon {
      color: var(--tb-lamp);
      animation: tb-rotate-hint 2.2s ease-in-out infinite;
    }
    .tb-gate__text {
      font-family: "Fraunces", var(--font-display), Georgia, serif;
      font-size: 1.15rem;
      line-height: 1.5;
      max-width: 18rem;
    }
    .tb-page {
      display: none;
    }
  }
  @keyframes tb-rotate-hint {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(90deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tb-gate__icon {
      animation: none;
    }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&display=swap"
  rel="stylesheet"
/>

<script>
  // The counter-intuitive move: vertical scroll drives a HORIZONTAL slide of the fixed
  // background filmstrip, rAF-throttled.
  const strip = document.getElementById("tb-strip") as HTMLElement | null;
  let ticking = false;
  function updateStrip() {
    ticking = false;
    if (!strip) return;
    const doc = document.documentElement;
    const maxScroll = doc.scrollHeight - doc.clientHeight;
    const frac = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
    const maxShift = strip.scrollWidth - window.innerWidth;
    strip.style.transform = `translateX(${-frac * maxShift}px)`;
  }
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateStrip);
      }
    },
    { passive: true }
  );
  window.addEventListener("resize", updateStrip);
  updateStrip();

  // Reveal-on-scroll for floating text cards/chips.
  const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("tb-is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.35 }
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add("tb-is-visible"));
  }
</script>
