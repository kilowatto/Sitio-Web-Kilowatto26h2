---
// Dedicated themed sub-page for Esteban's Riordanverse shelf — same pattern as
// /biblioteca/harry-potter.astro (its own dark, immersive treatment instead of living inside
// the site's normal light theme), but with its own visual language: ocean/celestial-bronze
// instead of parchment/wand, since this is a completely different mythological world (actually
// four: Greek, Roman, Norse, Egyptian — Riordan's "worlds" all live under one roof here).
// All these books are ALSO real rows in the shared `books` table (owned AND wishlist), so they
// still show up in the normal /biblioteca list/search — this page is purely a richer display.
import Site from "../../layouts/Site.astro";
import { env } from "cloudflare:workers";

interface RiordanBook {
  id: number;
  title: string;
  series: string;
  status: string;
  reading_order: number | null;
  cover_r2_key: string | null;
  price_current: number | null;
}

let books: RiordanBook[] = [];
if (env?.DB) {
  const { results } = await env.DB.prepare(
    `SELECT id, title, series, status, reading_order, cover_r2_key, price_current FROM books
     WHERE author LIKE '%Riordan%' ORDER BY reading_order ASC, id ASC`
  ).all<RiordanBook>();
  books = results ?? [];
}

const owned = books.filter((b) => b.status === "tengo");
const missing = books.filter((b) => b.status === "quiero");

const bySeries = (name: string) => owned.filter((b) => b.series === name);
const pj = bySeries("Percy Jackson y los Dioses del Olimpo");
const pjExtra = bySeries("Percy Jackson — complementario");
const heroes = bySeries("Los Héroes del Olimpo");
const magnus = bySeries("Magnus Chase y los Dioses de Asgard");
const apolo = bySeries("Las Pruebas de Apolo");
const kane = bySeries("Las Crónicas de Kane");

// Thematic backdrop per pantheon for the wishlist "cover" placeholders — pure CSS/unicode
// glyph watermarks, no external art needed, no real (copyrighted) cover art hotlinked.
const PANTHEON: Record<string, { cls: string; glyph: string; label: string }> = {
  "Las Crónicas de Kane": { cls: "pj-wish--egypt", glyph: "𓋹", label: "Mitología egipcia" },
  "Magnus Chase y los Dioses de Asgard": { cls: "pj-wish--norse", glyph: "ᛟ", label: "Mitología nórdica" },
  "Las Pruebas de Apolo": { cls: "pj-wish--apollo", glyph: "☉", label: "Mitología griega" },
  "Percy Jackson — complementario": { cls: "pj-wish--underworld", glyph: "★", label: "Mitología griega" },
};

function money(n: number) {
  return `~$${n.toLocaleString("es-MX", { minimumFractionDigits: 2 })}`;
}

function shortTitle(b: RiordanBook) {
  return b.title
    .replace(/^Percy Jackson y (los Dioses del Olimpo \d+: )?/i, "")
    .replace(/^Los Héroes del Olimpo \d+: /i, "")
    .replace(/^Magnus Chase y los Dioses de Asgard \d+: /i, "")
    .replace(/^Las Pruebas de Apolo [\d.]+: /i, "")
    .replace(/^Las Crónicas de Kane \d+: /i, "");
}

// Researched and cross-checked against the Riordan Wiki, Wikipedia and Theoi.com — see the
// closing "mito vs. libro" note for which parts are Riordan's own invented lore.
const MYTH_GLOSSARY = [
  {
    id: "pj",
    pantheon: "Griego",
    series: "Percy Jackson y los Dioses del Olimpo",
    intro:
      "Los doce olímpicos y los titanes que reinaron antes que ellos — la base de casi todo el Riordanverse. Zeus, Poseidón y Hades son \"los Tres Grandes\", ligados por un pacto (invención de Riordan, no mito real) de no tener más hijos semidioses.",
    gods: [
      { book: "Zeus", real: "Rey de los dioses, dios del cielo y el rayo. Hijo de Crono y Rea; gobierna el Olimpo." },
      { book: "Poseidón", real: "Dios del mar, los terremotos y los caballos. Padre de Percy Jackson." },
      { book: "Hades", real: "Dios del inframundo y la riqueza subterránea — su nombre significa \"el invisible\". No tiene trono en el Olimpo. Padre de Nico y Bianca di Angelo." },
      { book: "Hera", real: "Reina de los dioses, diosa del matrimonio y la familia. Hostil con los hijos semidioses de Zeus." },
      { book: "Deméter", real: "Diosa de la agricultura y las cosechas. Madre de Perséfone." },
      { book: "Atenea", real: "Diosa de la sabiduría y la guerra estratégica, nacida ya adulta de la cabeza de Zeus. Madre de Annabeth Chase." },
      { book: "Apolo", real: "Dios del sol, la música, la profecía y la medicina; patrono del Oráculo de Delfos. Hermano gemelo de Ártemis." },
      { book: "Ártemis", real: "Diosa virgen de la caza, la luna y los animales salvajes. Lidera a las Cazadoras; hermana gemela de Apolo." },
      { book: "Ares", real: "Dios de la guerra violenta y sangrienta, hijo de Zeus y Hera." },
      { book: "Afrodita", real: "Diosa del amor y la belleza. Madre de Piper McLean." },
      { book: "Hefesto", real: "Dios herrero, de la forja y el fuego. Padre de Leo Valdez." },
      { book: "Hermes", real: "Mensajero de los dioses; patrono de viajeros, ladrones y el comercio. Padre de Luke Castellan." },
      { book: "Dioniso (\"Sr. D\")", real: "Dios del vino y las fiestas. Dirige el Campamento Mestizo como castigo de Zeus." },
      { book: "Hestia", real: "Diosa del hogar; cedió su trono olímpico a Dioniso para mantener la paz entre los dioses." },
      { book: "Cronos (Kronos)", real: "El titán más joven; se tragó a sus propios hijos para no ser destronado. Antagonista principal de la saga original." },
      { book: "Atlas", real: "Titán condenado a sostener el cielo (no \"el mundo\", un error común) tras la guerra contra los titanes." },
      { book: "Prometeo", real: "Titán que robó el fuego para dárselo a la humanidad; castigado eternamente por ello." },
      { book: "Quirón", real: "Centauro sabio, entrenador legendario de héroes griegos; director de actividades del Campamento Mestizo." },
      { book: "Pan", real: "Dios de la naturaleza salvaje, buscado por el sátiro Grover Underwood a lo largo de la saga." },
      { book: "Las Moiras", real: "Cloto, Láquesis y Átropo — las tres hilanderas del destino." },
      { book: "Las Furias", real: "Alecto, Megera y Tisífone, diosas de la venganza contra asesinos y traidores." },
      { book: "Medusa", real: "Una de las Gorgonas; su mirada convierte en piedra. En el mito original, castigada por Atenea tras ser víctima de Poseidón." },
      { book: "Tifón", real: "El monstruo más temible engendrado por Gea, casi derrota a los dioses del Olimpo." },
      { book: "El Minotauro", real: "Mitad hombre, mitad toro; encerrado en el Laberinto de Creta. Primer monstruo que enfrenta Percy." },
    ],
  },
  {
    id: "heroes",
    pantheon: "Griego + romano",
    series: "Los Héroes del Olimpo",
    intro:
      "El mismo panteón, con dos caras: griega en el Campamento Mestizo, romana en el Campamento Júpiter. En la vida real, Roma sí adoptó y renombró a los dioses griegos (interpretatio romana) — pero la idea de que cada dios tiene dos \"personalidades\" distintas es invención de Riordan.",
    gods: [
      { book: "Zeus · romano: Júpiter", real: "Mismo rey del cielo; el Júpiter romano es más militar y ligado al Estado. Padre de Jason Grace (criado romano) y Thalia Grace (criada griega)." },
      { book: "Poseidón · romano: Neptuno", real: "El Neptuno romano es más sereno y naviero que el voluble Poseidón griego." },
      { book: "Hades · romano: Plutón", real: "Los romanos lo veneraban más abiertamente. Padre de Hazel Levesque (romana) y Nico di Angelo (griego)." },
      { book: "Hera · romano: Juno", real: "También diosa protectora del Estado en su forma romana; orquesta toda la profecía de los siete." },
      { book: "Atenea · romano: Minerva", real: "Versión romana menos guerrera, más ligada a los oficios." },
      { book: "Ares · romano: Marte", real: "El Marte romano es una guerra de honor y estrategia, frente al Ares griego, puro instinto sangriento. Padre de Frank Zhang." },
      { book: "Afrodita · romano: Venus", real: "La Venus romana además es madre mítica de Eneas, fundador legendario de Roma." },
      { book: "Hefesto · romano: Vulcano", real: "El Vulcano romano está más ligado al fuego destructivo y los volcanes." },
      { book: "Deméter · romano: Ceres", real: "De su nombre romano viene la palabra \"cereal\"." },
      { book: "Dioniso · romano: Baco", real: "Los libros marcan a propósito que \"Sr. D\" (griego) y Baco (romano) casi parecen personas distintas." },
      { book: "Hestia · romano: Vesta", real: "La Vesta romana da origen a las históricas Vestales, sacerdotisas reales de su templo en Roma." },
      { book: "Terminus", real: "Dios romano real de los límites y las fronteras; en los libros, un busto sin brazos que vigila fanáticamente el Campamento Júpiter." },
      { book: "Lupa", real: "\"La Loba\", eco de la loba que amamantó a Rómulo y Remo; entrena a los semidioses romanos antes de aceptarlos en el campamento." },
      { book: "Belona", real: "Diosa romana real de la guerra. Madre de Reyna, pretora del Campamento Júpiter." },
      { book: "Gea (Gaia)", real: "Diosa primordial de la Tierra misma. Antagonista principal de toda la serie, despertando para destruir a los dioses." },
      { book: "Porfirión", real: "Rey de los Gigantes en el mito, engendrado específicamente para vencer a Zeus." },
      { book: "Encélado", real: "Gigante nacido para enfrentar a Atenea — antagoniza directamente a Annabeth en los libros." },
      { book: "Polibotes", real: "Gigante nacido para enfrentar a Poseidón — antagoniza directamente a Percy." },
    ],
  },
  {
    id: "magnus",
    pantheon: "Nórdico",
    series: "Magnus Chase y los Dioses de Asgard",
    intro:
      "Los nueve mundos unidos por el árbol Yggdrasil: los Aesir (guerra y soberanía, en Asgard) y los Vanir (fertilidad y prosperidad, en Vanaheim), enfrentados a los gigantes en la cuenta regresiva hacia el Ragnarok — el fin del mundo nórdico.",
    gods: [
      { book: "Odín", real: "El Padre de Todo; sacrificó un ojo por sabiduría y se colgó de Yggdrasil nueve días para aprender las runas. Gobierna Asgard y el Valhalla." },
      { book: "Thor", real: "Dios del trueno, portador del martillo Mjölnir, protector de Asgard." },
      { book: "Loki", real: "Dios (gigante de nacimiento) del engaño; responsable de la muerte de Baldur. Antagonista principal de la saga." },
      { book: "Frigg", real: "Esposa de Odín; en el mito, no logró proteger a Baldur del muérdago que lo mató." },
      { book: "Baldur", real: "El más amado de los dioses; su muerte por una flecha de muérdago anuncia el inicio del Ragnarok." },
      { book: "Heimdal (Heimdall)", real: "Guardián del puente arcoíris Bifröst; anunciará el Ragnarok con su cuerno." },
      { book: "Tyr", real: "Dios de la guerra y la justicia; sacrificó su mano en la boca del lobo Fenrir para encadenarlo." },
      { book: "Sif", real: "Esposa de Thor, famosa por su cabello dorado (cortado por Loki como broma, repuesto por enanos herreros)." },
      { book: "Frey (Freyr)", real: "Dios vanir de la cosecha y la paz; renunció a su espada mágica por amor — ancestro directo de Magnus Chase, cuya trama gira en torno a esa misma espada." },
      { book: "Freya", real: "Diosa vanir del amor, la belleza y la magia; hermana gemela de Frey." },
      { book: "Fenrir", real: "El lobo monstruoso, hijo de Loki, destinado a devorar a Odín en el Ragnarok." },
      { book: "Jormundgander (\"Big J\")", real: "La serpiente que rodea el mundo, hijo de Loki, némesis mitológica de Thor." },
      { book: "Hel", real: "Gobernante del reino de los muertos por vejez o enfermedad. Hija de Loki." },
      { book: "Surt", real: "Gigante de fuego que, según la profecía, incendiará el mundo entero en el Ragnarok." },
      { book: "Las Nornas", real: "Urd, Verdandi y Skuld — las tejedoras del destino nórdico, equivalentes a las Moiras griegas." },
      { book: "Las Valquirias", real: "Las que eligen a los guerreros caídos para llevarlos al Valhalla. Samirah al-Abbas es una de ellas en los libros." },
      { book: "Yggdrasil", real: "El gran árbol del mundo que conecta y sostiene los nueve reinos nórdicos." },
      { book: "Ragnarok", real: "La batalla final profetizada en la que mueren la mayoría de dioses y gigantes, y el mundo renace — la amenaza que recorre toda la trilogía." },
    ],
  },
  {
    id: "apolo",
    pantheon: "Griego · continuación",
    series: "Las Pruebas de Apolo",
    intro:
      "El propio Apolo, convertido en el mortal torpe Lester Papadopoulos como castigo de Zeus, narra en primera persona. Reaparecen muchos dioses ya vistos en Percy Jackson — aquí solo lo nuevo de esta saga.",
    gods: [
      { book: "Apolo (\"Lester Papadopoulos\")", real: "Dios del sol, la música, la profecía y la medicina, patrono del Oráculo de Delfos. Obligado a servir a la semidiosa Meg McCaffrey hasta recuperar su divinidad." },
      { book: "Pitón (Python)", real: "La serpiente monstruosa que en el mito guardaba el oráculo original de Delfos antes de que Apolo la matara siendo bebé; en los libros, recupera el control del Oráculo." },
      { book: "El Oráculo de Delfos", real: "La sacerdotisa (Rachel Elizabeth Dare en los libros) por la que hablan las profecías de Apolo." },
      { book: "La Arboleda de Dodona", real: "El oráculo más antiguo de Zeus, donde sacerdotes interpretaban el susurro de un roble sagrado." },
      { book: "Las Nueve Musas", real: "Diosas de la inspiración artística, hijas de Zeus y Mnemósine (la Memoria) — Calíope, Clío, Melpómene y las demás." },
      { book: "El Triunvirato: Nerón, Calígula, Cómodo", real: "Emperadores romanos históricos reimaginados con inmortalidad retorcida — los antagonistas centrales de la saga." },
    ],
  },
  {
    id: "kane",
    pantheon: "Egipcio",
    series: "Las Crónicas de Kane",
    intro:
      "Carter y Sadie Kane, hermanos que descubren ser anfitriones de dioses egipcios, se enfrentan al despertar de la serpiente del caos.",
    gods: [
      { book: "Ra", real: "Dios del sol, antiguo rey de los dioses, mostrado anciano y adormilado en la serie." },
      { book: "Isis", real: "Diosa de la magia y la maternidad, esposa de Osiris." },
      { book: "Osiris", real: "Dios del inframundo y la resurrección. Su anfitrión es el padre de Carter y Sadie." },
      { book: "Horus", real: "Dios halcón del cielo y la realeza. Hospedado por Carter Kane." },
      { book: "Set", real: "Dios del caos, el desierto y las tormentas. Antagonista de la primera novela." },
      { book: "Anubis", real: "Dios de los muertos y la momificación. Interés romántico de Sadie Kane." },
      { book: "Bastet", real: "Diosa gata protectora, guardiana de Sadie de niña." },
      { book: "Thot", real: "Dios de la sabiduría, la escritura y la luna." },
      { book: "Apofis", real: "La serpiente del caos primigenio, el gran antagonista de la trilogía completa." },
    ],
  },
];
---

<Site
  title="El Riordanverse — Esteban Rey"
  description="El Riordanverse de Esteban Rey: Percy Jackson, Los Héroes del Olimpo, Magnus Chase, Las Pruebas de Apolo y Las Crónicas de Kane — griego, romano, nórdico y egipcio bajo un mismo librero."
  active="/biblioteca"
>
  <div class="pj-page" id="pj-page">
    <div class="pj-glow" id="pj-glow"></div>
    <div class="pj-pen-cursor" id="pj-pen-cursor">
      <div class="pj-pen-cursor__body"></div>
      <div class="pj-pen-cursor__tip"></div>
    </div>
    <div class="pj-sword-layer" id="pj-sword-layer"></div>

    {/* Power effects, all triggered by tracing real gestures with the cursor (see the
        gesture-recognition script near the bottom) -- Niebla is a press-and-hold, the rest are
        drawn shapes classified from the pointer path. Same engine as /biblioteca/harry-potter,
        recolored and remapped to demigod powers instead of spells. */}
    <div class="pj-fog-overlay" id="pj-fog-overlay"></div>
    <div class="pj-ola-flash" id="pj-ola-flash"></div>
    <div class="pj-fx-layer" id="pj-fx-layer" aria-hidden="true"></div>

    <section class="pj-secret" id="pj-secret" hidden>
      <div class="container">
        <p class="pj-eyebrow">Grieta</p>
        <p class="pj-secret__quote">Aquí no hay mortales que puedan ver esto — solo tú.</p>
        <p class="pj-secret__sub">Encontraste la grieta secreta de esta página. Ni Quirón sabe que está aquí — hasta ahora.</p>
      </div>
    </section>

    <section class="pj-hero">
      <div class="pj-hero__mosaic" aria-hidden="true">
        {[...pj, ...pjExtra].slice(0, 6).map((b) => (
          <img
            src={`/media/${b.cover_r2_key}?w=400`}
            srcset={`/media/${b.cover_r2_key}?w=400 400w, /media/${b.cover_r2_key}?w=700 700w`}
            sizes="17vw"
            alt=""
            loading="eager"
          />
        ))}
      </div>
      <div class="pj-hero__scrim"></div>
      <div class="pj-hero__wave" aria-hidden="true"></div>
      <div class="pj-hero__text container">
        <p class="pj-eyebrow">Biblioteca · Riordanverse</p>
        <h1>El Riordanverse</h1>
        <p class="pj-hero__sub">
          Griego, romano, nórdico y egipcio — todo lo que Rick Riordan ha escrito que Esteban tiene (y le falta) en
          un solo librero. Haz clic en cualquier parte de la página para desenfundar a <em>Contracorriente</em>.
        </p>
      </div>
    </section>

    <section class="pj-section">
      <div class="container">
        <p class="pj-eyebrow">Sobre este rincón</p>
        <h2>Cuatro mitologías, un solo héroe con espada-pluma</h2>
        <p class="pj-section__sub">
          Empieza con Percy Jackson descubriendo que es hijo de Poseidón, y termina con Magnus Chase esquivando el
          fin del mundo nórdico. Esta colección junta {owned.length} libros que Esteban ya tiene y {missing.length}{" "}
          que todavía le faltan.
        </p>
      </div>
    </section>

    <section class="pj-section pj-section--alt">
      <div class="container">
        <p class="pj-eyebrow">Griego</p>
        <h2>Percy Jackson y los Dioses del Olimpo</h2>
        <div class="pj-grid">
          {pj.map((b) => (
            <div class="pj-card" data-riptide>
              <span class="pj-card__order">{b.reading_order}</span>
              <div class="pj-card__mist">
                <img
                  src={`/media/${b.cover_r2_key}?w=300`}
                  srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                  sizes="200px"
                  alt=""
                  class="pj-card__img"
                  loading="lazy"
                />
              </div>
              <p class="pj-card__title">{shortTitle(b)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {pjExtra.length > 0 && (
      <section class="pj-section">
        <div class="container">
          <p class="pj-eyebrow">Griego · complementario</p>
          <h2>Historias sueltas del campamento</h2>
          <div class="pj-grid">
            {pjExtra.map((b) => (
              <div class="pj-card" data-riptide>
                <div class="pj-card__mist">
                  <img
                  src={`/media/${b.cover_r2_key}?w=300`}
                  srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                  sizes="200px"
                  alt=""
                  class="pj-card__img"
                  loading="lazy"
                />
                </div>
                <p class="pj-card__title">{shortTitle(b)}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="pj-section pj-section--alt">
      <div class="container">
        <p class="pj-eyebrow">Griego + romano</p>
        <h2>Los Héroes del Olimpo</h2>
        <p class="pj-section__sub">Campamento Mestizo (griego) y Campamento Júpiter (romano) — dos mitades del mismo panteón que aprenden a pelear juntas.</p>
        <div class="pj-grid">
          {heroes.map((b) => (
            <div class="pj-card" data-riptide>
              <span class="pj-card__order">{b.reading_order}</span>
              <div class="pj-card__mist">
                <img
                  src={`/media/${b.cover_r2_key}?w=300`}
                  srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                  sizes="200px"
                  alt=""
                  class="pj-card__img"
                  loading="lazy"
                />
              </div>
              <p class="pj-card__title">{shortTitle(b)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pj-section">
      <div class="container">
        <p class="pj-eyebrow">Nórdico</p>
        <h2>Magnus Chase y los Dioses de Asgard</h2>
        <div class="pj-grid">
          {magnus.map((b) => (
            <div class="pj-card" data-riptide>
              <span class="pj-card__order">{b.reading_order}</span>
              <div class="pj-card__mist">
                <img
                  src={`/media/${b.cover_r2_key}?w=300`}
                  srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                  sizes="200px"
                  alt=""
                  class="pj-card__img"
                  loading="lazy"
                />
              </div>
              <p class="pj-card__title">{shortTitle(b)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pj-section pj-section--alt">
      <div class="container">
        <p class="pj-eyebrow">Griego · después de la guerra</p>
        <h2>Las Pruebas de Apolo</h2>
        <p class="pj-section__sub">El propio dios Apolo, castigado a vivir como el mortal Lester Papadopoulos, cuenta esta parte en primera persona.</p>
        <div class="pj-grid">
          {apolo.map((b) => (
            <div class="pj-card" data-riptide>
              <span class="pj-card__order">{b.reading_order}</span>
              <div class="pj-card__mist">
                <img
                  src={`/media/${b.cover_r2_key}?w=300`}
                  srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                  sizes="200px"
                  alt=""
                  class="pj-card__img"
                  loading="lazy"
                />
              </div>
              <p class="pj-card__title">{shortTitle(b)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {kane.length > 0 && (
      <section class="pj-section">
        <div class="container">
          <p class="pj-eyebrow">Egipcio</p>
          <h2>Las Crónicas de Kane</h2>
          <p class="pj-section__sub">Carter y Sadie Kane, hermanos que descubren ser anfitriones de dioses egipcios, se enfrentan al despertar de la serpiente del caos.</p>
          <div class="pj-grid">
            {kane.map((b) => (
              <div class="pj-card" data-riptide>
                <span class="pj-card__order">{b.reading_order}</span>
                <div class="pj-card__mist">
                  <img
                    src={`/media/${b.cover_r2_key}?w=300`}
                    srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                    sizes="200px"
                    alt=""
                    class="pj-card__img"
                    loading="lazy"
                  />
                </div>
                <p class="pj-card__title">{shortTitle(b)}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="pj-section pj-section--wishlist">
      <div class="container">
        <p class="pj-eyebrow">Lista de deseos</p>
        <h2>Me faltan {missing.length} libros del Riordanverse</h2>
        <p class="pj-section__sub">
          Las Crónicas de Kane completas, más un puñado de huecos sueltos en Magnus Chase, Las Pruebas de Apolo y las
          historias de Nico di Angelo. Ninguno tiene portada real todavía — así que aquí les tocó una portada de
          cartulina, según su panteón.
        </p>
        <div class="pj-wish-scatter" aria-hidden="true">
          <span>ufff, ojalá algún día lo tenga</span>
          <span>ya casi lo compro…</span>
          <span>se aceptan indirectas</span>
        </div>
        <div class="pj-grid pj-grid--wish">
          {missing.map((b) => {
            const theme = PANTHEON[b.series] ?? { cls: "pj-wish--apollo", glyph: "☉", label: "Griego" };
            return (
              <div class={`pj-wish-card ${theme.cls}`} data-wish>
                <span class="pj-wish-card__glyph" aria-hidden="true">{theme.glyph}</span>
                <p class="pj-wish-card__pantheon">{theme.label}</p>
                <p class="pj-wish-card__title">{shortTitle(b)}</p>
                {typeof b.price_current === "number" && <p class="pj-wish-card__price">{money(b.price_current)}</p>}
                <p class="pj-wish-card__caption" data-caption></p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="pj-section pj-section--alt">
      <div class="container">
        <p class="pj-eyebrow">Para ir a internet menos</p>
        <h2>Quién es quién: la mitología real detrás de cada dios</h2>
        <p class="pj-section__sub">Cada saga toma un panteón real y le pone nombre, voz y personalidad de novela — esto es quién es cada quién de verdad.</p>
        <div class="pj-myth-list">
          {MYTH_GLOSSARY.map((m) => (
            <details class="pj-myth" id={`myth-${m.id}`}>
              <summary>
                <span class="pj-myth__pantheon">{m.pantheon}</span>
                <span class="pj-myth__series">{m.series}</span>
                <span class="pj-myth__hint">Toca para ver los dioses →</span>
              </summary>
              <p class="pj-myth__intro">{m.intro}</p>
              <dl class="pj-myth__grid">
                {m.gods.map((g) => (
                  <div class="pj-myth__entry">
                    <dt>{g.book}</dt>
                    <dd>{g.real}</dd>
                  </div>
                ))}
              </dl>
            </details>
          ))}
        </div>
        <p class="pj-myth-note">
          <strong>Mito vs. libro:</strong> el pacto de "los Tres Grandes" de no tener más hijos semidioses, la idea de
          que cada dios tiene una "personalidad" griega y otra romana, y que Magnus y Annabeth Chase son primos —
          son todo invención de Riordan, no mitología real. La interpretatio romana (que Roma sí adoptó y renombró a
          los dioses griegos) es real; lo de la doble personalidad no lo es.
        </p>
      </div>
    </section>

    <section class="pj-section pj-section--alt pj-iris-section">
