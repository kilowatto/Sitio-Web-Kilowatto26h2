<script>
  const page = document.getElementById("pj-page");
  const glow = document.getElementById("pj-glow");
  const pen = document.getElementById("pj-pen-cursor");
  const swordLayer = document.getElementById("pj-sword-layer");

  if (page && glow && pen && window.matchMedia("(pointer: fine)").matches) {
    page.addEventListener("pointerenter", () => page.classList.add("pj-active"));
    page.addEventListener("pointerleave", () => page.classList.remove("pj-active"));
    page.addEventListener("pointermove", (e) => {
      glow.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
      pen.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    });
  }

  // Click anywhere: Contracorriente unsheathes for a moment, then fades back to a plain pen.
  document.addEventListener("click", (e) => {
    if (!swordLayer) return;
    const flash = document.createElement("div");
    flash.className = "pj-sword-flash";
    flash.style.left = `${e.clientX}px`;
    flash.style.top = `${e.clientY}px`;
    const label = document.createElement("div");
    label.className = "pj-sword-label";
    label.style.left = `${e.clientX}px`;
    label.style.top = `${e.clientY}px`;
    label.textContent = "¡Contracorriente!";
    swordLayer.appendChild(flash);
    swordLayer.appendChild(label);
    flash.addEventListener("animationend", () => flash.remove());
    label.addEventListener("animationend", () => label.remove());
  });

  // Random rotating caption per missing book — refreshes to a different mix on every load.
  const CAPTIONS = [
    "Ufff, ojalá algún día lo tenga.",
    "Ya casi lo compro… lo prometo.",
    "A ver si mañana ya voy y lo compro.",
    "¿Alguien me lo regala, por favor?",
    "Sigue en mi lista desde hace rato.",
    "Cada que lo veo en la librería lo cargo… y lo vuelvo a dejar.",
    "Este me falta. Se aceptan indirectas.",
    "Lo tengo apartado en mi cabeza, no en mi librero.",
  ];
  document.querySelectorAll("[data-caption]").forEach((el) => {
    el.textContent = CAPTIONS[Math.floor(Math.random() * CAPTIONS.length)];
  });
</script>

<script>
  // Demigod-power gesture recognition: trace a shape with the cursor (pointerdown -> move ->
  // up) and it gets classified into one of 7 powers, on top of the plain click-anywhere sword
  // flash above. Same engine as /biblioteca/harry-potter (see that page for the shape math),
  // just remapped and recolored — holding still is Niebla, the rest are traced shapes.
  (() => {
    const page = document.getElementById("pj-page");
    const fogOverlay = document.getElementById("pj-fog-overlay");
    const olaFlash = document.getElementById("pj-ola-flash");
    const fxLayer = document.getElementById("pj-fx-layer");
    const secret = document.getElementById("pj-secret");
    if (!page || !fogOverlay || !olaFlash || !fxLayer) return;
    if (!window.matchMedia("(pointer: fine)").matches) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const HOLD_MS = 1800;
    const FOG_MS = 8000;
    // A real trace, even a slow, careful one (Égida's "small" circle, a hesitant pause
    // before Viento/Silbido), must cancel the hold almost as soon as it starts moving --
    // otherwise the time it takes to drift this many pixels can outlast HOLD_MS on its own,
    // firing Niebla mid-gesture and eating the classify() call the real shape needed.
    const HOLD_MOVE_TOLERANCE = 6;

    let points = [];
    let isDown = false;
    let downX = 0;
    let downY = 0;
    let holdTimer = null;
    let holdFired = false;
    let fogActive = false;

    function clearHoldTimer() {
      if (holdTimer) {
        clearTimeout(holdTimer);
        holdTimer = null;
      }
    }

    function fireNiebla() {
      if (fogActive) return;
      fogActive = true;
      fogOverlay.classList.add("pj-fog-overlay--active");
      setTimeout(() => {
        fogOverlay.classList.remove("pj-fog-overlay--active");
        fogActive = false;
      }, FOG_MS);
    }

    function spawnBolt(x, y) {
      const el = document.createElement("div");
      el.className = "pj-fx-bolt";
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      fxLayer.appendChild(el);
      setTimeout(() => el.remove(), 500);
    }

    function spawnCrack(x, y, onDone) {
      const el = document.createElement("div");
      el.className = "pj-fx-crack";
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      el.innerHTML = '<div class="pj-fx-crack__glow"></div><div class="pj-fx-crack__line"></div>';
      fxLayer.appendChild(el);
      setTimeout(() => {
        el.remove();
        onDone();
      }, 1600);
    }

    function triggerGrieta(x, y) {
      spawnCrack(x, y, () => {
        if (!secret) return;
        secret.hidden = false;
        secret.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "center" });
      });
    }

    function triggerOla(x, y) {
      olaFlash.style.setProperty("--px", `${x}px`);
      olaFlash.style.setProperty("--py", `${y}px`);
      olaFlash.classList.remove("pj-ola-flash--active");
      void (olaFlash as HTMLElement).offsetWidth;
      olaFlash.classList.add("pj-ola-flash--active");
    }

    function triggerEgida(card) {
      if (!(card instanceof HTMLElement)) return;
      card.classList.remove("pj-card--shielded");
      void card.offsetWidth;
      card.classList.add("pj-card--shielded");
      setTimeout(() => card.classList.remove("pj-card--shielded"), 1600);
    }

    function triggerViento(card) {
      if (!(card instanceof HTMLElement)) return;
      card.classList.remove("pj-card--levitate");
      void card.offsetWidth;
      card.classList.add("pj-card--levitate");
      setTimeout(() => card.classList.remove("pj-card--levitate"), 2800);
    }

    function triggerTridente() {
      page.classList.remove("pj-page--tridente");
      void (page as HTMLElement).offsetWidth;
      page.classList.add("pj-page--tridente");
      setTimeout(() => page.classList.remove("pj-page--tridente"), 700);
    }

    function cardNear(x, y) {
      const el = document.elementFromPoint(x, y);
      return el ? el.closest(".pj-card") : null;
    }

    // Classifies the traced path into a power on release. Order matters: most specific shape
    // (figure-eight) first, then closed loops, then scribbles/flicks/stabs.
    function classify() {
      if (points.length < 4) return;
      const start = points[0];
      const end = points[points.length - 1];
      const duration = end.t - start.t;
      let dist = 0;
      let minX = start.x,
        maxX = start.x,
        minY = start.y,
        maxY = start.y;
      let local = 0;
      let bestPos = 0;
      let bestNeg = 0;
      let dxReversals = 0;
      let prevDx = 0;
      let prevAngle = null;

      for (let i = 1; i < points.length; i++) {
        const a = points[i - 1];
        const b = points[i];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        dist += Math.hypot(dx, dy);
        minX = Math.min(minX, b.x);
        maxX = Math.max(maxX, b.x);
        minY = Math.min(minY, b.y);
        maxY = Math.max(maxY, b.y);
        if (Math.abs(dx) > 2) {
          if (prevDx !== 0 && Math.sign(dx) !== Math.sign(prevDx)) dxReversals++;
          prevDx = dx;
        }
        if (Math.hypot(dx, dy) > 3) {
          const angle = Math.atan2(dy, dx);
          if (prevAngle !== null) {
            let delta = angle - prevAngle;
            while (delta > Math.PI) delta -= Math.PI * 2;
            while (delta < -Math.PI) delta += Math.PI * 2;
            local = local === 0 || Math.sign(delta) === Math.sign(local) ? local + delta : delta;
            bestPos = Math.max(bestPos, local);
            bestNeg = Math.min(bestNeg, local);
          }
          prevAngle = angle;
        }
      }

      if (dist < 30) return; // a tap/click, not a traced gesture

      const bboxW = maxX - minX;
      const bboxH = maxY - minY;
      const diagonal = Math.hypot(bboxW, bboxH);
      const midX = (minX + maxX) / 2;
      const midY = (minY + maxY) / 2;

      // Figure-eight (Grieta): a real loop one way, and a real loop the other way.
      if (bestPos > 5 && bestNeg < -5) {
        triggerGrieta(end.x, end.y);
        return;
      }

      // Closed loop: a lot of rotation one way, no reversal. Small + over a cover = Égida;
      // otherwise the big sweep is Ola.
      if (Math.max(bestPos, -bestNeg) > 4.6) {
        const card = cardNear(midX, midY);
        if (diagonal < 150 && card) {
          triggerEgida(card);
        } else {
          triggerOla(midX, midY);
        }
        return;
      }

      // Zigzag (Rayo): several quick left-right reversals in a short scribble.
      if (dxReversals >= 3 && bboxW < 260 && duration < 1600) {
        spawnBolt(end.x, end.y);
        return;
      }

      // Swish-and-flick (Viento): wide and flat, ending on a sharp upward flick.
      const tailStart = points[Math.max(0, points.length - 4)];
      const flickDy = end.y - tailStart.y;
      const flickDx = end.x - tailStart.x;
      if (bboxW > bboxH * 1.4 && bboxW > 90 && flickDy < -14 && Math.abs(flickDy) > Math.abs(flickDx) * 0.6) {
        triggerViento(cardNear(midX, midY));
        return;
      }

      // Tridente: short, fast, mostly-vertical downward stab.
      if (duration < 260 && bboxH > bboxW * 1.4 && end.y - start.y > 24) {
        triggerTridente();
        return;
      }
    }

    document.addEventListener("pointerdown", (e) => {
      const ev = e as PointerEvent;
      isDown = true;
      holdFired = false;
      downX = ev.clientX;
      downY = ev.clientY;
      points = [{ x: ev.clientX, y: ev.clientY, t: performance.now() }];
      clearHoldTimer();
      holdTimer = setTimeout(() => {
        holdFired = true;
        fireNiebla();
      }, HOLD_MS);
    });

    document.addEventListener("pointermove", (e) => {
      if (!isDown) return;
      const ev = e as PointerEvent;
      const dx = ev.clientX - downX;
      const dy = ev.clientY - downY;
      if (holdTimer && Math.hypot(dx, dy) > HOLD_MOVE_TOLERANCE) clearHoldTimer();
      points.push({ x: ev.clientX, y: ev.clientY, t: performance.now() });
    });

    document.addEventListener("pointerup", () => {
      clearHoldTimer();
      isDown = false;
      if (!holdFired) classify();
      points = [];
    });

    document.addEventListener("pointercancel", () => {
      clearHoldTimer();
      isDown = false;
      points = [];
    });

    // Silbido (a Blackjack) — double-click a cover and it springs toward the cursor, then
    // snaps back, same mechanic as Accio on the Harry Potter page.
    document.querySelectorAll(".pj-card").forEach((card) => {
      card.addEventListener("dblclick", (e) => {
        if (!(card instanceof HTMLElement)) return;
        const ev = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = (ev.clientX - cx) * 0.18;
        const dy = (ev.clientY - cy) * 0.18;
        card.classList.add("pj-card--summon");
        card.style.transform = `translate(${dx}px, ${dy}px) scale(0.94)`;
        requestAnimationFrame(() => {
          card.style.transform = "";
        });
        setTimeout(() => {
          card.classList.remove("pj-card--summon");
          card.style.transform = "";
        }, 450);
      });
    });
  })();
</script>

<script>
  // Reveals the Iris-message legend the moment it scrolls into view.
  const iris = document.getElementById("pj-iris");
  if (iris && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          iris.classList.add("pj-iris--visible");
          observer.disconnect();
        }
      },
      { rootMargin: "-10% 0px" }
    );
    observer.observe(iris);
  } else if (iris) {
    iris.classList.add("pj-iris--visible");
  }
</script>
