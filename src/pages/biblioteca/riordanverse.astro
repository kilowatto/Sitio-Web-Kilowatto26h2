    clip-path: polygon(0% 50%, 15% 20%, 30% 60%, 45% 15%, 60% 55%, 75% 10%, 100% 50%, 75% 90%, 60% 45%, 45% 85%, 30% 40%, 15% 80%);
    animation: pj-fx-crack-open 1.6s ease-out forwards;
