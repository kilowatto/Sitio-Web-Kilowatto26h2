---
// Dedicated themed sub-page (not the generic /biblioteca list) — Esteban's Harry Potter
// shelf gets its own "mundo mágico" visual treatment (dark parchment/wand theme) rather than
// living inside the site's normal light theme, where a wizarding aesthetic would clash mid-page.
// All these books are ALSO real rows in the shared `books` table, so they still show up in the
// normal /biblioteca list/search — this page is purely an additional, richer display of the
// same data, grouped by physical edition and kept in reading order per Esteban's request.
import Site from "../../layouts/Site.astro";
import { env } from "cloudflare:workers";

interface HpBook {
  id: number;
  title: string;
  series: string;
  reading_order: number | null;
  cover_r2_key: string | null;
  release_year: string | null;
  comment: string | null;
}

interface Author {
  name: string;
  bio_html: string;
  fun_facts_json: string;
}

let lbBox: HpBook[] = [];
let salamandra: HpBook[] = [];
let special: HpBook[] = [];
let author: Author | null = null;

if (env?.DB) {
  author = await env.DB.prepare(
    `SELECT name, bio_html, fun_facts_json FROM authors WHERE slug = 'jk-rowling'`
  ).first<Author>();
  const { results } = await env.DB.prepare(
    `SELECT id, title, series, reading_order, cover_r2_key, release_year, comment FROM books
     WHERE series LIKE 'Harry Potter%' ORDER BY sort_order ASC`
  ).all<HpBook>();
  const all = results ?? [];
  lbBox = all.filter((b) => b.series.includes("Letras de Bolsillo"));
  salamandra = all.filter((b) => b.series === "Harry Potter — edición Salamandra");
  // Catches "objetos de colección" (e.g. Destroza el Horrocrux) and "libros de texto de
  // Hogwarts" (e.g. Animales Fantásticos y Dónde Encontrarlos) too -- anything that isn't one
  // of the 7 core novels in either physical edition, but is still real Wizarding World material
  // Esteban owns. Confirmed live 2026-08-22: both of those were silently missing from this page
  // (present in the `all` query but matching none of the three buckets) until this filter grew.
  special = all.filter(
    (b) =>
      b.series.includes("especiales") ||
      b.series.includes("ilustrada") ||
      b.series.includes("objetos de colección") ||
      b.series.includes("libros de texto de Hogwarts")
  );
}
const funFacts: string[] = author ? JSON.parse(author.fun_facts_json) : [];
---

<Site
  title="El armario de Harry Potter — Esteban Rey"
  description="La colección de Harry Potter de Esteban Rey: la caja completa Letras de Bolsillo, la edición Salamandra y piezas especiales."
  active="/biblioteca"
>
  {/* The enchanted ceiling of the Great Hall, "bewitched to look like the sky outside" per
      Hermione's line in the books — a real quote, not fan invention. Deliberately a SIBLING
      before .hp-page (not nested inside it): .hp-page has overflow:hidden to contain its own
      decorative absolutely-positioned elements, and ANY ancestor with overflow other than
      visible silently breaks position:sticky on a descendant — this section needs its own
      unbroken sticky containing block for the scroll-driven "camera descends to the tables"
      effect below. */}
  <section class="hp-greathall" id="hp-greathall">
    <div class="hp-greathall__sticky">
      <img
        src="/media/biblioteca/riordan-great-hall.webp?w=1200"
        srcset="/media/biblioteca/riordan-great-hall.webp?w=800 800w, /media/biblioteca/riordan-great-hall.webp?w=1400 1400w, /media/biblioteca/riordan-great-hall.webp?w=2000 2000w"
        sizes="100vw"
        alt="El techo encantado del Gran Comedor, mostrando el cielo nocturno estrellado sobre las mesas iluminadas por velas"
        class="hp-greathall__img"
        id="hp-greathall-img"
      />
      <div class="hp-greathall__clouds" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="hp-greathall__candles" id="hp-greathall-candles" aria-hidden="true"></div>
      <div class="hp-greathall__vignette"></div>
      <div class="hp-greathall__text container">
        <p class="hp-eyebrow">El Gran Comedor</p>
        <h2>Un techo bewitched para verse como el cielo de afuera</h2>
        <p class="hp-greathall__sub">
          Miles y miles de velas flotan en el aire sin nada que las sostenga — así las describe el libro.
          Baja la mirada de las estrellas a las mesas.
        </p>
      </div>
    </div>
  </section>

  <div class="hp-page" id="hp-page">
    <div class="hp-wand-glow" id="wand-glow"></div>
    <div class="hp-wand-cursor" id="wand-cursor">
      <div class="hp-wand-cursor__stick"></div>
      <div class="hp-wand-cursor__tip"></div>
    </div>
    <div class="hp-avada-flash" id="avada-flash"></div>

    {/* Spell effects, all triggered by tracing real wand gestures with the cursor (see the
        gesture-recognition script near the bottom) -- Nox is a press-and-hold, the rest are
        drawn shapes classified from the pointer path. */}
    <div class="hp-nox-overlay" id="hp-nox-overlay"></div>
    <div class="hp-patronum-flash" id="hp-patronum-flash"></div>
    <div class="hp-fx-layer" id="hp-fx-layer" aria-hidden="true"></div>

    <section class="hp-secret" id="hp-secret" hidden>
      <div class="container">
        <p class="hp-eyebrow">Alohomora</p>
        <p class="hp-secret__quote">"Juro solemnemente que mis intenciones no son buenas."</p>
        <p class="hp-secret__sub">Encontraste el rincón escondido de esta página. Nadie más sabe que está aquí — hasta ahora.</p>
      </div>
    </section>

    <section class="hp-hero">
      <img
        src="/media/biblioteca/hp-lb-box-completo.webp?w=1200"
        srcset="/media/biblioteca/hp-lb-box-completo.webp?w=800 800w, /media/biblioteca/hp-lb-box-completo.webp?w=1400 1400w, /media/biblioteca/hp-lb-box-completo.webp?w=2000 2000w"
        sizes="100vw"
        alt=""
        class="hp-hero__img"
      />
      <div class="hp-hero__scrim"></div>
      <div class="hp-hero__text container">
        <p class="hp-eyebrow">Biblioteca · mundo mágico</p>
        <h1>El armario de Harry Potter</h1>
        <p class="hp-hero__sub">
          Pasa la varita sobre cada portada para revelarla — <em>Revelio</em>. Toda esta colección también vive en la
          <a href="/biblioteca">biblioteca general</a>.
        </p>
      </div>
    </section>

    <section class="hp-section hp-story">
      <div class="container">
        <p class="hp-eyebrow">Por qué me enganchó</p>
        <h2>La primera lectura que de verdad me atrapó</h2>
        <p>
          Antes me tocaba leer a Platón (<em>La República</em>, el mito de la caverna), a Descartes o a Santo Tomás
          de Aquino con su <em>Suma Teológica</em> — pero el primer libro que de verdad me enganchó fue Harry Potter.
          Recuerdo haber comprado el primero en el Gandhi del aeropuerto, camino a ver las <a href="/avestruces">avestruces</a>,
          y terminarlo en tres días. Por suerte un tío mío acababa de terminar el segundo y me lo prestó, así que en
          una Semana Santa ya me había leído los primeros dos.
        </p>
        <p>
          Recuerdo estar en El Worka —un bar/antro del Pedregal que después se incendió en circunstancias
          extrañas 🔥— obviamente con unas cubas, pero picado por saber qué iba a pasar en el laberinto. Y que muere
          Cedric. Alguien hizo el chiste de "<span class="hp-avada" data-avada>avada kevada</span>". Al otro día me levanto, ya crudo, y pienso: mmm, me
          imagino que mataron a Cedric. Todos sabemos qué pasó.
        </p>
      </div>
    </section>

    <section class="hp-section">
      <div class="container">
        <p class="hp-eyebrow">La caja completa</p>
        <h2>Edición Letras de Bolsillo, en orden</h2>
        <p class="hp-section__sub">
          Del uno al siete, en orden — aunque la caja ya no está completa. Cinco se prestaron a lo largo de los años
          y nunca volvieron. Triste y feliz a la vez: quiero pensar que engancharon a alguien más, y que en algún
          librero siguen haciendo lo mismo que me hicieron a mí.
        </p>
        <div class="hp-grid">
          {lbBox.map((b) => (
            <div class="hp-card" data-revelio>
              <span class="hp-card__order">{b.reading_order}</span>
              {b.cover_r2_key ? (
                <img
                  src={`/media/${b.cover_r2_key}?w=300`}
                  srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                  sizes="200px"
                  alt=""
                  class="hp-card__img"
                  loading="lazy"
                />
              ) : (
                <div class="hp-card__placeholder">
                  <span>Prestado hace años. Nunca volvió — ojalá siga enganchando a alguien por ahí.</span>
                </div>
              )}
              <p class="hp-card__title">{b.title.replace(/^Harry Potter y (la |el |las |los )?/i, "")}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="hp-section hp-section--alt">
      <div class="container">
        <p class="hp-eyebrow">Copias sueltas</p>
        <h2>Edición Salamandra</h2>
        <p class="hp-section__sub">La misma saga, otra vez — portada por portada, en la edición estándar de Salamandra.</p>
        <div class="hp-grid">
          {salamandra.map((b) => (
            <div class="hp-card" data-revelio>
              <span class="hp-card__order">{b.reading_order}</span>
              <img
                src={`/media/${b.cover_r2_key}?w=300`}
                srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                sizes="200px"
                alt=""
                class="hp-card__img"
                loading="lazy"
              />
              <p class="hp-card__title">{b.title.replace(/^Harry Potter y (la |el |las |los )?/i, "")}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {special.length > 0 && (
      <section class="hp-section">
        <div class="container">
          <p class="hp-eyebrow">Piezas especiales</p>
          <h2>Ediciones fuera de serie</h2>
          <div class="hp-grid">
            {special.map((b) => (
              <div class="hp-card" data-revelio>
                {b.cover_r2_key && (
                  <img
                    src={`/media/${b.cover_r2_key}?w=300`}
                    srcset={`/media/${b.cover_r2_key}?w=300 300w, /media/${b.cover_r2_key}?w=500 500w`}
                    sizes="200px"
                    alt=""
                    class="hp-card__img"
                    loading="lazy"
                  />
                )}
                <p class="hp-card__title">{b.title}</p>
                {b.comment && <p class="hp-card__comment">{b.comment}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {author && (
      <section class="hp-section hp-author">
        <div class="container">
          <p class="hp-eyebrow">Quién lo escribió</p>
          <h2>{author.name}</h2>
          <div class="hp-author__bio"><Fragment set:html={author.bio_html} /></div>
          <ul class="hp-author__facts">
            {funFacts.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </section>
    )}

    <section class="hp-section hp-section--alt hp-grimoire-section">
      <div class="container">
        <p class="hp-eyebrow">Solo en escritorio</p>
        <h2>Grimorio de hechizos</h2>
        <p class="hp-section__sub">
          Cada hechizo se lanza trazando su forma con el cursor (mouse, no pantallas táctiles) en cualquier parte de
          la página — no hace falta apuntar a nada en concreto, salvo donde se indica.
        </p>
        <div class="hp-grimoire" id="hp-grimoire">
          <p class="hp-grimoire__seal" aria-hidden="true">🪄</p>
          <ul class="hp-grimoire__list">
            <li>
              <span class="hp-grimoire__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="3" fill="currentColor"/><circle cx="16" cy="16" r="8" fill="none" stroke="currentColor" stroke-width="1.6" opacity="0.55"/><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.6" opacity="0.28"/></svg></span>
              <span class="hp-grimoire__spell">Nox</span><span class="hp-grimoire__how">Mantén el clic sin moverte casi dos segundos.</span>
            </li>
            <li>
              <span class="hp-grimoire__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16,16 C10,8 3,8 3,16 C3,24 10,24 16,16 C22,8 29,8 29,16 C29,24 22,24 16,16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>
              <span class="hp-grimoire__spell">Alohomora</span><span class="hp-grimoire__how">Traza un ocho (∞) en el aire.</span>
            </li>
            <li>
              <span class="hp-grimoire__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16,4 A12,12 0 1 1 4.5,20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M4.5,20 L2,16.5 M4.5,20 L8.5,18.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="hp-grimoire__spell">Expecto Patronum</span><span class="hp-grimoire__how">Dibuja un círculo o lazo amplio, lejos de una portada.</span>
            </li>
            <li>
              <span class="hp-grimoire__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><rect x="8" y="4" width="12" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" opacity="0.5"/><path d="M18,8 A7,7 0 1 1 8,15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>
              <span class="hp-grimoire__spell">Protego</span><span class="hp-grimoire__how">Dibuja un círculo pequeño justo sobre una portada.</span>
            </li>
            <li>
              <span class="hp-grimoire__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M3,22 C10,27 19,26 24,18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M24,18 L27,6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M27,6 L24,10.5 M27,6 L30,11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="hp-grimoire__spell">Wingardium Leviosa</span><span class="hp-grimoire__how">Un trazo amplio que termina en un latigazo hacia arriba.</span>
            </li>
            <li>
              <span class="hp-grimoire__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M6,6 L24,12 L6,18 L24,24 L6,30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="hp-grimoire__spell">Incendio</span><span class="hp-grimoire__how">Un zigzag rápido, como firma nerviosa.</span>
            </li>
            <li>
              <span class="hp-grimoire__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16,4 L16,22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><path d="M16,22 L11,17 M16,22 L21,17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="hp-grimoire__spell">Crucio</span><span class="hp-grimoire__how">Una estocada corta y rápida hacia abajo.</span>
            </li>
            <li>
              <span class="hp-grimoire__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><circle cx="11" cy="16" r="2.6" fill="currentColor"/><circle cx="11" cy="16" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/><circle cx="22" cy="16" r="2.6" fill="currentColor"/><circle cx="22" cy="16" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/></svg></span>
              <span class="hp-grimoire__spell">Accio</span><span class="hp-grimoire__how">Doble clic sobre cualquier portada.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</Site>

<style>
  /* Scroll-driven "camera descent" from the starry enchanted ceiling down to the candlelit
     tables: a tall scroll runway with a sticky 100vh viewport inside it, panning a taller-than-
     viewport image via JS-computed scroll progress (see the script below). */
  .hp-greathall {
    position: relative;
    height: 220vh;
    background: #05040a;
  }
  .hp-greathall__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .hp-greathall__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 180%;
    object-fit: cover;
    object-position: top center;
    will-change: transform;
  }
  .hp-greathall__vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(5, 4, 10, 0.55) 0%,
      rgba(5, 4, 10, 0.05) 30%,
      rgba(5, 4, 10, 0.15) 70%,
      rgba(5, 4, 10, 0.85) 100%
    );
  }
  .hp-greathall__text {
    position: absolute;
    left: 0;
    right: 0;
    top: 8%;
    text-align: center;
  }
  .hp-greathall__text h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    color: #f6efd8;
    margin: 0 auto 0.6rem;
    max-width: 40rem;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.8);
  }
  .hp-greathall__sub {
    max-width: 30rem;
    margin: 0 auto;
    color: #d9d0b3;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
  }

  /* Drifting clouds — the enchanted ceiling shows the real sky outside, moving clouds
     included. Soft blurred blobs screen-blended over the ceiling area only, each drifting
     sideways at a different speed/delay so they read as independent, not one repeating loop. */
  .hp-greathall__clouds {
    position: absolute;
    inset: 0;
    height: 55%;
    overflow: hidden;
    mix-blend-mode: screen;
    opacity: 0.5;
    pointer-events: none;
  }
  .hp-greathall__clouds span {
    position: absolute;
    top: 12%;
    width: 26rem;
    height: 9rem;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(230, 225, 210, 0.55), transparent 70%);
    filter: blur(6px);
    animation: hp-cloud-drift linear infinite;
  }
  .hp-greathall__clouds span:nth-child(1) {
    top: 8%;
    animation-duration: 90s;
  }
  .hp-greathall__clouds span:nth-child(2) {
    top: 22%;
    width: 20rem;
    height: 7rem;
    animation-duration: 130s;
    animation-delay: -40s;
  }
  .hp-greathall__clouds span:nth-child(3) {
    top: 30%;
    width: 30rem;
    height: 10rem;
    animation-duration: 160s;
    animation-delay: -90s;
  }
  @keyframes hp-cloud-drift {
    from {
      transform: translateX(-40rem);
    }
    to {
      transform: translateX(160vw);
    }
  }

  /* Floating candles: "thousands and thousands... floating in midair" per the book (a real
     quote — deliberately not stating a specific count, since "1,000" is fan-wiki lore, not the
     text). A representative handful, each independently flickering and gently bobbing. */
  .hp-greathall__candles {
    position: absolute;
    inset: 0;
    height: 70%;
  }
  /* .hp-candle and its descendants are created via document.createElement in the script below,
     so they never receive Astro's auto-injected scope attribute -- their styles live in the
     <style is:global> block further down instead (same reason .hp-sparkle lives there). */
  @media (prefers-reduced-motion: reduce) {
    .hp-greathall__clouds span {
      animation: none;
    }
  }
  @media (max-width: 40rem) {
    /* A tall scroll-jacked hero is a much bigger ask of a phone's scroll — shorten the runway
       and drop the least-essential candles (set via JS, see below) rather than ship the full
       desktop density at a size where each candle reads as a tiny illegible speck. */
    .hp-greathall {
      height: 160vh;
    }
  }

  .hp-page {
    background: #0b0a14;
    color: #e9e2c9;
    margin: calc(-1 * var(--space-3)) 0 0;
    padding-bottom: var(--space-5);
    position: relative;
    overflow: hidden;
  }
  /* The wand cursor/glow div elements live inside #hp-page, but the whole page (including the
     .hp-greathall section, a sibling BEFORE .hp-page -- see the note up top about why it can't
     nest inside it) should show the wand. Gated on a class the script below sets on <html>
     itself, so it isn't tied to either section specifically. */
  @media (pointer: fine) {
    :global(html.hp-wand-page),
    :global(html.hp-wand-page *) {
      cursor: none;
    }
  }

  /* The actual pointer, replaced: a wand whose tip sits exactly at the cursor position and
     stays lit (Lumos) the whole time — the stick trails up-left from the tip so the tip
     itself, not the stick, is what aligns with clicks. */
  .hp-wand-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 210;
    transform: translate(-100px, -100px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  :global(html.hp-wand-page) .hp-wand-cursor {
    opacity: 1;
  }
  .hp-wand-cursor__stick {
    position: absolute;
    left: 0;
    top: 0;
    width: 3rem;
    height: 0.3rem;
    background: linear-gradient(90deg, #8a5a2e, #4a2f18);
    border-radius: 999px;
    transform-origin: 0% 0%;
    transform: rotate(42deg);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }
  .hp-wand-cursor__tip {
    position: absolute;
    left: -0.2rem;
    top: -0.2rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #fffbe8;
    box-shadow: 0 0 6px 2px rgba(255, 247, 200, 0.95), 0 0 18px 8px rgba(255, 214, 100, 0.6),
      0 0 34px 16px rgba(255, 214, 100, 0.25);
  }

  /* The "Lumos" cursor glow — a soft warm light that follows the pointer, brightening the
     dark background wherever it passes. Decorative only: pointer-events none so it never
     blocks real clicks, and disabled entirely for touch/coarse-pointer devices below. */
  .hp-wand-glow {
    position: fixed;
    top: 0;
    left: 0;
    width: 22rem;
    height: 22rem;
    margin-left: -11rem;
    margin-top: -11rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 214, 100, 0.16) 0%, rgba(255, 214, 100, 0.05) 45%, transparent 70%);
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: 5;
    opacity: 0;
