<script>
  // The wand needs to work across the whole page, not just #hp-page -- .hp-greathall is a
  // sibling section before it (can't nest inside, see the note near its markup), so the
  // active-state class lives on <html> instead of any one section, and position tracking
  // listens on the document rather than a specific element.
  const glow = document.getElementById("wand-glow");
  const wandCursor = document.getElementById("wand-cursor");
  if (glow && wandCursor && window.matchMedia("(pointer: fine)").matches) {
    document.documentElement.classList.add("hp-wand-page");
    document.addEventListener("pointermove", (e) => {
      glow.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
      wandCursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    });
  }

  // A small "Revelio" sparkle burst at the click point — purely decorative, self-removing.
  document.querySelectorAll("[data-revelio]").forEach((card) => {
    card.addEventListener("click", (e) => {
      const rect = card.getBoundingClientRect();
      const sparkle = document.createElement("span");
      sparkle.className = "hp-sparkle";
      sparkle.style.left = `${(e as MouseEvent).clientX - rect.left}px`;
      sparkle.style.top = `${(e as MouseEvent).clientY - rect.top}px`;
      card.appendChild(sparkle);
      sparkle.addEventListener("animationend", () => sparkle.remove());
    });
  });

  // "Avada kevada" bursts full-screen green toward the viewer on hover, centered on the phrase.
  const avadaFlash = document.getElementById("avada-flash");
  document.querySelectorAll("[data-avada]").forEach((phrase) => {
    phrase.addEventListener("mouseenter", () => {
      if (!avadaFlash) return;
      const rect = phrase.getBoundingClientRect();
      const fx = ((rect.left + rect.width / 2) / window.innerWidth) * 100;
      const fy = ((rect.top + rect.height / 2) / window.innerHeight) * 100;
      avadaFlash.style.setProperty("--fx", `${fx}%`);
      avadaFlash.style.setProperty("--fy", `${fy}%`);
      avadaFlash.classList.remove("hp-avada-flash--active");
      void (avadaFlash as HTMLElement).offsetWidth;
      avadaFlash.classList.add("hp-avada-flash--active");
    });
  });
</script>

<script>
  // Great Hall: floating candles (positioned + timed randomly so they never look like one
  // repeating loop) and the scroll-driven "camera descends from the ceiling to the tables" pan.
  (() => {
    const layer = document.getElementById("hp-greathall-candles");
    if (!layer) return;

    const isPhone = window.matchMedia("(max-width: 40rem)").matches;
    // Fewer candles on phones -- each one reads as a bigger, more legible flame at that size,
    // and it's a real reduction in animated layers on a device more likely to be lower-powered.
    const positions = isPhone
      ? [
          [18, 30],
          [50, 18],
          [78, 34],
          [35, 45],
          [65, 42],
        ]
      : [
          [10, 28],
          [22, 40],
          [35, 20],
          [48, 38],
          [58, 22],
          [70, 42],
          [82, 26],
          [90, 44],
          [16, 55],
          [63, 55],
          [40, 58],
          [85, 60],
        ];

    const frag = document.createDocumentFragment();
    positions.forEach(([left, top]) => {
      const el = document.createElement("div");
      el.className = "hp-candle";
      el.style.left = `${left}%`;
      el.style.top = `${top}%`;
      const bobDuration = 5 + Math.random() * 3;
      const bobDelay = Math.random() * -6;
      el.style.animationDuration = `${bobDuration}s`;
      el.style.animationDelay = `${bobDelay}s`;
      el.innerHTML = `
        <div class="hp-candle__stick"></div>
        <div class="hp-candle__glow"></div>
        <div class="hp-candle__flame">
          <div class="hp-candle__flame-layer hp-candle__flame-layer--outer"></div>
          <div class="hp-candle__flame-layer hp-candle__flame-layer--mid"></div>
          <div class="hp-candle__flame-layer hp-candle__flame-layer--core"></div>
        </div>
      `;
      const flicker = el.querySelector(".hp-candle__flame");
      const glow = el.querySelector(".hp-candle__glow");
      const flickerDuration = 1.8 + Math.random() * 1.2;
      const flickerDelay = Math.random() * -3;
      if (flicker instanceof HTMLElement) {
        flicker.style.animationDuration = `${flickerDuration}s`;
        flicker.style.animationDelay = `${flickerDelay}s`;
      }
      if (glow instanceof HTMLElement) {
        glow.style.animationDuration = `${flickerDuration * 1.3}s`;
        glow.style.animationDelay = `${flickerDelay}s`;
      }
      frag.appendChild(el);
    });
    layer.appendChild(frag);

    // Scroll-driven pan: the image is 180% of the sticky viewport's height, so there's 80vh of
    // vertical range to pan through as the wrapper section scrolls past — 0 at the top (showing
    // the ceiling) to 1 once the wrapper is fully scrolled (showing the tables).
    const wrapper = document.getElementById("hp-greathall");
    const img = document.getElementById("hp-greathall-img");
    if (!wrapper || !img || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let ticking = false;
    function updatePan() {
      ticking = false;
      const rect = wrapper.getBoundingClientRect();
      const total = wrapper.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      const progress = Math.min(1, Math.max(0, -rect.top / total));
      const maxTranslate = img.offsetHeight - window.innerHeight;
      img.style.transform = `translateY(-${progress * maxTranslate}px)`;
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updatePan);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    updatePan();
  })();
</script>

<script>
  // Wand spellcasting: trace a shape with the cursor (pointerdown -> move -> up) and it gets
  // classified into one of the 8 spells picked for this page. Holding still (no real movement)
  // for ~1.4s is Nox instead, handled by its own timer since "hold" is the opposite of a traced
  // gesture and can't go through the up-based classifier below.
  (() => {
    const page = document.getElementById("hp-page");
    const noxOverlay = document.getElementById("hp-nox-overlay");
    const patronumFlash = document.getElementById("hp-patronum-flash");
    const fxLayer = document.getElementById("hp-fx-layer");
    const secret = document.getElementById("hp-secret");
    if (!page || !noxOverlay || !patronumFlash || !fxLayer) return;
    if (!window.matchMedia("(pointer: fine)").matches) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const HOLD_MS = 1800;
    const NOX_MS = 10000;
    // A real trace, even a slow, careful one (Protego's "small" circle, a hesitant pause
    // before Leviosa/Accio), must cancel the hold almost as soon as it starts moving --
    // otherwise the time it takes to drift this many pixels can outlast HOLD_MS on its own,
    // firing Nox mid-gesture and eating the classify() call the real shape needed.
    const HOLD_MOVE_TOLERANCE = 6;

    let points = [];
    let isDown = false;
    let downX = 0;
    let downY = 0;
    let holdTimer = null;
    let holdFired = false;
    let noxActive = false;

    function clearHoldTimer() {
      if (holdTimer) {
        clearTimeout(holdTimer);
        holdTimer = null;
      }
    }

    function fireNox() {
      if (noxActive) return;
      noxActive = true;
      noxOverlay.classList.add("hp-nox-overlay--active");
      setTimeout(() => {
        noxOverlay.classList.remove("hp-nox-overlay--active");
        noxActive = false;
      }, NOX_MS);
    }

    function spawnFlame(x, y) {
      const el = document.createElement("div");
      el.className = "hp-fx-flame";
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      el.style.transform = "translate(-50%, -100%)";
      el.innerHTML =
        '<div class="hp-candle__flame-layer hp-candle__flame-layer--outer"></div>' +
        '<div class="hp-candle__flame-layer hp-candle__flame-layer--mid"></div>' +
        '<div class="hp-candle__flame-layer hp-candle__flame-layer--core"></div>';
      fxLayer.appendChild(el);
      setTimeout(() => el.remove(), 2300);
    }

    function spawnLock(x, y, onDone) {
      const el = document.createElement("div");
      el.className = "hp-fx-lock";
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      el.style.transform = "translate(-50%, -50%)";
      el.innerHTML = '<div class="hp-fx-lock__shackle"></div><div class="hp-fx-lock__body"></div>';
      fxLayer.appendChild(el);
      setTimeout(() => {
        el.remove();
        onDone();
      }, 1600);
    }

    function triggerAlohomora(x, y) {
      spawnLock(x, y, () => {
        if (!secret) return;
        secret.hidden = false;
        secret.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "center" });
      });
    }

    function triggerPatronum(x, y) {
      patronumFlash.style.setProperty("--px", `${x}px`);
      patronumFlash.style.setProperty("--py", `${y}px`);
      patronumFlash.classList.remove("hp-patronum-flash--active");
      void (patronumFlash as HTMLElement).offsetWidth;
      patronumFlash.classList.add("hp-patronum-flash--active");
    }

    function triggerProtego(card) {
      if (!(card instanceof HTMLElement)) return;
      card.classList.remove("hp-card--shielded");
      void card.offsetWidth;
      card.classList.add("hp-card--shielded");
      setTimeout(() => card.classList.remove("hp-card--shielded"), 1600);
    }

    function triggerLeviosa(card) {
      if (!(card instanceof HTMLElement)) return;
      card.classList.remove("hp-card--levitate");
      void card.offsetWidth;
      card.classList.add("hp-card--levitate");
      setTimeout(() => card.classList.remove("hp-card--levitate"), 2800);
    }

    function triggerCrucio() {
      page.classList.remove("hp-page--crucio");
      void (page as HTMLElement).offsetWidth;
      page.classList.add("hp-page--crucio");
      setTimeout(() => page.classList.remove("hp-page--crucio"), 700);
    }

    function cardNear(x, y) {
      const el = document.elementFromPoint(x, y);
      return el ? el.closest(".hp-card") : null;
    }

    // Classifies the traced path into a spell on release. Order matters: most specific shape
    // (figure-eight) first, then closed loops, then scribbles/flicks/stabs.
    function classify() {
      if (points.length < 4) return;
      const start = points[0];
      const end = points[points.length - 1];
      const duration = end.t - start.t;
      let dist = 0;
      let minX = start.x,
        maxX = start.x,
        minY = start.y,
        maxY = start.y;
      // `local` is the rotation built up since the last time direction reversed — NOT a
      // single global running total. A real figure-eight is a clockwise loop followed by a
      // counter-clockwise loop; measured as one cumulative sum the second loop just cancels
      // the first back toward zero and never registers. Tracking the excursion since the
      // last reversal lets both loops register independently as their own big swing.
      let local = 0;
      let bestPos = 0;
      let bestNeg = 0;
      let dxReversals = 0;
      let prevDx = 0;
      let prevAngle = null;

      for (let i = 1; i < points.length; i++) {
        const a = points[i - 1];
        const b = points[i];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        dist += Math.hypot(dx, dy);
        minX = Math.min(minX, b.x);
        maxX = Math.max(maxX, b.x);
        minY = Math.min(minY, b.y);
        maxY = Math.max(maxY, b.y);
        if (Math.abs(dx) > 2) {
          if (prevDx !== 0 && Math.sign(dx) !== Math.sign(prevDx)) dxReversals++;
          prevDx = dx;
        }
        if (Math.hypot(dx, dy) > 3) {
          const angle = Math.atan2(dy, dx);
          if (prevAngle !== null) {
            let delta = angle - prevAngle;
            while (delta > Math.PI) delta -= Math.PI * 2;
            while (delta < -Math.PI) delta += Math.PI * 2;
            local = local === 0 || Math.sign(delta) === Math.sign(local) ? local + delta : delta;
            bestPos = Math.max(bestPos, local);
            bestNeg = Math.min(bestNeg, local);
          }
          prevAngle = angle;
        }
      }

      if (dist < 30) return; // a tap/click, not a traced gesture

      const bboxW = maxX - minX;
      const bboxH = maxY - minY;
      const diagonal = Math.hypot(bboxW, bboxH);
      const midX = (minX + maxX) / 2;
      const midY = (minY + maxY) / 2;

      // Figure-eight (Alohomora): a real loop one way, and a real loop the other way.
      if (bestPos > 5 && bestNeg < -5) {
        triggerAlohomora(end.x, end.y);
        return;
      }

      // Closed loop: a lot of rotation one way, no reversal. Small + over a cover = Protego;
      // otherwise the big sweep is Expecto Patronum.
      if (Math.max(bestPos, -bestNeg) > 4.6) {
        const card = cardNear(midX, midY);
        if (diagonal < 150 && card) {
          triggerProtego(card);
        } else {
          triggerPatronum(midX, midY);
        }
        return;
      }

      // Zigzag (Incendio): several quick left-right reversals in a short scribble.
      if (dxReversals >= 3 && bboxW < 260 && duration < 1600) {
        spawnFlame(end.x, end.y);
        spawnFlame((start.x + end.x) / 2, (start.y + end.y) / 2 - 10);
        return;
      }

      // Swish-and-flick (Wingardium Leviosa): wide and flat, ending on a sharp upward flick.
      const tailStart = points[Math.max(0, points.length - 4)];
      const flickDy = end.y - tailStart.y;
      const flickDx = end.x - tailStart.x;
      if (bboxW > bboxH * 1.4 && bboxW > 90 && flickDy < -14 && Math.abs(flickDy) > Math.abs(flickDx) * 0.6) {
        triggerLeviosa(cardNear(midX, midY));
        return;
      }

      // Crucio: short, fast, mostly-vertical downward stab.
      if (duration < 260 && bboxH > bboxW * 1.4 && end.y - start.y > 24) {
        triggerCrucio();
        return;
      }
    }

    document.addEventListener("pointerdown", (e) => {
      const ev = e as PointerEvent;
      isDown = true;
      holdFired = false;
      downX = ev.clientX;
      downY = ev.clientY;
      points = [{ x: ev.clientX, y: ev.clientY, t: performance.now() }];
      clearHoldTimer();
      holdTimer = setTimeout(() => {
        holdFired = true;
        fireNox();
      }, HOLD_MS);
    });

    document.addEventListener("pointermove", (e) => {
      if (!isDown) return;
      const ev = e as PointerEvent;
      const dx = ev.clientX - downX;
      const dy = ev.clientY - downY;
      if (holdTimer && Math.hypot(dx, dy) > HOLD_MOVE_TOLERANCE) clearHoldTimer();
      points.push({ x: ev.clientX, y: ev.clientY, t: performance.now() });
    });

    document.addEventListener("pointerup", () => {
      clearHoldTimer();
      isDown = false;
      if (!holdFired) classify();
      points = [];
    });

    document.addEventListener("pointercancel", () => {
      clearHoldTimer();
      isDown = false;
      points = [];
    });

    // Accio — double-click a cover and it springs toward the cursor, then snaps back.
    document.querySelectorAll(".hp-card").forEach((card) => {
      card.addEventListener("dblclick", (e) => {
        if (!(card instanceof HTMLElement)) return;
        const ev = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = (ev.clientX - cx) * 0.18;
        const dy = (ev.clientY - cy) * 0.18;
        card.classList.add("hp-card--accio");
        card.style.transform = `translate(${dx}px, ${dy}px) scale(0.94)`;
        requestAnimationFrame(() => {
          card.style.transform = "";
        });
        setTimeout(() => {
          card.classList.remove("hp-card--accio");
          card.style.transform = "";
        }, 450);
      });
    });
  })();
</script>

<script>
  // Reveals the grimoire the moment it scrolls into view — a small, quiet echo of Revelio
  // for the one section that's always visible rather than gesture-triggered.
  const grimoire = document.getElementById("hp-grimoire");
  if (grimoire && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          grimoire.classList.add("hp-grimoire--visible");
          observer.disconnect();
        }
      },
      { rootMargin: "-10% 0px" }
    );
    observer.observe(grimoire);
  } else if (grimoire) {
    grimoire.classList.add("hp-grimoire--visible");
  }
</script>

