    // "Revisar vigencia" — searches the web for the topic and asks Larry whether anything
    // version/time-sensitive (e.g. "Kimi K3" once K4 ships) looks outdated. The endpoint itself
    // verifies the model's claim against the real search text before ever returning stale:true.
    function renderStaleActions(row, data) {
      const badge = row.querySelector(".topic-stale-badge") ?? (() => {
        const s = document.createElement("span");
        s.className = "topic-stale-badge";
        row.querySelector(".topic-row-actions")?.prepend(s);
        return s;
      })();
      badge.title = data.reason ?? "Posible desactualización";
      const actions = row.querySelector(".topic-stale-actions");
      const note = actions?.querySelector(".topic-review-note");
      if (note) {
        note.textContent = data.sourceUrl ? `${data.reason} (${data.sourceUrl})` : data.reason ?? "";
      }
      if (actions) actions.hidden = false;
    }

    function clearStaleUI(row) {
      row.querySelector(".topic-stale-badge")?.remove();
      const actions = row.querySelector(".topic-stale-actions");
      if (actions) actions.hidden = true;
    }

    async function runTopicReview(id, btn) {
      const row = document.querySelector(`.topic-row[data-id="${id}"]`);
      const meta = row?.querySelector(".topic-review-meta");
      if (btn) btn.disabled = true;
      if (meta) meta.textContent = "Revisando…";
      // A single hung request (Workers AI or Brave Search never responding) used to freeze the
      // whole bulk run forever — Promise.all on that batch never resolved, so "revisando 66/67"
      // just sat there with no way out. A hard timeout guarantees this call always settles.
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 25000);
      try {
        const res = await fetch(`/api/brand/topics/${id}/review?token=${encodeURIComponent(token)}`, {
          method: "POST",
          signal: controller.signal,
        });
        const data = await res.json();
        if (meta) meta.textContent = "Revisado: hace un momento";
        if (row) {
          if (data.stale) renderStaleActions(row, data);
          else clearStaleUI(row);
        }
        return data;
      } catch (err) {
        if (meta) meta.textContent = err.name === "AbortError" ? "Tardó demasiado — se saltó este tema." : "Se perdió la conexión — intenta de nuevo.";
        return null;
      } finally {
        clearTimeout(timeout);
        if (btn) btn.disabled = false;
      }
    }

    document.querySelectorAll(".topic-review-btn").forEach((btn) => {
      btn.addEventListener("click", () => runTopicReview(btn.dataset.id, btn));
    });

    // The one shared action for BOTH "se queda" (keep, staleFlag:false) and "se va" (delete the
    // topic outright — for cases where the topic itself is bogus, not just its wording) —
    // called from the per-row buttons AND the bulk summary list, so there's one code path, not
    // two slightly-different ones that can drift and break independently.
    async function resolveTopicStale(id, keep) {
      const row = document.querySelector(`.topic-row[data-id="${id}"]`);
      if (keep) {
        await fetch(`/api/brand/topics/${id}?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ staleFlag: false }),
        });
        if (row) clearStaleUI(row);
      } else {
        const res = await fetch(`/api/brand/topics/${id}?token=${encodeURIComponent(token)}`, { method: "DELETE" });
        const data = await res.json();
        if (row) {
          if (data.deleted) row.remove();
          else {
            row.setAttribute("data-active", "false");
            const toggle = row.querySelector(".topic-toggle");
            if (toggle) toggle.checked = false;
            clearStaleUI(row);
          }
        }
      }
      document.querySelector(`#topics-stale-summary li[data-id="${id}"]`)?.remove();
      applyTopicsFilter();
    }

    document.querySelectorAll(".topic-keep-btn").forEach((btn) => {
      btn.addEventListener("click", () => resolveTopicStale(btn.dataset.id, true));
    });
    document.querySelectorAll(".topic-remove-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (confirm("¿Eliminar este tema por completo? No se puede deshacer.")) resolveTopicStale(btn.dataset.id, false);
      });
    });

    // Expands a topic's details panel (same effect as clicking its own .topic-expand chevron)
    // so a flagged suggestion is visible immediately, without the admin hunting through 70+
    // collapsed rows for the ~20 that got flagged.
    function expandTopicRow(row) {
      const expandBtn = row.querySelector(".topic-expand");
      const details = row.querySelector(".topic-details");
      if (expandBtn) expandBtn.setAttribute("aria-expanded", "true");
      if (details) details.hidden = false;
    }

    // Runs reviews CONCURRENTLY in small batches instead of one at a time — one-by-one over 70+
    // topics (each a real web search + LLM call) took several minutes; Brave Search's free tier
    // is rate-limited per second, so this caps concurrency rather than firing all at once.
    async function runInBatches(items, batchSize, worker) {
      for (let i = 0; i < items.length; i += batchSize) {
        const batch = items.slice(i, i + batchSize);
        await Promise.all(batch.map(worker));
      }
    }

    document.getElementById("topics-review-all-btn")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const status = document.getElementById("topics-review-all-status");
      const summary = document.getElementById("topics-stale-summary");
      const progress = document.getElementById("topics-progress");
      const progressBar = document.getElementById("topics-progress-bar");
      // This button means "check everything, right now" — it must actually do that. An earlier
      // version silently skipped anything reviewed in the last 24h to go faster, but that broke
      // the button's own promise: pressing "Revisar vigencia (activos)" and having it check
      // ~0 topics reads as broken, not as a smart optimization. Every active topic gets a real,
      // fresh check every time this is pressed — full stop.
      const activeRows = [...document.querySelectorAll('.topic-row[data-active="true"]')];

      btn.disabled = true;
      summary.hidden = true;
      summary.innerHTML = "";
      progressBar.style.width = "0%";
      progress.hidden = activeRows.length === 0;

      let done = 0;
      const staleCandidates = [];
      const BATCH_SIZE = 8;

      await runInBatches(activeRows, BATCH_SIZE, async (row) => {
        const id = row.dataset.id;
        const data = await runTopicReview(id, null);
        done++;
        status.textContent = `Revisando ${done}/${activeRows.length}…`;
        progressBar.style.width = activeRows.length ? `${Math.round((done / activeRows.length) * 100)}%` : "100%";
        if (data?.stale) {
          expandTopicRow(row);
          const name = row.querySelector(".topic-name")?.textContent ?? `Tema ${id}`;
          staleCandidates.push({ id, name, reason: data.sourceUrl ? `${data.reason} (${data.sourceUrl})` : data.reason ?? "" });
        }
      });

      progress.hidden = true;
      status.textContent = `Listo: ${activeRows.length} revisados, ${staleCandidates.length} con posible desactualización.`;

      if (staleCandidates.length > 0) {
        summary.innerHTML = `<li class="topics-stale-summary__head">Candidatos (${staleCandidates.length}) — decide para cada uno:</li>` +
          staleCandidates
            .map(
              (c) => `<li data-id="${c.id}">
                <a href="#" class="topics-stale-summary__link" data-id="${c.id}">${c.name}</a>
                <p class="topics-stale-summary__reason">${c.reason}</p>
                <div class="topics-stale-summary__buttons">
                  <button type="button" class="topic-keep-btn" data-id="${c.id}">✅ Se queda</button>
                  <button type="button" class="topic-remove-btn" data-id="${c.id}">🗑️ Se va</button>
                </div>
              </li>`
            )
            .join("");
        summary.hidden = false;
        // The buttons just injected via innerHTML need their own listeners — delegate one
        // listener on the summary container instead of re-querying/re-binding per item.
      }
      btn.disabled = false;
    });

    document.getElementById("topics-stale-summary")?.addEventListener("click", (e) => {
      const keepBtn = e.target.closest(".topic-keep-btn");
