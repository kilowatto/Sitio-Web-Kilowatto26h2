      const scheduleInput = document.getElementById("idea-schedule").value;
      if (!idea) {
        status.textContent = "Escribe una idea primero.";
        return;
      }
      if (btn.disabled) return;
      btn.disabled = true;
      status.textContent = "Investigando y generando… (puede tardar 30-60 segundos)";
      try {
        const res = await fetch(`/api/brand/generate-from-idea?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            idea,
            platform,
            scheduledFor: scheduleInput ? new Date(scheduleInput).toISOString() : undefined,
          }),
        });
        const data = await res.json();
        if (!res.ok) {
          status.textContent = "Error: " + (data.error || res.statusText);
          return;
        }
        status.textContent = `Listo: ${data.created?.length ?? 0} borrador(es) creado(s) — revísalos abajo.`;
        setTimeout(() => location.reload(), 1500);
      } catch (err) {
        status.textContent = "Se perdió la conexión — intenta de nuevo.";
      } finally {
        btn.disabled = false;
      }
    });

    document.getElementById("regen-all-btn")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const progress = document.getElementById("regen-all-progress");
      const fill = document.getElementById("regen-progress-fill");
      const status = document.getElementById("regen-all-status");
      const draftsCount = Number(btn.dataset.draftsCount || "0");

      if (draftsCount >= 2 && !confirm(`Esto va a reemplazar ${draftsCount} borrador(es) pendiente(s) de aprobar por 2 nuevos (uno para X, uno para LinkedIn). Los que ya aprobaste no se tocan. ¿Continuar?`)) {
        return;
      }

      let current = 0;
      function setStep(percent, text) {
        current = percent;
        fill.style.width = current + "%";
        status.textContent = text;
      }

      // Each generate call is a single request with no live updates from the server (it's
      // doing web research + writing + fact-check + a Gemini image call in one shot) — so
      // while it's in flight, creep the bar toward a cap instead of leaving it frozen, so it
      // never looks stuck even though we have no real intermediate progress to report.
      function creepToward(cap, ms) {
        const stepMs = 400;
        const perTick = (cap - current) / (ms / stepMs);
        return setInterval(() => {
          current = Math.min(current + perTick, cap);
          fill.style.width = current + "%";
        }, stepMs);
      }

      btn.disabled = true;
      progress.hidden = false;
      setStep(3, "Empezando…");
      try {
        if (draftsCount > 0) {
          setStep(8, "Descartando borradores pendientes…");
          await fetch(`/api/brand/discard-current?token=${encodeURIComponent(token)}`, { method: "POST" });
        }

        setStep(15, "Investigando y escribiendo (X)…");
        let ticker = creepToward(45, 14000);
        await fetch(`/api/brand/generate?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ platform: "x", language: "es", variantCount: 1 }),
        });
        clearInterval(ticker);

        setStep(52, "Investigando y escribiendo (LinkedIn)…");
        ticker = creepToward(92, 14000);
        await fetch(`/api/brand/generate?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ platform: "linkedin", language: "es", variantCount: 1 }),
        });
        clearInterval(ticker);

        setStep(100, "Listo — nuevos borradores generados.");
        setTimeout(() => location.reload(), 1200);
      } catch (err) {
        status.textContent = "Error: " + err.message;
        btn.disabled = false;
      }
    });

    document.getElementById("generate-batch-btn")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const progress = document.getElementById("batch-progress");
      const fill = document.getElementById("batch-progress-fill");
      const status = document.getElementById("batch-status");

      // 3 rounds x (X + LinkedIn), 1 variant each — no A/B here, just 6 distinct fresh posts.
      const ROUNDS = 3;
      let current = 0;
      function setStep(percent, text) {
        current = percent;
        fill.style.width = current + "%";
        status.textContent = text;
      }
      function creepToward(cap, ms) {
        const stepMs = 400;
        const perTick = (cap - current) / (ms / stepMs);
        return setInterval(() => {
          current = Math.min(current + perTick, cap);
          fill.style.width = current + "%";
        }, stepMs);
      }

      btn.disabled = true;
      progress.hidden = false;
      setStep(2, "Empezando…");
      try {
        for (let i = 0; i < ROUNDS; i++) {
          const base = Math.round((i / ROUNDS) * 100);
          const next = Math.round(((i + 1) / ROUNDS) * 100);
          const mid = Math.round((base + next) / 2);

          setStep(base + 2, `Tanda ${i + 1}/${ROUNDS}: investigando y escribiendo (X)…`);
          let ticker = creepToward(mid, 9000);
          await fetch(`/api/brand/generate?token=${encodeURIComponent(token)}`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ platform: "x", language: "es", variantCount: 1 }),
          });
          clearInterval(ticker);

          setStep(mid, `Tanda ${i + 1}/${ROUNDS}: investigando y escribiendo (LinkedIn)…`);
          ticker = creepToward(next - 2, 9000);
          await fetch(`/api/brand/generate?token=${encodeURIComponent(token)}`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ platform: "linkedin", language: "es", variantCount: 1 }),
          });
          clearInterval(ticker);
        }

        setStep(100, "Listo — 6 borradores nuevos generados.");
        setTimeout(() => location.reload(), 1200);
      } catch (err) {
        status.textContent = "Error: " + err.message;
        btn.disabled = false;
      }
    });

