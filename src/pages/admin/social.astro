        const row = btn.closest(".source-row");
        const name = row?.querySelector(".source-name")?.textContent ?? "esta fuente";
        if (!confirm(`¿Borrar "${name}" de la lista de fuentes?`)) return;
        await fetch(`/api/brand/news-sources/${id}?token=${encodeURIComponent(token)}`, { method: "DELETE" });
        row?.remove();
      });
    });

    document.getElementById("source-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = document.getElementById("source-name").value.trim();
      const domain = document.getElementById("source-domain").value.trim();
      if (!name) return;
      await fetch(`/api/brand/news-sources?token=${encodeURIComponent(token)}`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ name, domain: domain || undefined }),
      });
      location.reload();
    });

    document.getElementById("fixed-hashtags-save")?.addEventListener("click", async () => {
      const value = document.getElementById("fixed-hashtags-input").value.trim();
      const status = document.getElementById("fixed-hashtags-status");
      await fetch(`/api/brand/fixed-hashtags?token=${encodeURIComponent(token)}`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ hashtags: value }),
      });
      status.textContent = "Guardado.";
    });

    let brainstormSuggestions = [];

    function renderBrainstormChips() {
      const container = document.getElementById("brainstorm-chips");
      container.innerHTML = "";
      brainstormSuggestions.forEach((s, i) => {
        const chip = document.createElement("div");
        chip.className = "brainstorm-chip";
        chip.innerHTML = `
          <button type="button" class="chip-remove" data-i="${i}">×</button>
          <strong>${s.label}</strong>
          <p>${s.description ?? ""}</p>
        `;
        chip.querySelector(".chip-remove").addEventListener("click", () => {
          brainstormSuggestions.splice(i, 1);
          renderBrainstormChips();
        });
        container.appendChild(chip);
      });
      document.getElementById("brainstorm-save").style.display = brainstormSuggestions.length ? "block" : "none";
    }

    document.getElementById("brainstorm-btn")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const seed = document.getElementById("brainstorm-seed").value.trim();
      const status = document.getElementById("brainstorm-status");
      if (!seed) {
        status.textContent = "Escribe una idea o palabra primero.";
        return;
      }
      if (btn.disabled) return; // already running, ignore a second tap
      btn.disabled = true;
      status.textContent = "Pensando temas… (puede tardar hasta 15 segundos)";
      try {
        const res = await fetch(`/api/brand/topics/suggest?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ seed }),
        });
        const data = await res.json();
        if (!res.ok || !data.suggestions?.length) {
          status.textContent = "No se pudieron generar temas, intenta de nuevo.";
          return;
        }
        brainstormSuggestions = data.suggestions;
        status.textContent = `${brainstormSuggestions.length} temas sugeridos — quita los que no quieras, luego guarda.`;
      } catch (err) {
        // A dropped mobile connection or timeout used to leave this stuck on "Pensando
        // temas…" forever with no way to tell it had failed — now it says so and can retry.
        status.textContent = "Se perdió la conexión — intenta de nuevo.";
      } finally {
        btn.disabled = false;
      }
      renderBrainstormChips();
    });

    document.getElementById("brainstorm-save")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      btn.disabled = true;
      btn.textContent = "Guardando…";
      for (const s of brainstormSuggestions) {
        await fetch(`/api/brand/topics?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ label: s.label, description: s.description }),
        });
      }
      location.reload();
    });

    document.querySelectorAll(".reject-image").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const img = document.querySelector(`.draft-image[data-id="${id}"]`);
        if (btn.disabled) return;
        btn.disabled = true;
        btn.textContent = "Buscando otra imagen…";
        let res, data;
        try {
          res = await fetch(`/api/brand/${id}/reject-image?token=${encodeURIComponent(token)}`, { method: "POST" });
          data = await res.json();
        } catch (err) {
          btn.disabled = false;
          btn.textContent = "Se perdió la conexión — intenta de nuevo";
          return;
        }
        btn.disabled = false;
        btn.textContent = "🖼️ Buscar otra imagen";
        if (res.ok && data.imageKey && img) {
          img.src = `/media/${data.imageKey}?t=${Date.now()}`;
        } else if (!data.imageKey) {
          img?.remove();
          btn.remove();
        }
      });
    });
  </script>
</AdminLayout>

<style>
