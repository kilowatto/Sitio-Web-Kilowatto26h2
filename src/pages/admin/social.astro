---
import Base from "../../layouts/Base.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

let pendingGroups: any[] = [];
let recentPosted: any[] = [];
let recentFailed: any[] = [];
let topics: any[] = [];
let paused = false;

if (authorized && env?.DB) {
  const [pending, posted, failed, pauseState, topicsRes] = await Promise.all([
    env.DB.prepare(
      `SELECT * FROM brand_posts WHERE status = 'pending_approval' ORDER BY variant_group, created_at`
    ).all(),
    env.DB.prepare(
      `SELECT * FROM brand_posts WHERE status = 'posted' ORDER BY posted_at DESC LIMIT 15`
    ).all(),
    env.DB.prepare(
      `SELECT * FROM brand_posts WHERE status = 'failed' ORDER BY created_at DESC LIMIT 10`
    ).all(),
    env.KILOWATTO_KV.get("brand_autopilot_paused"),
    env.DB.prepare(`SELECT * FROM brand_topics ORDER BY sort_order`).all(),
  ]);
  paused = pauseState === "true";
  recentPosted = posted?.results ?? [];
  recentFailed = failed?.results ?? [];
  topics = topicsRes?.results ?? [];

  const rows = pending?.results ?? [];
  const groups = new Map<string, any[]>();
  for (const r of rows as any[]) {
    const key = r.variant_group ?? `single-${r.id}`;
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)!.push(r);
  }
  pendingGroups = Array.from(groups.entries()).map(([key, items]) => ({ key, items }));
}
---

<Base title="Marca personal — Admin">
  <div class="container admin">
    {
      !authorized ? (
        <AdminLogin />
      ) : (
        <>
          <p class="admin-nav"><a href="/admin">← Panel de administración</a></p>
          <div class="pause-bar">
            <span>Autopiloto: <strong class={paused ? "off" : "on"}>{paused ? "PAUSADO" : "ACTIVO"}</strong></span>
            <button id="toggle-pause" data-paused={String(paused)}>
              {paused ? "Reanudar" : "Pausar todo ahora"}
            </button>
          </div>

          <h1>Borradores pendientes ({pendingGroups.length})</h1>
          <p class="hint">Posts de "idea" — nunca se publican solos. Reshares de prensa se auto-publican y solo aparecen abajo en el historial.</p>

          <div class="groups">
            {pendingGroups.map((g) => (
              <div class="group">
                {g.items.map((p: any) => (
                  <div class={`draft ${p.rejection_reason ? "draft--flagged" : ""}`} data-id={p.id}>
                    <p class="meta">
                      {p.platform.toUpperCase()} · variante {p.variant_style ?? "?"}
                      {p.rejection_reason && <span class="warn"> ⚠️ {p.rejection_reason}</span>}
                    </p>
                    {p.image_r2_key && (
                      <>
                        <img class="draft-image" data-id={p.id} src={`/media/${p.image_r2_key}`} alt="" loading="lazy" />
                        <button class="reject-image" data-id={p.id} type="button">
                          🖼️ Rechazar imagen (buscar otra)
                        </button>
                      </>
                    )}
                    <textarea class="content-box" data-id={p.id}>{p.content}</textarea>
                    <input
                      type="text"
                      class="reason-box"
                      data-id={p.id}
                      placeholder="Razón del rechazo (opcional)"
                    />
                    <div class="actions">
                      <button class="approve" data-id={p.id}>Aprobar</button>
                      <button class="reject" data-id={p.id}>Rechazar</button>
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </div>

          {recentFailed.length > 0 && (
            <>
              <h2>Fallidos ({recentFailed.length})</h2>
              <ul class="log">
                {recentFailed.map((p: any) => (
                  <li>
                    <strong>{p.platform}</strong> — {p.rejection_reason} — <em>{p.content.slice(0, 80)}…</em>
                  </li>
                ))}
              </ul>
            </>
          )}

          <h2>Temas</h2>
          <p class="hint">Larry solo elige entre los temas activos. Desactiva los que no quieras que toque, sin borrarlos.</p>
          <ul class="topics-list">
            {topics.map((t: any) => (
              <li class="topic-row" data-id={t.id}>
                <label>
                  <input type="checkbox" class="topic-toggle" data-id={t.id} checked={!!t.active} />
                  <strong>{t.label}</strong>
                </label>
                <p class="topic-desc">{t.description}</p>
              </li>
            ))}
          </ul>

          <div class="topic-brainstorm">
            <p class="hint">Dale un par de ideas o palabras y Larry piensa temas relacionados — los revisas, quitas los que no quieras, y guardas el resto.</p>
            <div class="brainstorm-input-row">
              <input type="text" id="brainstorm-seed" placeholder="Ideas o palabras (ej: cloud computing, Yucatán, IA)" />
              <button id="brainstorm-btn" type="button">✨ Generar temas</button>
            </div>
            <p id="brainstorm-status" class="hint"></p>
            <div id="brainstorm-chips" class="brainstorm-chips"></div>
            <button id="brainstorm-save" type="button" style="display:none">Guardar seleccionados</button>
          </div>

          <form id="topic-form" class="topic-form">
            <input type="text" id="topic-label" placeholder="Nuevo tema (ej: Cine y series)" required />
            <input type="text" id="topic-desc" placeholder="Descripción breve" />
            <button type="submit">+ Agregar tema</button>
          </form>

          <h2>Publicados recientemente</h2>
          <ul class="log">
            {recentPosted.map((p: any) => (
              <li>
                <strong>{p.platform}</strong> · {p.kind} · {p.posted_at} —{" "}
                {p.external_url ? <a href={p.external_url} target="_blank" rel="noopener">ver post</a> : p.content.slice(0, 80)}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>

  <script define:vars={{ token }}>
    document.getElementById("toggle-pause")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const currentlyPaused = btn.dataset.paused === "true";
      await fetch(`/api/brand/toggle-pause?token=${encodeURIComponent(token)}`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ paused: !currentlyPaused }),
      });
      location.reload();
    });

    document.querySelectorAll(".approve").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const textarea = document.querySelector(`.content-box[data-id="${id}"]`);
        await fetch(`/api/brand/${id}/approve?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ content: textarea?.value }),
        });
        btn.closest(".draft")?.remove();
      });
    });

    document.querySelectorAll(".reject").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const reasonBox = document.querySelector(`.reason-box[data-id="${id}"]`);
        const reason = reasonBox?.value?.trim() || undefined;
        await fetch(`/api/brand/${id}/reject?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ reason }),
        });
        btn.closest(".draft")?.remove();
      });
    });

    document.querySelectorAll(".topic-toggle").forEach((box) => {
      box.addEventListener("change", async () => {
        const id = box.dataset.id;
        await fetch(`/api/brand/topics/${id}?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ active: box.checked }),
        });
      });
    });

    document.getElementById("topic-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const label = document.getElementById("topic-label").value.trim();
      const description = document.getElementById("topic-desc").value.trim();
      if (!label) return;
      await fetch(`/api/brand/topics?token=${encodeURIComponent(token)}`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ label, description }),
      });
      location.reload();
    });

    let brainstormSuggestions = [];

    function renderBrainstormChips() {
      const container = document.getElementById("brainstorm-chips");
      container.innerHTML = "";
      brainstormSuggestions.forEach((s, i) => {
        const chip = document.createElement("div");
        chip.className = "brainstorm-chip";
        chip.innerHTML = `
          <button type="button" class="chip-remove" data-i="${i}">×</button>
          <strong>${s.label}</strong>
          <p>${s.description ?? ""}</p>
        `;
        chip.querySelector(".chip-remove").addEventListener("click", () => {
          brainstormSuggestions.splice(i, 1);
          renderBrainstormChips();
        });
        container.appendChild(chip);
      });
      document.getElementById("brainstorm-save").style.display = brainstormSuggestions.length ? "block" : "none";
    }

    document.getElementById("brainstorm-btn")?.addEventListener("click", async () => {
      const seed = document.getElementById("brainstorm-seed").value.trim();
      const status = document.getElementById("brainstorm-status");
      if (!seed) {
        status.textContent = "Escribe una idea o palabra primero.";
        return;
      }
      status.textContent = "Pensando temas…";
      const res = await fetch(`/api/brand/topics/suggest?token=${encodeURIComponent(token)}`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ seed }),
      });
      const data = await res.json();
      if (!res.ok || !data.suggestions?.length) {
        status.textContent = "No se pudieron generar temas, intenta de nuevo.";
        return;
      }
      brainstormSuggestions = data.suggestions;
      status.textContent = `${brainstormSuggestions.length} temas sugeridos — quita los que no quieras, luego guarda.`;
      renderBrainstormChips();
    });

    document.getElementById("brainstorm-save")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      btn.disabled = true;
      btn.textContent = "Guardando…";
      for (const s of brainstormSuggestions) {
        await fetch(`/api/brand/topics?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ label: s.label, description: s.description }),
        });
      }
      location.reload();
    });

    document.querySelectorAll(".reject-image").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const img = document.querySelector(`.draft-image[data-id="${id}"]`);
        btn.disabled = true;
        btn.textContent = "Buscando otra imagen…";
        const res = await fetch(`/api/brand/${id}/reject-image?token=${encodeURIComponent(token)}`, { method: "POST" });
        const data = await res.json();
        btn.disabled = false;
        btn.textContent = "🖼️ Rechazar imagen (buscar otra)";
        if (res.ok && data.imageKey && img) {
          img.src = `/media/${data.imageKey}?t=${Date.now()}`;
        } else if (!data.imageKey) {
          img?.remove();
          btn.remove();
        }
      });
    });
  </script>
</Base>

<style>
  .admin { padding-block: var(--space-4); }
  .admin-nav { margin-bottom: var(--space-2); font-size: 0.85rem; }
  .hint { color: var(--ink-soft); max-width: var(--measure); }

  .pause-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: var(--space-2);
    background: var(--mist);
    border-radius: 0.5rem;
    margin-bottom: var(--space-3);
  }
  .pause-bar .on { color: var(--rhino); }
  .pause-bar .off { color: #b91c1c; }
  .pause-bar button {
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: 0.4rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  .groups { display: grid; gap: var(--space-3); margin-top: var(--space-2); }
  .group { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: var(--space-2); }
  .draft {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: var(--space-2);
  }
  .draft--flagged { border-color: #b91c1c; }
  .meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-soft); margin: 0 0 0.4rem; }
  .warn { color: #b91c1c; }
  .draft-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .content-box {
    width: 100%;
    min-height: 6rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    padding: 0.5rem;
    font-family: inherit;
    resize: vertical;
  }
  .reason-box {
    width: 100%;
    margin-top: 0.4rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    font-size: 0.8rem;
  }
  .actions { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
  .actions button { flex: 1; border: none; border-radius: 0.4rem; padding: 0.4rem 0; cursor: pointer; }
  .approve { background: var(--rhino); color: #fff; }
  .reject { background: var(--mist); color: var(--ink); }

  .log { font-size: 0.85rem; color: var(--ink-soft); display: grid; gap: 0.3rem; }

  .topics-list { list-style: none; padding: 0; display: grid; gap: 0.5rem; margin-bottom: var(--space-2); }
  .topic-row {
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    padding: 0.5rem 0.8rem;
  }
  .topic-row label { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
  .topic-desc { margin: 0.2rem 0 0 1.6rem; font-size: 0.8rem; color: var(--ink-soft); }
  .topic-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-3);
  }
  .topic-form input {
    flex: 1;
    min-width: 10rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
  }
  .topic-form button {
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: 0.4rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  .reject-image {
    display: block;
    width: 100%;
    margin: 0.3rem 0 0.5rem;
    background: none;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    padding: 0.35rem 0;
    font-size: 0.75rem;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .topic-brainstorm {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .brainstorm-input-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .brainstorm-input-row input {
    flex: 1;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
  }

  .brainstorm-input-row button {
    background: var(--rhino);
    color: #fff;
    border: none;
    border-radius: 0.4rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .brainstorm-chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .brainstorm-chip {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    padding: 0.5rem 0.6rem;
    font-size: 0.82rem;
  }

  .brainstorm-chip strong {
    display: block;
    margin-bottom: 0.2rem;
    padding-right: 1.2rem;
  }

  .brainstorm-chip p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .chip-remove {
    position: absolute;
    top: 0.3rem;
    right: 0.4rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1;
  }

  #brainstorm-save {
    margin-top: 0.6rem;
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: 0.4rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }
</style>
