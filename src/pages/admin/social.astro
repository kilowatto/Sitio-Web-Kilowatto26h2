  /* ---- Draft review cards: the primary content, one column by default ---- */
  /* Plain grid, not CSS multi-column masonry — columns fills column-major (top-to-bottom,
     then next column), which reads as "wrong" in a review queue where cards should scan
     left-to-right, top-to-bottom (confirmed live 2026-07-23). align-items:start lets each
     group keep its own natural height without stretching to match its row neighbor. */
  .groups {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  @media (min-width: 42rem) {
    .groups { grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr)); }
  }
  .group { display: block; margin-bottom: 0; }
  .group .draft { margin-bottom: var(--space-2); }
  .group .draft:last-child { margin-bottom: 0; }
  .group-label {
