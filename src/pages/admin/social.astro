---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

let pendingGroups: any[] = [];
let recentPosted: any[] = [];
let recentFailed: any[] = [];
let topics: any[] = [];
let paused = false;
let fixedHashtags = "";
let totalDraftsCount = 0;
let newsSources: any[] = [];
let newsTrust: any[] = [];
let newsAutopilotPaused = false;
let recentAutoPublished: any[] = [];
let recentExpired: any[] = [];

if (authorized && env?.DB) {
  const [
    pending,
    posted,
    failed,
    pauseState,
    topicsRes,
    fixedHashtagsRes,
    draftsCountRes,
    newsSourcesRes,
    newsTrustRes,
    newsAutopilotPauseState,
    autoPublishedRes,
    expiredRes,
  ] = await Promise.all([
    env.DB.prepare(
      `SELECT * FROM brand_posts WHERE status = 'pending_approval' ORDER BY variant_group, created_at`
    ).all(),
    env.DB.prepare(
      `SELECT * FROM brand_posts WHERE status = 'posted' ORDER BY posted_at DESC LIMIT 15`
    ).all(),
    env.DB.prepare(
      `SELECT * FROM brand_posts WHERE status = 'failed' ORDER BY created_at DESC LIMIT 10`
    ).all(),
    env.KILOWATTO_KV.get("brand_autopilot_paused"),
    env.DB.prepare(`SELECT * FROM brand_topics ORDER BY sort_order`).all(),
    env.KILOWATTO_KV.get("brand_fixed_hashtags"),
    env.DB.prepare(`SELECT COUNT(*) AS n FROM brand_posts WHERE status = 'pending_approval'`).first(),
    env.DB.prepare(`SELECT * FROM news_sources ORDER BY trusted DESC, name`).all(),
    env.DB.prepare(`SELECT * FROM news_reaction_trust`).all(),
    env.KILOWATTO_KV.get("news_autopilot_paused"),
    env.DB.prepare(
      `SELECT * FROM brand_posts WHERE auto_published = 1 AND posted_at >= datetime('now', '-2 days') ORDER BY posted_at DESC LIMIT 10`
    ).all(),
    env.DB.prepare(
      `SELECT * FROM brand_posts WHERE kind = 'news_reaction' AND status = 'expired' ORDER BY created_at DESC LIMIT 15`
    ).all(),
  ]);
  paused = pauseState === "true";
  recentPosted = posted?.results ?? [];
  recentFailed = failed?.results ?? [];
  topics = topicsRes?.results ?? [];
  fixedHashtags = fixedHashtagsRes ?? "";
  totalDraftsCount = (draftsCountRes as any)?.n ?? 0;
  newsSources = newsSourcesRes?.results ?? [];
  newsTrust = newsTrustRes?.results ?? [];
  newsAutopilotPaused = newsAutopilotPauseState === "true";
  recentAutoPublished = autoPublishedRes?.results ?? [];
  recentExpired = expiredRes?.results ?? [];

  const rows = pending?.results ?? [];
  const groups = new Map<string, any[]>();
  for (const r of rows as any[]) {
    const key = r.variant_group ?? `single-${r.id}`;
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)!.push(r);
  }
  pendingGroups = Array.from(groups.entries()).map(([key, items]) => ({ key, items }));
}

const trustByPlatform: Record<string, any> = Object.fromEntries(newsTrust.map((t: any) => [t.platform, t]));

const IMAGE_STYLE_LABELS: Record<string, string> = {
  illustration: "🎨 Ilustración",
  infographic: "📊 Infografía",
  real_photo: "📷 Foto real",
  photorealistic: "🖼️ Fotorrealista",
};

function timeAgo(iso: string | null): string {
  if (!iso) return "nunca";
  const mins = Math.floor((Date.now() - new Date(iso).getTime()) / 60_000);
  if (mins < 2) return "hace un momento";
  if (mins < 60) return `hace ${mins} min`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `hace ${hours}h`;
  return `hace ${Math.floor(hours / 24)}d`;
}

function formatCountdown(expiresAt: string | null): string | null {
  if (!expiresAt) return null;
  const ms = new Date(expiresAt.replace(" ", "T") + "Z").getTime() - Date.now();
  if (ms <= 0) return "vence en cualquier momento";
  const hours = Math.floor(ms / 3_600_000);
  const mins = Math.floor((ms % 3_600_000) / 60_000);
  if (hours >= 1) return `vence en ${hours}h ${mins}m`;
  return `vence en ${mins}m`;
}
---

<AdminLayout title="Posting automático — Admin" active="/admin/social" authorized={authorized}>
  <div class="container admin">
    {
      !authorized ? (
        <AdminLogin />
      ) : (
        <>
          <p class="admin-nav"><a href="/admin">← Panel de administración</a></p>

          <div class="pause-bar">
            <div class="pause-status">
              <span class="pause-dot" data-paused={String(paused)} aria-hidden="true" />
              <span>Autopiloto <strong class={paused ? "off" : "on"}>{paused ? "pausado" : "activo"}</strong></span>
            </div>
            <div class="pause-actions">
              <button id="regen-all-btn" type="button" data-drafts-count={totalDraftsCount}>
                🔄 {totalDraftsCount === 0 ? "Generar nuevos" : "Generar nuevos (descarta actuales)"}
              </button>
              <button id="toggle-pause" data-paused={String(paused)}>
                {paused ? "Reanudar" : "Pausar todo"}
              </button>
            </div>
          </div>
          <div id="regen-all-progress" class="regen-progress" hidden>
            <div class="regen-progress-track">
              <div id="regen-progress-fill" class="regen-progress-fill"></div>
            </div>
            <p id="regen-all-status" class="hint"></p>
          </div>

          {recentAutoPublished.length > 0 && (
            <div class="auto-published-banner">
              <p class="field-label">🤖 Publicado en automático (sin tu aprobación)</p>
              <ul class="log">
                {recentAutoPublished.map((p: any) => (
                  <li>
                    <strong>{p.platform.toUpperCase()}</strong> · {p.posted_at} —{" "}
                    {p.external_url ? <a href={p.external_url} target="_blank" rel="noopener">ver post</a> : p.content.slice(0, 80)}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="news-pilot-bar">
            <div class="news-pilot-status">
              <span>📰 Piloto de noticias:</span>
              <span class={newsAutopilotPaused ? "off" : "on"}>{newsAutopilotPaused ? "pausado" : "activo"}</span>
              {["x", "linkedin"].map((plat) => {
                const t = trustByPlatform[plat];
                const n = t?.consecutive_clean_approvals ?? 0;
                const enabled = !!t?.autopilot_enabled;
                return (
                  <span class="trust-chip" data-enabled={String(enabled)}>
                    {plat.toUpperCase()}: {enabled ? "🟢 autopublica" : `${Math.min(n, 10)}/10`}
                  </span>
                );
              })}
            </div>
            <button id="toggle-news-autopilot" data-paused={String(newsAutopilotPaused)}>
              {newsAutopilotPaused ? "Reactivar piloto de noticias" : "🛑 Apagar piloto de noticias"}
            </button>
          </div>

          <div class="composer">
            <p class="field-label">✨ Crear post desde una idea (investiga en internet)</p>
            <p class="hint">
              Dale una idea libre — Larry busca información real en internet, escribe el post citando sus fuentes
              (como links cortos rastreables) y lo ilustra con Larry haciendo algo relacionado. Ej: "Quiero postear
              sobre el nuevo procesador Spark de NVIDIA, investiga qué se sabe y crea una ilustración del Orange
              Rhino instalando un procesador."
            </p>
            <textarea id="idea-input" rows="3" placeholder="Escribe tu idea aquí…"></textarea>
            <div class="composer-row">
              <select id="idea-platform">
                <option value="x">X</option>
                <option value="linkedin">LinkedIn</option>
                <option value="both">Ambas</option>
              </select>
              <input type="datetime-local" id="idea-schedule" title="Programar para (opcional)" />
              <button id="idea-submit" type="button">Investigar y generar</button>
            </div>
            <p id="idea-status" class="hint"></p>
          </div>

          <h1>Pendientes de aprobar <span class="count-badge">{pendingGroups.length}</span></h1>
          <p class="hint">Posts de "idea" — nunca se publican solos. Reshares de prensa se auto-publican y solo aparecen en el historial.</p>

          {pendingGroups.length === 0 && (
            <div class="empty-state">
              <p>No hay borradores esperando aprobación ahora mismo.</p>
              <button id="generate-batch-btn" type="button">✨ Generar 6 posts nuevos</button>
              <div id="batch-progress" class="regen-progress" hidden>
                <div class="regen-progress-track">
                  <div id="batch-progress-fill" class="regen-progress-fill"></div>
                </div>
                <p id="batch-status" class="hint"></p>
              </div>
            </div>
          )}

          <div class="groups">
            {pendingGroups.map((g) => (
              <div class="group">
                {g.items.length > 1 && <p class="group-label">Variantes A/B — misma imagen, distinto gancho</p>}
                {g.items.map((p: any) => (
                  <div class={`draft ${p.rejection_reason ? "draft--flagged" : ""}`} data-id={p.id}>
                    <p class="meta">
                      <span class="platform-badge">{p.platform.toUpperCase()}</span>
                      <span class="variant-badge">{p.variant_style ?? "único"}</span>
                      {p.kind === "news_reaction" && <span class="news-badge">📰 Noticia</span>}
                      {p.kind === "investigacion_highlight" && <span class="news-badge">🔎 A Fondo</span>}
                      {p.kind === "news_reaction" && p.expires_at && (
                        <span class="expiry-badge">⏱️ {formatCountdown(p.expires_at)}</span>
                      )}
                      {p.scheduled_for && <span class="expiry-badge">📅 {p.scheduled_for}</span>}
                    </p>
                    {p.kind === "news_reaction" && p.source_url && (
                      <p class="hint">
                        <a href={p.source_url} target="_blank" rel="noopener">Ver noticia original →</a>
                      </p>
                    )}
                    {p.kind === "investigacion_highlight" && p.source_url && (
                      <p class="hint">
                        <a href={p.source_url} target="_blank" rel="noopener">Ver la investigación →</a>
                      </p>
                    )}
                    {p.rejection_reason && <p class="warn">⚠️ {p.rejection_reason}</p>}

                    {p.image_r2_key && (
                      <div class="image-block">
                        <img class="draft-image" data-id={p.id} src={`/media/${p.image_r2_key}?w=500`} alt="" />
                        <button class="reject-image" data-id={p.id} type="button">
                          🖼️ Buscar otra imagen
                        </button>
                      </div>
                    )}

                    <label class="field-label" for={`content-${p.id}`}>Texto del post</label>
                    <textarea id={`content-${p.id}`} class="content-box" data-id={p.id}>{p.content}</textarea>

                    <label class="field-label" for={`hashtags-input-${p.id}`}>Hashtags</label>
                    <div class="chip-editor" data-hashtag-editor data-id={p.id}>
                      <div class="chip-list" data-chip-list></div>
                      <input
                        type="text"
                        class="chip-add-input"
                        data-chip-add
                        placeholder="Escribe y presiona Enter…"
                      />
                    </div>
                    <input type="hidden" class="hashtags-box" data-id={p.id} value={p.hashtags ?? ""} />
                    <p class="hint hashtags-fixed-hint">+ fijos siempre: {fixedHashtags || "(ninguno configurado)"}</p>

                    {p.sources && JSON.parse(p.sources).length > 0 && (
                      <details class="sources-details">
                        <summary>Fuentes investigadas ({JSON.parse(p.sources).length})</summary>
                        <ul class="sources-list">
                          {JSON.parse(p.sources).map((s: any) => (
                            <li>
                              <a href={s.url} target="_blank" rel="noopener">{s.title || s.url}</a>
                              {" — "}
                              <span class="source-short">{s.shortUrl}</span>
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}

                    <details class="reject-details">
                      <summary>Razón del rechazo (opcional)</summary>
                      <input
                        type="text"
                        class="reason-box"
                        data-id={p.id}
                        placeholder="¿Por qué lo rechazas?"
                      />
                    </details>

                    <div class="actions">
                      <button class="approve" data-id={p.id}>✓ Aprobar</button>
                      <button class="reject" data-id={p.id}>Rechazar</button>
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </div>

          <details class="section" open={recentFailed.length > 0}>
            <summary>
              Fallidos <span class="count-badge">{recentFailed.length}</span>
            </summary>
            <div class="section-body">
              {recentFailed.length === 0 ? (
                <p class="hint">Nada fallido recientemente.</p>
              ) : (
                <ul class="log">
                  {recentFailed.map((p: any) => (
                    <li>
                      <strong>{p.platform}</strong> — {p.rejection_reason} — <em>{p.content.slice(0, 80)}…</em>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </details>

          <details class="section">
            <summary>
              Noticias expiradas <span class="count-badge">{recentExpired.length}</span>
            </summary>
            <div class="section-body">
              <p class="hint">Propuestas de noticias que nadie aprobó a tiempo — se descartaron solas, no cuentan como rechazo.</p>
              {recentExpired.length === 0 ? (
                <p class="hint">Ninguna expirada recientemente.</p>
              ) : (
                <ul class="log">
                  {recentExpired.map((p: any) => (
                    <li>
                      <strong>{p.platform}</strong> — <em>{p.content.slice(0, 100)}…</em>
                      {p.source_url && <> — <a href={p.source_url} target="_blank" rel="noopener">fuente</a></>}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </details>

          <details class="section">
            <summary>
              Temas <span class="count-badge">{topics.filter((t: any) => t.active).length}/{topics.length}</span>
            </summary>
            <div class="section-body">
              <p class="hint">Larry solo elige entre los temas activos. Desactiva los que no quieras que toque, o bórralos si ya no los vas a usar. El estilo de imagen define cómo se ilustra cada post de ese tema.</p>

              <div class="topics-toolbar">
                <input type="text" id="topics-search" placeholder="🔎 Buscar tema…" />
                <div class="topics-filter" role="group" aria-label="Filtrar temas">
                  <button type="button" class="filter-btn is-active" data-filter="active">Activos</button>
                  <button type="button" class="filter-btn" data-filter="all">Todos</button>
                  <button type="button" class="filter-btn" data-filter="inactive">Inactivos</button>
                </div>
              </div>

              <div class="topics-select-bar">
                <button type="button" id="topics-select-mode-btn">☑️ Seleccionar</button>
                <button type="button" id="topics-review-all-btn">🔍 Revisar vigencia (activos)</button>
                <div id="topics-bulk-bar" class="topics-bulk-bar" hidden>
                  <span id="topics-selected-count">0 seleccionados</span>
                  <button type="button" id="topics-select-cancel">Cancelar</button>
                  <button type="button" id="topics-bulk-delete">🗑️ Borrar seleccionados</button>
                </div>
              </div>
              <p id="topics-review-all-status" class="hint"></p>
              <div id="topics-progress" class="topics-progress" hidden>
                <div id="topics-progress-bar" class="topics-progress__bar" style="width: 0%"></div>
              </div>
              <ul id="topics-stale-summary" class="topics-stale-summary" hidden></ul>

              <ul class="topics-list" id="topics-list">
                {topics.map((t: any) => (
                  <li class="topic-row" data-id={t.id} data-active={String(!!t.active)} data-label={t.label.toLowerCase()}>
                    <div class="topic-main">
                      <input type="checkbox" class="topic-select" data-id={t.id} hidden />
                      <label class="topic-toggle-row">
                        <input type="checkbox" class="topic-toggle" data-id={t.id} checked={!!t.active} />
                        <span class="topic-name">{t.label}</span>
                      </label>
                      <div class="topic-row-actions">
                        {!!t.stale_flag && <span class="topic-stale-badge" title={t.review_note ?? "Posible desactualización"}>🚩</span>}
                        <span class="topic-style-badge">{IMAGE_STYLE_LABELS[t.image_style]?.split(" ")[0] ?? "🎨"}</span>
                        <button type="button" class="topic-expand" data-id={t.id} aria-expanded="false" title="Ver detalles">⌄</button>
                        <button type="button" class="topic-delete" data-id={t.id} title="Borrar tema">🗑️</button>
                      </div>
                    </div>
                    <div class="topic-details" hidden>
                      <p class="topic-desc">{t.description}</p>
                      <select class="image-style-select" data-id={t.id}>
                        {Object.entries(IMAGE_STYLE_LABELS).map(([value, label]) => (
                          <option value={value} selected={t.image_style === value}>{label}</option>
                        ))}
                      </select>
                      <p class="topic-review-meta">
                        Revisado: {timeAgo(t.last_reviewed_at)}
                      </p>
                      <button type="button" class="topic-review-btn" data-id={t.id}>🔍 Revisar vigencia</button>
                      <div class="topic-stale-actions" data-id={t.id} hidden={!t.stale_flag}>
                        <p class="topic-review-note">{t.review_note ?? ""}</p>
                        <div class="topic-stale-actions__buttons">
                          <button type="button" class="topic-keep-btn" data-id={t.id}>✅ Se queda</button>
                          <button type="button" class="topic-remove-btn" data-id={t.id}>🗑️ Se va</button>
                        </div>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>

              <div class="topic-brainstorm">
                <p class="field-label">✨ Generador de temas</p>
                <p class="hint">Dale un par de ideas o palabras y Larry piensa temas relacionados — quitas los que no quieras y guardas el resto.</p>
                <div class="input-row">
                  <input type="text" id="brainstorm-seed" placeholder="Ej: cloud computing, Yucatán, IA" />
                  <button id="brainstorm-btn" type="button">Generar</button>
                </div>
                <p id="brainstorm-status" class="hint"></p>
                <div id="brainstorm-chips" class="brainstorm-chips"></div>
                <button id="brainstorm-save" type="button" style="display:none">Guardar seleccionados</button>
              </div>

              <form id="topic-form" class="topic-form">
                <p class="field-label">+ Agregar tema manualmente</p>
                <input type="text" id="topic-label" placeholder="Nombre del tema (ej: Cine y series)" required />
                <input type="text" id="topic-desc" placeholder="Descripción breve" />
                <button type="submit">Agregar</button>
              </form>
            </div>
          </details>

          <details class="section">
            <summary>
              Fuentes de noticias <span class="count-badge">{newsSources.filter((s: any) => s.trusted).length}/{newsSources.length}</span>
            </summary>
            <div class="section-body">
              <p class="hint">Solo noticias de medios marcados como confiables entran al radar de reacciones. Desmarca los que no quieras usar, sin borrarlos.</p>
              <ul class="sources-list" id="sources-list">
                {newsSources.map((s: any) => (
                  <li class="source-row" data-id={s.id}>
                    <label class="source-toggle-row">
                      <input type="checkbox" class="source-toggle" data-id={s.id} checked={!!s.trusted} />
                      <span class="source-name">{s.name}</span>
                      {s.domain && <span class="source-domain">{s.domain}</span>}
                    </label>
                    <button type="button" class="source-delete" data-id={s.id} title="Borrar fuente">🗑️</button>
                  </li>
                ))}
              </ul>
              <form id="source-form" class="topic-form">
                <p class="field-label">+ Agregar medio manualmente</p>
                <input type="text" id="source-name" placeholder="Nombre del medio (ej: Xataka)" required />
                <input type="text" id="source-domain" placeholder="Dominio (opcional, ej: xataka.com)" />
                <button type="submit">Agregar</button>
              </form>
            </div>
          </details>

          <details class="section">
            <summary>Hashtags fijos</summary>
            <div class="section-body">
              <p class="hint">Se agregan automáticamente a TODOS los posts al publicar, además de los que Larry genera por post.</p>
              <div class="chip-editor" data-hashtag-editor id="fixed-hashtags-editor">
                <div class="chip-list" data-chip-list></div>
                <input type="text" class="chip-add-input" data-chip-add placeholder="Escribe y presiona Enter…" />
              </div>
              <input type="hidden" id="fixed-hashtags-input" value={fixedHashtags} />
              <button id="fixed-hashtags-save" type="button">Guardar</button>
              <p id="fixed-hashtags-status" class="hint"></p>
            </div>
          </details>

          <details class="section">
            <summary>
              Publicados recientemente <span class="count-badge">{recentPosted.length}</span>
            </summary>
            <div class="section-body">
              <ul class="log">
                {recentPosted.map((p: any) => (
                  <li>
                    <strong>{p.platform}</strong> · {p.kind} · {p.posted_at} —{" "}
                    {p.external_url ? <a href={p.external_url} target="_blank" rel="noopener">ver post</a> : p.content.slice(0, 80)}
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </>
      )
    }
  </div>

  <script define:vars={{ token }}>
    // ---- Chip editor: purely presentational wrapper around a hidden <input> whose value
    // is the same space-joined hashtag string the backend has always read. Every existing
    // handler below still reads `.value` off `.hashtags-box` / `#fixed-hashtags-input`
    // unchanged — this only changes how that value gets edited.
    function parseHashtags(value) {
      return (value || "").split(/\s+/).map((s) => s.trim()).filter(Boolean);
    }

    function initChipEditor(root) {
      const hiddenInput = root.dataset.id
        ? document.querySelector(`.hashtags-box[data-id="${root.dataset.id}"]`)
        : document.getElementById("fixed-hashtags-input");
      const list = root.querySelector("[data-chip-list]");
      const addInput = root.querySelector("[data-chip-add]");
      if (!hiddenInput || !list || !addInput) return;

      let tags = parseHashtags(hiddenInput.value);

      function normalize(raw) {
        const t = raw.trim().replace(/\s+/g, "");
        if (!t) return null;
        return t.startsWith("#") ? t : `#${t}`;
      }

      function render() {
        list.innerHTML = "";
        tags.forEach((tag, i) => {
          const chip = document.createElement("span");
          chip.className = "chip";
          chip.innerHTML = `<span class="chip-text"></span><button type="button" class="chip-x" aria-label="Quitar">×</button>`;
          chip.querySelector(".chip-text").textContent = tag;
          chip.querySelector(".chip-x").addEventListener("click", () => {
            tags.splice(i, 1);
            sync();
          });
          list.appendChild(chip);
        });
      }

      function sync() {
        hiddenInput.value = tags.join(" ");
        render();
      }

      addInput.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== ",") return;
        e.preventDefault();
        const parts = addInput.value.split(/[,\s]+/).map(normalize).filter(Boolean);
        if (parts.length) {
          tags.push(...parts.filter((p) => !tags.includes(p)));
          addInput.value = "";
          sync();
        }
      });
      addInput.addEventListener("blur", () => {
        const p = normalize(addInput.value);
        if (p && !tags.includes(p)) {
          tags.push(p);
          addInput.value = "";
          sync();
        }
      });

      render();
    }

    document.querySelectorAll("[data-hashtag-editor]").forEach(initChipEditor);

    // Auto-grow every content textarea to fit its full text on load and on edit --
    // the fixed 7rem min-height was hiding the trailing "sigo leyendo -> URL" line
    // below the fold on longer posts (confirmed live 2026-08-21 on investigacion_highlight
    // posts: the link was always in the data, just invisible without manually dragging
    // the resize handle, which read to Esteban as "there's no link at all").
    function autoGrow(el) {
      el.style.height = "auto";
