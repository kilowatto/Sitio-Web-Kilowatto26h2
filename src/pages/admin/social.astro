  }
  .filter-btn.is-active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  @media (min-width: 30rem) {
    .topics-toolbar { flex-direction: row; align-items: center; }
    #topics-search { width: auto; flex: 1; }
    .topics-filter { flex-shrink: 0; }
    .filter-btn { flex: none; }
  }

  /* ---- Select mode: a DISTINCT checkbox from the active/inactive toggle — clicking the
     active toggle used to be mistaken for "selecting" a row, which silently reactivated
     topics Esteban meant to bulk-delete (confirmed live 2026-07-21). This checkbox only
     ever means "included in the next bulk delete", never touches `active`. ---- */
  .topics-select-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
  #topics-select-mode-btn {
    background: var(--mist);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.5rem 0.7rem;
    font-size: 0.82rem;
    cursor: pointer;
    color: var(--ink);
    min-height: 2.5rem;
  }
  #topics-select-mode-btn.is-active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .topics-bulk-bar {
    display: none;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }
  /* Author `display` rules beat the UA `[hidden]{display:none}` default, so without this
     the bar showed even at 0 selected — confirmed live 2026-07-21. */
  .topics-bulk-bar:not([hidden]) { display: flex; }
  #topics-select-cancel {
    background: none;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    color: var(--ink-soft);
  }
  #topics-bulk-delete {
    background: #b91c1c;
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    padding: 0.5rem 0.7rem;
    cursor: pointer;
    min-height: 2.5rem;
  }
  .topic-select { width: 1.2rem; height: 1.2rem; flex-shrink: 0; display: none; }
  /* Select mode swaps the active-toggle + per-row delete for the plain select checkbox,
     so there's never a checkbox on screen that could mean two different things at once. */
  #topics-list.select-mode .topic-select { display: inline-block; }
  #topics-list.select-mode .topic-toggle { display: none; }
  #topics-list.select-mode .topic-delete { display: none; }

  /* ---- Compact single-line topic rows — description/style select collapse behind a
     disclosure toggle so 40+ topics don't turn into a mile of scrolling. ---- */
  .topics-list { list-style: none; padding: 0; display: grid; gap: 0.4rem; margin: 0.6rem 0 var(--space-2); }
  .topic-row {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.55rem 0.7rem;
    min-width: 0;
  }
  .topic-row[data-active="false"] { opacity: 0.55; }
  .topic-row.is-hidden { display: none; }
  .topic-row.is-selected { border-color: var(--rhino); background: color-mix(in srgb, var(--rhino) 8%, var(--paper)); }
  .topic-row.is-highlighted { border-color: var(--rhino); box-shadow: 0 0 0 2px color-mix(in srgb, var(--rhino) 30%, transparent); transition: box-shadow 0.3s ease; }
  .topics-stale-summary {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--rhino);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--rhino) 6%, var(--paper));
    font-size: 0.85rem;
    display: grid;
    gap: 0.35rem;
  }
  /* `display: grid` above beats the browser's own `[hidden] { display: none }` rule (author
     styles win over the user-agent stylesheet at equal specificity) — without this, the box
     stays visible-but-empty even while the `hidden` attribute is set. Same fix applied to the
     progress bar below, which hit the identical bug. */
  .topics-stale-summary[hidden] { display: none; }
  .topics-progress {
    height: 0.4rem;
    border-radius: 999px;
