---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";

export const prerender = false;

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

const STYLE_LABEL: Record<string, string> = {
  infographic: "Infografía",
  illustration: "Ilustración",
  photorealistic: "Foto IA",
  real_photo: "Foto",
};
const KIND_LABEL: Record<string, string> = {
  news_reshare: "Noticia",
  news_reaction: "Reacción",
  idea: "Idea propia",
  investigacion_highlight: "Investigación",
};
const DOW_FULL = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
const MONTHS = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];

interface CalEvent {
  id: number;
  date: string; // YYYY-MM-DD, America/Mexico_City local
  time: string; // HH:MM, America/Mexico_City local
  platform: string;
  kind: string;
  content: string;
  imageKey: string | null;
  imageStyle: string | null;
}

// scheduled_for is stored UTC; the whole UI is for one person in Mexico City, so shift
// once here and let every view (agenda, day, week, month) work in local time. Grouping by
// the raw UTC date was quietly putting late-evening posts on the following day.
function toLocal(sqlUtc: string): { date: string; time: string } {
  const [d, t] = String(sqlUtc).split(" ");
  const ms = Date.parse(`${d}T${t ?? "00:00:00"}Z`) - 6 * 3600 * 1000;
  const dt = new Date(ms);
  return { date: dt.toISOString().slice(0, 10), time: dt.toISOString().slice(11, 16) };
}

function longLabel(dateKey: string): string {
  const [y, m, d] = dateKey.split("-").map(Number);
  const dow = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
  return `${DOW_FULL[dow]} ${d} de ${MONTHS[m - 1]}`;
}

let events: CalEvent[] = [];
let totalScheduled = 0;
let unscheduledCount = 0;

if (authorized && env?.DB) {
  const [res, totalRes, backlogRes] = await Promise.all([
    env.DB.prepare(
      `SELECT id, scheduled_for, platform, kind, content, image_r2_key, image_style
       FROM brand_posts
       WHERE status = 'approved' AND scheduled_for > datetime('now')
       ORDER BY scheduled_for ASC
       LIMIT 200`
    ).all(),
    env.DB.prepare(
      `SELECT COUNT(*) AS n FROM brand_posts WHERE status = 'approved' AND scheduled_for > datetime('now')`
    ).first<{ n: number }>(),
    env.DB.prepare(
      `SELECT COUNT(*) AS n FROM brand_posts WHERE status = 'approved' AND scheduled_for IS NULL`
    ).first<{ n: number }>(),
  ]);
  events = (res.results ?? []).map((r: any) => {
    const { date, time } = toLocal(r.scheduled_for);
    return {
      id: r.id,
      date,
      time,
      platform: r.platform,
      kind: r.kind,
      content: r.content ?? "",
      imageKey: r.image_r2_key ?? null,
      imageStyle: r.image_style ?? null,
    };
  });
  totalScheduled = totalRes?.n ?? 0;
  unscheduledCount = backlogRes?.n ?? 0;
}

const eventsByDate: Record<string, CalEvent[]> = {};
for (const e of events) (eventsByDate[e.date] ??= []).push(e);

// Server-rendered agenda: the default view, so the page always shows real posts on load
// instead of depending on client JS landing on a day that happens to have something.
const agendaGroups = Object.keys(eventsByDate)
  .sort()
  .map((date) => ({ date, label: longLabel(date), items: eventsByDate[date] }));

const withImage = events.filter((e) => e.imageKey).length;
const xCount = events.filter((e) => e.platform === "x").length;
const linkedinCount = events.filter((e) => e.platform === "linkedin").length;
const next7 = events.filter((e) => {
  const cutoff = new Date(Date.now() + 7 * 86_400_000).toISOString().slice(0, 10);
  return e.date <= cutoff;
}).length;
---

{
  !authorized ? (
    <AdminLogin />
  ) : (
    <AdminLayout title="Calendario — Admin" active="/admin/calendario">
      <div class="cal-page">
        <header class="cal-header">
          <h1>Calendario de publicaciones</h1>
          <div class="stat-strip">
            <span><b>{totalScheduled}</b> programados</span>
            <span><b>{next7}</b> en 7 días</span>
            <span><b>{xCount}</b> 𝕏</span>
            <span><b>{linkedinCount}</b> LinkedIn</span>
            <span><b>{withImage}</b> con imagen</span>
          </div>
        </header>

        {unscheduledCount > 0 && (
          <p class="backlog-banner">
            <b>{unscheduledCount}</b> posts aprobados sin fecha — no aparecen aquí hasta programarse.
          </p>
        )}

        <div class="toolbar">
          <div class="segmented">
            <button class="seg-btn is-active" data-view="agenda">Agenda</button>
            <button class="seg-btn" data-view="day">Día</button>
            <button class="seg-btn" data-view="week">Semana</button>
            <button class="seg-btn" data-view="month">Mes</button>
            <button class="seg-btn" data-view="quarter">Trimestre</button>
          </div>
          <button id="today-btn" class="ghost-btn">Hoy</button>
        </div>

        <div id="cal-agenda" class="cal-view">
          {agendaGroups.length === 0 ? (
            <p class="empty-state">No hay publicaciones programadas a futuro.</p>
          ) : (
            <table class="agenda-table">
              <thead>
                <tr>
                  <th class="c-time">Hora</th>
                  <th class="c-net">Red</th>
                  <th class="c-kind">Tipo</th>
                  <th class="c-media">Media</th>
                  <th>Contenido</th>
                </tr>
              </thead>
              {agendaGroups.map((g) => (
                <tbody>
                  <tr class="group-row">
                    <th colspan="5" scope="colgroup">
                      {g.label} <span class="group-count">{g.items.length}</span>
                    </th>
                  </tr>
                  {g.items.map((e) => (
                    <tr class="post-row">
                      <td class="c-time mono">{e.time}</td>
                      <td class="c-net">
                        <span class={`net net-${e.platform}`}>{e.platform === "x" ? "𝕏" : "in"}</span>
                      </td>
                      <td class="c-kind">{KIND_LABEL[e.kind] ?? e.kind}</td>
                      <td class="c-media">
                        {e.imageKey ? (
                          <span class="media-cell">
                            <img src={`/media/${e.imageKey}?w=96`} alt="" loading="lazy" class="thumb" />
                            <span class="media-tag">{STYLE_LABEL[e.imageStyle ?? ""] ?? "Imagen"}</span>
                          </span>
                        ) : (
                          <span class="media-tag none">Texto</span>
                        )}
                      </td>
                      <td class="c-content">{e.content}</td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          )}
        </div>

        <div id="cal-day" class="cal-view" hidden></div>
        <div id="cal-week" class="cal-view" hidden></div>
        <div id="cal-month" class="cal-view" hidden></div>
        <div id="cal-quarter" class="cal-view" hidden></div>
      </div>

      <script type="application/json" id="cal-events" set:html={JSON.stringify(eventsByDate).replace(/</g, "\\u003c")} />

      <script>
        const DOW = ["L", "M", "X", "J", "V", "S", "D"];
        const MONTH_NAMES = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
        const KIND_LABEL: Record<string, string> = {
          news_reshare: "Noticia",
          news_reaction: "Reacción",
          idea: "Idea propia",
          investigacion_highlight: "Investigación",
        };
        const STYLE_LABEL: Record<string, string> = {
          infographic: "Infografía",
          illustration: "Ilustración",
          photorealistic: "Foto IA",
          real_photo: "Foto",
        };
        const eventsByDate = JSON.parse(document.getElementById("cal-events")?.textContent || "{}");
        const allDates = Object.keys(eventsByDate).sort();

        function pad(n: number) { return n < 10 ? "0" + n : "" + n; }
        function keyOf(d: Date) { return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()); }
        function addDays(d: Date, n: number) { const r = new Date(d); r.setDate(r.getDate() + n); return r; }
        function startOfWeek(d: Date) { return addDays(d, -((d.getDay() + 6) % 7)); }
        function monthName(y: number, m: number) { return MONTH_NAMES[m] + " " + y; }
        function escapeHtml(s: string) { return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
        function today0() { const t = new Date(); t.setHours(0, 0, 0, 0); return t; }

        function buildMonthCells(y: number, m: number) {
          const startWeekday = (new Date(y, m, 1).getDay() + 6) % 7;
          const daysInMonth = new Date(y, m + 1, 0).getDate();
          const cells: (Date | null)[] = [];
          for (let i = 0; i < startWeekday; i++) cells.push(null);
          for (let d = 1; d <= daysInMonth; d++) cells.push(new Date(y, m, d));
          while (cells.length % 7 !== 0) cells.push(null);
          return cells;
        }

        let selected = today0();

        function postCard(e: any) {
          const media = e.imageKey
            ? `<span class="media-tag">${STYLE_LABEL[e.imageStyle] ?? "Imagen"}</span>`
            : `<span class="media-tag none">Texto</span>`;
          const thumb = e.imageKey ? `<img class="card-thumb" src="/media/${e.imageKey}?w=160" alt="" loading="lazy" />` : "";
          return `<article class="post-card">
            ${thumb}
            <div class="card-body">
              <div class="card-head">
                <span class="net net-${e.platform}">${e.platform === "x" ? "𝕏" : "in"}</span>
                <span class="card-time mono">${e.time}</span>
                <span class="card-kind">${KIND_LABEL[e.kind] ?? e.kind}</span>
                ${media}
              </div>
              <p class="card-content">${escapeHtml(e.content)}</p>
            </div>
          </article>`;
        }

        function nextDateWithPosts(from: string) {
          return allDates.find((d) => d >= from) ?? null;
        }

        function renderDay() {
          const root = document.getElementById("cal-day")!;
          const selKey = keyOf(selected);
          let html = '<div class="day-strip">';
          for (let i = -3; i <= 3; i++) {
            const d = addDays(selected, i);
            const k = keyOf(d);
            const n = (eventsByDate[k] || []).length;
            html += `<button class="day-pill${k === selKey ? " is-selected" : ""}${k === keyOf(today0()) ? " is-today" : ""}" data-date="${k}">
              <span class="pill-dow">${DOW[(d.getDay() + 6) % 7]}</span>
              <span class="pill-num">${d.getDate()}</span>
              <span class="pill-count">${n > 0 ? n : ""}</span>
            </button>`;
          }
          html += "</div>";

          const dayEvents = eventsByDate[selKey] || [];
          if (dayEvents.length === 0) {
            const next = nextDateWithPosts(selKey);
            html += `<div class="empty-state">
              <p>Sin publicaciones este día.</p>
              ${next ? `<button class="link-btn" data-jump="${next}">Ir al siguiente día con publicaciones (${next})</button>` : ""}
            </div>`;
          } else {
            html += `<div class="card-list">${dayEvents.map(postCard).join("")}</div>`;
          }
          root.innerHTML = html;

          root.querySelectorAll<HTMLButtonElement>("[data-date]").forEach((btn) =>
            btn.addEventListener("click", () => { selected = parseKey(btn.dataset.date!); renderDay(); })
          );
          root.querySelectorAll<HTMLButtonElement>("[data-jump]").forEach((btn) =>
            btn.addEventListener("click", () => { selected = parseKey(btn.dataset.jump!); renderDay(); })
          );
        }

        function parseKey(k: string) {
          const [y, m, d] = k.split("-").map(Number);
          return new Date(y, m - 1, d);
        }

        function renderWeek() {
          const root = document.getElementById("cal-week")!;
          const weekStart = startOfWeek(selected);
          const weekEnd = addDays(weekStart, 6);
          let html = `<p class="view-title">${weekStart.getDate()} – ${weekEnd.getDate()} de ${monthName(weekEnd.getFullYear(), weekEnd.getMonth()).toLowerCase()}</p>`;
          html += '<div class="week-grid">';
          for (let w = 0; w < 7; w++) {
            const wd = addDays(weekStart, w);
            const k = keyOf(wd);
            const items = eventsByDate[k] || [];
            html += `<button class="week-cell${items.length ? " has-event" : ""}${k === keyOf(today0()) ? " is-today" : ""}" data-date="${k}">
              <span class="cell-dow">${DOW[w]}</span>
              <span class="cell-num">${wd.getDate()}</span>
              ${items.length ? `<span class="cell-badge">${items.length}</span>` : '<span class="cell-badge empty"></span>'}
            </button>`;
          }
          html += "</div>";
          const weekItems = Array.from({ length: 7 }, (_, w) => eventsByDate[keyOf(addDays(weekStart, w))] || []).flat();
          html += weekItems.length
            ? `<div class="card-list">${weekItems.map(postCard).join("")}</div>`
            : '<div class="empty-state"><p>Sin publicaciones esta semana.</p></div>';
          root.innerHTML = html;
          root.querySelectorAll<HTMLButtonElement>("[data-date]").forEach((btn) =>
            btn.addEventListener("click", () => { selected = parseKey(btn.dataset.date!); showView("day"); })
          );
        }

        function renderMonth() {
          const root = document.getElementById("cal-month")!;
          const y = selected.getFullYear(), m = selected.getMonth();
          let html = `<p class="view-title">${monthName(y, m)}</p><div class="month-grid">`;
          for (const dow of DOW) html += `<span class="month-dow">${dow}</span>`;
          for (const d of buildMonthCells(y, m)) {
            if (!d) { html += '<span class="month-cell is-blank"></span>'; continue; }
            const k = keyOf(d);
            const n = (eventsByDate[k] || []).length;
            html += `<button class="month-cell${n ? " has-event" : ""}${k === keyOf(today0()) ? " is-today" : ""}" data-date="${k}">
              <span class="mc-num">${d.getDate()}</span>
              ${n ? `<span class="mc-count">${n}</span>` : ""}
            </button>`;
          }
          html += "</div>";
          root.innerHTML = html;
          root.querySelectorAll<HTMLButtonElement>("[data-date]").forEach((btn) =>
            btn.addEventListener("click", () => { selected = parseKey(btn.dataset.date!); showView("day"); })
          );
        }

        function renderQuarter() {
          const root = document.getElementById("cal-quarter")!;
          const y0 = selected.getFullYear(), m0 = selected.getMonth();
          let html = '<div class="quarter-wrap">';
          for (let offset = 0; offset < 3; offset++) {
            let y = y0, m = m0 + offset;
            if (m > 11) { m -= 12; y += 1; }
            html += `<div class="quarter-month"><p class="view-title">${monthName(y, m)}</p><div class="quarter-grid">`;
            for (const dow of DOW) html += `<span class="quarter-dow">${dow}</span>`;
            for (const d of buildMonthCells(y, m)) {
              if (!d) { html += '<span class="quarter-cell is-blank"></span>'; continue; }
              const n = (eventsByDate[keyOf(d)] || []).length;
              const heat = n === 0 ? "" : n === 1 ? " heat-1" : n < 4 ? " heat-2" : " heat-3";
              html += `<span class="quarter-cell${heat}" title="${keyOf(d)}: ${n}"></span>`;
            }
            html += "</div></div>";
          }
          html += "</div>";
          root.innerHTML = html;
        }

        function showView(view: string) {
          document.querySelectorAll<HTMLElement>(".cal-view").forEach((el) => (el.hidden = true));
          document.querySelectorAll<HTMLButtonElement>(".seg-btn").forEach((b) => b.classList.toggle("is-active", b.dataset.view === view));
          document.getElementById(`cal-${view}`)!.hidden = false;
          if (view === "day") renderDay();
          if (view === "week") renderWeek();
          if (view === "month") renderMonth();
          if (view === "quarter") renderQuarter();
        }

        document.querySelectorAll<HTMLButtonElement>(".seg-btn[data-view]").forEach((btn) =>
          btn.addEventListener("click", () => showView(btn.dataset.view!))
        );
        document.getElementById("today-btn")?.addEventListener("click", () => {
          selected = today0();
          const active = document.querySelector<HTMLButtonElement>(".seg-btn.is-active[data-view]")?.dataset.view || "agenda";
          showView(active);
        });
      </script>
    </AdminLayout>
  )
}

<style>
  /* Native-macOS-leaning: SF/system type, hairline borders, 6-8px radii, dense rows.
     IMPORTANT: every selector for markup built by the client script below is wrapped in
     :global(). Astro scopes styles by appending [data-astro-cid-*] to selectors AND to
     elements in this template -- elements created via innerHTML never get that attribute,
     so plain scoped selectors silently match nothing. That's what left the day/week/month
     views completely unstyled. Server-rendered markup (agenda table, toolbar) stays scoped. */
  .cal-page {
    max-width: 100%;
    font-feature-settings: "tnum" 1;
  }
  .cal-header { margin-bottom: 1.1rem; }
  .cal-page h1 { font-size: 1.5rem; letter-spacing: -0.02em; margin: 0 0 0.5rem; }
  .stat-strip { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.78rem; color: var(--admin-text-soft); }
  .stat-strip b { color: var(--admin-text); font-variant-numeric: tabular-nums; }

  .backlog-banner {
    font-size: 0.8rem; margin: 0 0 1rem; padding: 0.55rem 0.8rem; border-radius: 7px;
    background: color-mix(in srgb, var(--rhino) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--rhino) 28%, transparent);
  }
  .backlog-banner b { color: var(--rhino); }

  .toolbar { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.1rem; flex-wrap: wrap; }
  .segmented {
    display: inline-flex; gap: 2px; padding: 2px; border-radius: 8px;
    background: var(--admin-surface-2); border: 1px solid var(--admin-border);
  }
  .seg-btn {
    border: 0; background: transparent; color: var(--admin-text-soft); cursor: pointer;
    font-size: 0.78rem; padding: 0.34rem 0.8rem; border-radius: 6px; transition: background 0.12s, color 0.12s;
  }
  .seg-btn:hover { color: var(--admin-text); }
  .seg-btn.is-active {
    background: var(--admin-bg); color: var(--admin-text); font-weight: 600;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.09);
  }
  .ghost-btn {
    border: 1px solid var(--admin-border); background: var(--admin-bg); color: var(--admin-text);
    font-size: 0.78rem; padding: 0.36rem 0.8rem; border-radius: 7px; cursor: pointer;
  }
  .ghost-btn:hover { background: var(--admin-surface-2); }

  /* ---------- Agenda table (server-rendered, so plain scoped selectors are fine) ---------- */
  .agenda-table { width: 100%; border-collapse: collapse; font-size: 0.83rem; }
  .agenda-table thead th {
    text-align: left; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--admin-text-soft); font-weight: 600; padding: 0 0.6rem 0.45rem;
    border-bottom: 1px solid var(--admin-border);
  }
  .group-row th {
    text-align: left; font-size: 0.74rem; font-weight: 600; color: var(--admin-text);
    padding: 1rem 0.6rem 0.4rem; text-transform: capitalize;
  }
  .group-count {
    font-size: 0.66rem; color: var(--admin-text-soft); background: var(--admin-surface-2);
    border-radius: 999px; padding: 0.05rem 0.4rem; margin-left: 0.3rem; font-weight: 500;
  }
  .post-row { border-top: 1px solid var(--admin-border); }
  .post-row:hover { background: var(--admin-surface); }
  .post-row td { padding: 0.6rem; vertical-align: top; }
  .mono { font-variant-numeric: tabular-nums; }
  .c-time { width: 3.6rem; color: var(--admin-text-soft); white-space: nowrap; }
  .c-net { width: 2.6rem; }
  .c-kind { width: 7rem; color: var(--admin-text-soft); white-space: nowrap; }
  .c-media { width: 7.5rem; }
  .c-content { line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
  .media-cell { display: flex; align-items: center; gap: 0.4rem; }
  .thumb { width: 2.2rem; height: 2.2rem; border-radius: 5px; object-fit: cover; background: var(--admin-surface-2); flex-shrink: 0; }

  @media (max-width: 760px) {
    .agenda-table thead { display: none; }
    .agenda-table .c-kind, .agenda-table .c-media { display: none; }
    .c-content { font-size: 0.82rem; }
  }

  /* ---------- Shared bits used by BOTH server and client markup ---------- */
  .net, .cal-view :global(.net) {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.35rem; height: 1.35rem; border-radius: 5px; color: #fff; font-size: 0.68rem; font-weight: 700;
  }
  .net-x, .cal-view :global(.net-x) { background: #000; }
  .net-linkedin, .cal-view :global(.net-linkedin) { background: #0a66c2; }
  .media-tag, .cal-view :global(.media-tag) {
    font-size: 0.64rem; padding: 0.1rem 0.4rem; border-radius: 4px; white-space: nowrap;
    background: color-mix(in srgb, var(--rhino) 12%, transparent); color: var(--rhino);
  }
  .media-tag.none, .cal-view :global(.media-tag.none) { background: var(--admin-surface-2); color: var(--admin-text-soft); }
  .empty-state, .cal-view :global(.empty-state) {
    border: 1px dashed var(--admin-border); border-radius: 8px; padding: 1.5rem;
    text-align: center; color: var(--admin-text-soft); font-size: 0.85rem;
  }
  .cal-view :global(.empty-state p) { margin: 0 0 0.5rem; }
  .cal-view :global(.link-btn) {
    border: 0; background: none; color: var(--rhino); font-size: 0.8rem; cursor: pointer; text-decoration: underline;
  }
  .cal-view :global(.view-title) {
    font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--admin-text-soft); margin: 0 0 0.6rem; font-weight: 600;
  }

  /* ---------- Day view (client-rendered) ---------- */
  .cal-view :global(.day-strip) { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.4rem; margin-bottom: 1rem; }
  .cal-view :global(.day-pill) {
    min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 0.15rem;
    border: 1px solid var(--admin-border); border-radius: 8px; padding: 0.5rem 0.2rem;
    background: var(--admin-bg); color: var(--admin-text); cursor: pointer; transition: background 0.12s;
  }
  .cal-view :global(.day-pill:hover) { background: var(--admin-surface-2); }
  .cal-view :global(.day-pill.is-selected) { background: var(--rhino); border-color: var(--rhino); color: #fff; }
  .cal-view :global(.day-pill.is-today:not(.is-selected)) { border-color: var(--rhino); }
  .cal-view :global(.pill-dow) { font-size: 0.6rem; opacity: 0.75; text-transform: uppercase; }
  .cal-view :global(.pill-num) { font-size: 1.05rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cal-view :global(.pill-count) { font-size: 0.6rem; min-height: 0.9em; font-variant-numeric: tabular-nums; }

