---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";

export const prerender = false;

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

const STYLE_LABEL: Record<string, string> = {
  infographic: "Infografía",
  illustration: "Ilustración",
  photorealistic: "Foto (IA)",
  real_photo: "Foto",
};

let events: {
  id: number; date: string; time: string; platform: string; kind: string; content: string;
  imageKey: string | null; imageStyle: string | null;
}[] = [];
let unscheduledCount = 0;

if (authorized && env?.DB) {
  const [res, backlogRes] = await Promise.all([
    env.DB.prepare(
      `SELECT id, scheduled_for, platform, kind, content, image_r2_key, image_style
       FROM brand_posts
       WHERE status = 'approved' AND scheduled_for > datetime('now')
       ORDER BY scheduled_for ASC
       LIMIT 200`
    ).all(),
    env.DB.prepare(
      `SELECT COUNT(*) AS n FROM brand_posts WHERE status = 'approved' AND scheduled_for IS NULL`
    ).first<{ n: number }>(),
  ]);
  events = (res.results ?? []).map((r: any) => {
    const [date, time] = String(r.scheduled_for).split(" ");
    return {
      id: r.id, date, time: (time ?? "00:00:00").slice(0, 5), platform: r.platform, kind: r.kind, content: r.content ?? "",
      imageKey: r.image_r2_key ?? null, imageStyle: r.image_style ?? null,
    };
  });
  unscheduledCount = backlogRes?.n ?? 0;
}

const eventsByDate: Record<string, typeof events> = {};
for (const e of events) {
  (eventsByDate[e.date] ??= []).push(e);
}
---

{
  !authorized ? (
    <AdminLogin />
  ) : (
    <AdminLayout title="Calendario — Admin" active="/admin/calendario">
      <div class="cal-page">
        <h1>Calendario de publicaciones</h1>

        {unscheduledCount > 0 && (
          <a href="/admin/contenido" class="backlog-banner">
            <strong>{unscheduledCount}</strong> posts aprobados sin fecha asignada — no aparecen aquí hasta que se les programe un día.
          </a>
        )}

        <div class="segmented">
          <button class="seg-btn is-active" data-view="day">Día</button>
          <button class="seg-btn" data-view="week">Semana</button>
          <button class="seg-btn" data-view="month">Mes</button>
          <button class="seg-btn" data-view="quarter">Trimestre</button>
          <button id="today-btn" class="seg-btn today-btn" title="Ir a hoy">Hoy</button>
        </div>

        <div id="cal-day" class="cal-view"></div>
        <div id="cal-week" class="cal-view" hidden></div>
        <div id="cal-month" class="cal-view" hidden></div>
        <div id="cal-quarter" class="cal-view" hidden></div>
      </div>

      <script type="application/json" id="cal-events" set:html={JSON.stringify(eventsByDate).replace(/</g, "\\u003c")} />

      <script>
        const DOW = ["L", "M", "X", "J", "V", "S", "D"];
        const eventsByDate = JSON.parse(document.getElementById("cal-events")?.textContent || "{}");
        const KIND_LABEL: Record<string, string> = {
          news_reshare: "Reacción a noticia",
          idea: "Idea propia",
          news_reaction: "Reacción a noticia",
          investigacion_highlight: "Destacado de investigación",
        };
        const STYLE_LABEL: Record<string, string> = {
          infographic: "Infografía",
          illustration: "Ilustración",
          photorealistic: "Foto (IA)",
          real_photo: "Foto",
        };

        function pad(n: number) {
          return n < 10 ? "0" + n : "" + n;
        }
        function keyOf(d: Date) {
          return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
        }
        function addDays(d: Date, n: number) {
          const r = new Date(d);
          r.setDate(r.getDate() + n);
          return r;
        }
        function startOfWeek(d: Date) {
          const dow = (d.getDay() + 6) % 7;
          return addDays(d, -dow);
        }
        function monthName(y: number, m: number) {
          const names = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
          return names[m] + " " + y;
        }
        function buildMonthCells(y: number, m: number) {
          const first = new Date(y, m, 1);
          const startWeekday = (first.getDay() + 6) % 7;
          const daysInMonth = new Date(y, m + 1, 0).getDate();
          const cells: (Date | null)[] = [];
          for (let i = 0; i < startWeekday; i++) cells.push(null);
          for (let d = 1; d <= daysInMonth; d++) cells.push(new Date(y, m, d));
          while (cells.length % 7 !== 0) cells.push(null);
          return cells;
        }

        let selected = new Date();
        selected.setHours(0, 0, 0, 0);

        function renderDay() {
          const root = document.getElementById("cal-day")!;
          let stripHtml = '<div class="day-strip">';
          for (let i = -3; i <= 3; i++) {
            const d = addDays(selected, i);
            const k = keyOf(d);
            const isSel = k === keyOf(selected);
            const has = !!eventsByDate[k]?.length;
            stripHtml += `<button class="day-pill${isSel ? " is-selected" : ""}" data-date="${k}">
              <span class="dow">${DOW[(d.getDay() + 6) % 7]}</span>
              <span class="num">${d.getDate()}</span>
              <span class="dot${has ? " has-event" : ""}"></span>
            </button>`;
          }
          stripHtml += "</div>";

          const dayEvents = eventsByDate[keyOf(selected)] || [];
          let listHtml = "";
          if (dayEvents.length === 0) {
            listHtml = '<div class="empty-day">Sin publicaciones programadas este día.</div>';
          } else {
            for (const e of dayEvents) {
              const mediaBadge = e.imageKey
                ? `<span class="media-badge has-media">🖼️ ${STYLE_LABEL[e.imageStyle] ?? "Imagen"}</span>`
                : `<span class="media-badge no-media">Solo texto</span>`;
              const thumb = e.imageKey ? `<img class="event-thumb" src="/media/${e.imageKey}?w=160" alt="" loading="lazy" />` : "";
              listHtml += `<div class="event-card">
                ${thumb}
                <div class="event-body">
                  <div class="event-head">
                    <span class="platform-badge platform-${e.platform}">${e.platform === "x" ? "𝕏" : "in"}</span>
                    <span class="event-time">${e.time}</span>
                    <span class="event-kind">${KIND_LABEL[e.kind] ?? e.kind}</span>
                    ${mediaBadge}
                  </div>
                  <div class="event-content">${escapeHtml(e.content)}</div>
                </div>
              </div>`;
            }
          }
          root.innerHTML = stripHtml + listHtml;
          root.querySelectorAll<HTMLButtonElement>("[data-date]").forEach((btn) => {
            btn.addEventListener("click", () => {
              const [y, m, d] = btn.dataset.date!.split("-").map(Number);
              selected = new Date(y, m - 1, d);
              renderDay();
            });
          });
        }

        function renderWeek() {
          const root = document.getElementById("cal-week")!;
          const weekStart = startOfWeek(selected);
          let html = "";
          const weekEnd = addDays(weekStart, 6);
          html += `<p class="month-title">${weekStart.getDate()} – ${weekEnd.getDate()} de ${monthName(weekEnd.getFullYear(), weekEnd.getMonth()).toLowerCase()}</p>`;
          html += '<div class="week-grid">';
          for (let w = 0; w < 7; w++) {
            const wd = addDays(weekStart, w);
            const k = keyOf(wd);
            const count = (eventsByDate[k] || []).length;
            const isToday = k === keyOf(new Date(new Date().setHours(0, 0, 0, 0)));
            html += `<button class="week-cell${count ? " has-event" : ""}${isToday ? " is-today" : ""}" data-date="${k}" title="${count} publicación(es)">
              <div class="dow">${DOW[w]}</div>
              <div class="num">${wd.getDate()}</div>
              <div class="count">${count > 0 ? `<span class="count-badge">${count}</span>` : ""}</div>
            </button>`;
          }
          html += "</div>";
          root.innerHTML = html;
          root.querySelectorAll<HTMLButtonElement>("[data-date]").forEach((btn) => {
            btn.addEventListener("click", () => {
              const [y, m, d] = btn.dataset.date!.split("-").map(Number);
              selected = new Date(y, m - 1, d);
              showView("day");
            });
          });
        }

        function renderMonth() {
          const root = document.getElementById("cal-month")!;
          const y = selected.getFullYear(), m = selected.getMonth();
          let html = `<p class="month-title">${monthName(y, m)}</p><div class="month-grid">`;
          for (const dow of DOW) html += `<div class="month-dow">${dow}</div>`;
          for (const d of buildMonthCells(y, m)) {
            if (!d) {
              html += '<div class="month-cell is-blank"></div>';
              continue;
            }
            const k = keyOf(d);
            const has = !!eventsByDate[k]?.length;
            html += `<button class="month-cell${has ? " has-event" : ""}" data-date="${k}">${d.getDate()}<span class="month-dot${has ? " has-event" : ""}"></span></button>`;
          }
          html += "</div>";
          root.innerHTML = html;
          root.querySelectorAll<HTMLButtonElement>("[data-date]").forEach((btn) => {
            btn.addEventListener("click", () => {
              const [yy, mm, dd] = btn.dataset.date!.split("-").map(Number);
              selected = new Date(yy, mm - 1, dd);
              showView("day");
            });
          });
        }

        function renderQuarter() {
          const root = document.getElementById("cal-quarter")!;
          const y0 = selected.getFullYear(), m0 = selected.getMonth();
          let html = "";
          for (let offset = 0; offset < 3; offset++) {
            let y = y0, m = m0 + offset;
            if (m > 11) { m -= 12; y += 1; }
            html += `<div class="quarter-month"><p class="month-title">${monthName(y, m)}</p><div class="quarter-grid">`;
            for (const d of buildMonthCells(y, m)) {
              if (!d) {
                html += '<div class="quarter-cell is-blank"></div>';
                continue;
              }
              const n = (eventsByDate[keyOf(d)] || []).length;
              const heat = n === 0 ? "" : n === 1 ? " heat-2" : " heat-3";
              html += `<div class="quarter-cell${heat}"></div>`;
            }
            html += "</div></div>";
          }
          root.innerHTML = html;
        }

        function escapeHtml(s: string) {
          return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        function showView(view: string) {
          document.querySelectorAll<HTMLElement>(".cal-view").forEach((el) => (el.hidden = true));
          document.querySelectorAll<HTMLButtonElement>(".seg-btn").forEach((b) => b.classList.toggle("is-active", b.dataset.view === view));
          document.getElementById(`cal-${view}`)!.hidden = false;
          if (view === "day") renderDay();
          if (view === "week") renderWeek();
          if (view === "month") renderMonth();
          if (view === "quarter") renderQuarter();
        }

        document.querySelectorAll<HTMLButtonElement>(".seg-btn[data-view]").forEach((btn) => {
          btn.addEventListener("click", () => showView(btn.dataset.view!));
        });

        document.getElementById("today-btn")?.addEventListener("click", () => {
          selected = new Date();
          selected.setHours(0, 0, 0, 0);
          const activeView = document.querySelector<HTMLButtonElement>(".seg-btn.is-active[data-view]")?.dataset.view || "day";
          showView(activeView);
        });

        renderDay();
      </script>
    </AdminLayout>
  )
}

<style>
  .cal-page { max-width: 30rem; }
  @media (min-width: 640px) { .cal-page { max-width: 42rem; } }
  @media (min-width: 1024px) { .cal-page { max-width: 56rem; } }
  .cal-page h1 { font-size: 1.4rem; margin: 0 0 1rem; }
  .backlog-banner {
    display: block; font-size: 0.78rem; line-height: 1.4; color: var(--admin-text);
    background: color-mix(in srgb, var(--rhino) 10%, transparent); border: 1px solid color-mix(in srgb, var(--rhino) 35%, transparent);
    border-radius: 0.7rem; padding: 0.7rem 0.9rem; margin-bottom: 1rem; text-decoration: none;
  }
  .backlog-banner strong { color: var(--rhino); }
  .segmented { display: flex; gap: 0.4rem; margin-bottom: 1.25rem; }
  .seg-btn {
    flex: 1; border: 1px solid var(--admin-border); background: transparent; color: var(--admin-text-soft);
    font-family: monospace; font-size: 0.72rem; padding: 0.5rem 0; border-radius: 999px; cursor: pointer;
  }
  .seg-btn.is-active { background: var(--rhino); border-color: var(--rhino); color: #fff; font-weight: 600; }
  .today-btn { flex: 0 0 3.2rem; }

  .day-strip { display: flex; gap: 0.4rem; margin-bottom: 1rem; }
  .day-pill {
    min-width: 0; flex: 1; border: 1px solid var(--admin-border); border-radius: 0.6rem; padding: 0.5rem 0.1rem;
    text-align: center; background: var(--admin-surface); color: var(--admin-text); cursor: pointer;
  }
  .day-pill.is-selected { background: var(--rhino); border-color: var(--rhino); color: #fff; }
  .day-pill .dow { display: block; font-family: monospace; font-size: 0.58rem; opacity: 0.8; }
  .day-pill .num { display: block; font-weight: 700; font-size: 1.05rem; margin-top: 0.15rem; }
  .day-pill .dot { display: block; width: 4px; height: 4px; border-radius: 999px; background: currentColor; margin: 0.25rem auto 0; opacity: 0; }
  .day-pill .dot.has-event { opacity: 1; }
  @media (min-width: 640px) {
    .day-pill { padding: 0.9rem 0.2rem; }
    .day-pill .num { font-size: 1.3rem; }
  }

  .event-card { border: 1px solid var(--admin-border); border-radius: 0.8rem; padding: 0.9rem; background: var(--admin-surface); margin-bottom: 0.7rem; display: flex; gap: 0.8rem; align-items: flex-start; }
  @media (min-width: 640px) { .event-card { padding: 1.1rem 1.2rem; } }
  .event-thumb { width: 4.5rem; height: 4.5rem; border-radius: 0.6rem; object-fit: cover; flex-shrink: 0; background: var(--admin-surface-2); }
  .event-body { min-width: 0; flex: 1; }
  .event-head { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
  .platform-badge {
    font-weight: 800; font-size: 0.72rem; width: 1.4rem; height: 1.4rem; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center; color: #fff;
  }
  .platform-x { background: #000; }
  .platform-linkedin { background: #0a66c2; }
  .event-time { font-family: monospace; font-size: 0.75rem; color: var(--rhino); font-weight: 700; }
  .event-kind { font-size: 0.72rem; color: var(--admin-text-soft); }
  .media-badge {
    font-size: 0.62rem; font-family: monospace; padding: 0.1rem 0.45rem; border-radius: 999px; margin-left: auto;
  }
  .media-badge.has-media { background: color-mix(in srgb, var(--rhino) 15%, transparent); color: var(--rhino); }
  .media-badge.no-media { background: var(--admin-surface-2); color: var(--admin-text-soft); }
  .event-content { font-size: 0.85rem; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
  @media (min-width: 640px) { .event-content { font-size: 0.92rem; } .event-thumb { width: 5.5rem; height: 5.5rem; } }
  .empty-day { border: 1px dashed var(--admin-border); border-radius: 0.7rem; padding: 1.1rem; text-align: center; color: var(--admin-text-soft); font-size: 0.85rem; }

  .month-title { font-family: monospace; font-size: 0.72rem; color: var(--admin-text-soft); margin: 0 0 0.6rem; text-transform: uppercase; letter-spacing: 0.04em; }

  /* min-width: 0 is load-bearing here -- without it, a grid item's default min-width:auto
     lets its content (e.g. the count badge) force that one column wider than its 1fr share,
     breaking the uniform 7-column grid. */
  .week-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.5rem; }
  .week-cell {
    min-width: 0; border: 1px solid var(--admin-border); border-radius: 0.7rem; padding: 0.7rem 0.3rem;
    text-align: center; background: var(--admin-surface); cursor: pointer; display: flex; flex-direction: column;
    align-items: center; gap: 0.3rem; min-height: 5.5rem;
  }
  .week-cell.has-event { border-color: var(--rhino); border-width: 1.5px; }
  .week-cell.is-today .num { color: var(--rhino); }
  .week-cell .dow { font-family: monospace; font-size: 0.6rem; color: var(--admin-text-soft); }
  .week-cell .num { font-weight: 700; font-size: 1.15rem; }
  .week-cell .count { min-height: 1.2rem; display: flex; align-items: center; justify-content: center; }
  .count-badge {
    font-family: monospace; font-size: 0.62rem; font-weight: 700; color: #fff; background: var(--rhino);
    border-radius: 999px; padding: 0.1rem 0.45rem; white-space: nowrap;
  }

  @media (min-width: 640px) {
    .week-grid { gap: 0.7rem; }
    .week-cell { min-height: 7rem; padding: 0.9rem 0.4rem; }
    .week-cell .num { font-size: 1.4rem; }
  }

  .month-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.3rem; }
  .month-dow { text-align: center; font-family: monospace; font-size: 0.56rem; color: var(--admin-text-soft); padding-bottom: 0.3rem; }
  .month-cell {
    min-width: 0; aspect-ratio: 1; border-radius: 0.5rem; display: flex; flex-direction: column; align-items: center;
    justify-content: center; font-size: 0.8rem; background: var(--admin-surface); border: 1px solid transparent;
    cursor: pointer; color: var(--admin-text);
  }
  .month-cell.is-blank { background: transparent; cursor: default; }
  .month-cell.has-event { border-color: var(--rhino); border-width: 1.5px; font-weight: 700; }
  .month-dot { width: 4px; height: 4px; border-radius: 999px; background: var(--rhino); margin-top: 0.2rem; opacity: 0; }
  .month-dot.has-event { opacity: 1; }
  @media (min-width: 640px) { .month-cell { font-size: 1rem; border-radius: 0.7rem; } }

  .quarter-month { margin-bottom: 1.25rem; }
  .quarter-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.25rem; }
  .quarter-cell { min-width: 0; aspect-ratio: 1; border-radius: 3px; background: var(--admin-surface-2); }
  .quarter-cell.is-blank { background: transparent; }
  .quarter-cell.heat-2 { background: color-mix(in oklch, var(--rhino) 45%, var(--admin-surface-2)); }
  .quarter-cell.heat-3 { background: var(--rhino); }
  @media (min-width: 1024px) { .quarter-grid { gap: 0.4rem; } }
</style>
