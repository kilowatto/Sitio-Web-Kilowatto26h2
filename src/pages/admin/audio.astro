---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";
import {
  getDownloadTotals,
  getDownloadsByClient,
  getDownloadsByEpisode,
  getDownloadsByCountry,
} from "../../lib/podcast-downloads";
import { lastPodcastMonitor } from "../../lib/podcast-monitor";
import { allReports } from "../../lib/experiments";
import {
  getAudioTotals,
  getAudioByPiece,
  getDropOffCurve,
  getAudioEventBreakdown,
  getSecondsListened,
} from "../../lib/audio-telemetry";

export const prerender = false;

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

const DAYS = 30;

let experiments: Awaited<ReturnType<typeof allReports>> = [];
if (authorized) experiments = await allReports().catch(() => []);

let totals: Awaited<ReturnType<typeof getAudioTotals>> = null;
let byPiece: Awaited<ReturnType<typeof getAudioByPiece>> = null;
let dropOff: Awaited<ReturnType<typeof getDropOffCurve>> = null;
let events: Awaited<ReturnType<typeof getAudioEventBreakdown>> = null;
let secondsListened: number | null = null;
let catalog: any[] = [];
let dlTotals: Awaited<ReturnType<typeof getDownloadTotals>> = null;
let dlClients: Awaited<ReturnType<typeof getDownloadsByClient>> = null;
let dlEpisodes: Awaited<ReturnType<typeof getDownloadsByEpisode>> = null;
let dlCountries: Awaited<ReturnType<typeof getDownloadsByCountry>> = null;
let monitor: Awaited<ReturnType<typeof lastPodcastMonitor>> = null;

if (authorized) {
  [totals, byPiece, dropOff, events, secondsListened, catalog, dlTotals, dlClients, dlEpisodes, dlCountries] = await Promise.all([
    getAudioTotals(DAYS),
    getAudioByPiece(DAYS),
    getDropOffCurve(DAYS),
    getAudioEventBreakdown(DAYS),
    getSecondsListened(DAYS),
    env.DB.prepare(
      `SELECT ma.entity_type, ma.entity_id, ma.duration_s, ma.cue_map_json,
              COALESCE(c.title, i.title) AS title,
              COALESCE(c.slug, i.slug) AS slug
         FROM media_assets ma
         LEFT JOIN columns c         ON ma.entity_type = 'columna'       AND c.id = ma.entity_id
         LEFT JOIN investigaciones i ON ma.entity_type = 'investigacion' AND i.id = ma.entity_id
        WHERE ma.kind = 'audio_narration' AND ma.status = 'ready'
        ORDER BY ma.entity_type, ma.entity_id`
    ).all().then((r) => r.results ?? []),
    getDownloadTotals(DAYS),
    getDownloadsByClient(DAYS),
    getDownloadsByEpisode(DAYS),
    getDownloadsByCountry(DAYS),
  ]);
  monitor = await lastPodcastMonitor();

}

// Title lookup so the per-piece table shows names instead of "columna:22".
const titleOf = new Map<string, { title: string; slug: string; type: string }>();
for (const c of catalog) {
  titleOf.set(`${c.entity_type}:${c.entity_id}`, {
    title: c.title ?? `#${c.entity_id}`,
    slug: c.slug ?? "",
    type: c.entity_type,
  });
}

const totalSeconds = catalog.reduce((s: number, c: any) => s + (c.duration_s ?? 0), 0);

// One decimal below 10 hours, whole hours above: "1.4 h" is useful, "127.3 h" is noise.
function fmtHours(seconds: number): string {
  const h = seconds / 3600;
  if (h === 0) return "0";
  if (h < 1) return `${Math.round(seconds / 60)} min`;
  return h < 10 ? `${h.toFixed(1)} h` : `${Math.round(h)} h`;
}
const withCues = catalog.filter((c: any) => c.cue_map_json).length;

const maxDlClient = dlClients && dlClients.length ? Math.max(...dlClients.map((c) => c.downloads), 1) : 1;
const maxDlCountry = dlCountries && dlCountries.length ? Math.max(...dlCountries.map((c) => c.downloads), 1) : 1;
const REGION = new Intl.DisplayNames(["es"], { type: "region" });
function countryName(code: string): string {
  try { return REGION.of(code) ?? code; } catch { return code; }
}

const maxDrop = dropOff ? Math.max(...dropOff.map((d) => d.reached), 1) : 1;
const maxPlays = byPiece && byPiece.length ? Math.max(...byPiece.map((p) => p.plays), 1) : 1;

function urlFor(key: string): string {
  const t = titleOf.get(key);
  if (!t?.slug) return "#";
  return t.type === "columna" ? `/columnas/${t.slug}` : `/a-fondo/${t.slug}`;
}
---

{
  !authorized ? (
    <AdminLogin />
  ) : (
    <AdminLayout title="Audio — Admin" active="/admin/audio">
      <div class="au">
        <h1>Audio narrado</h1>
        <p class="lead">Escuchas reales de las últimas {DAYS} días, más el estado del catálogo.</p>

        <section class="kpis">
          <div class="kpi"><div class="v">{catalog.length}</div><div class="l">Piezas narradas</div></div>
          <div class="kpi"><div class="v">{fmtHours(totalSeconds)}</div><div class="l">Horas de catálogo</div></div>
          <div class="kpi"><div class="v">{secondsListened === null ? "—" : fmtHours(secondsListened)}</div><div class="l">Horas escuchadas</div></div>
          <div class="kpi"><div class="v">{totals ? totals.plays.toLocaleString("es-MX") : "—"}</div><div class="l">Reproducciones</div></div>
          <div class="kpi"><div class="v">{totals ? totals.completions.toLocaleString("es-MX") : "—"}</div><div class="l">Completadas</div></div>
          <div class="kpi"><div class="v">{totals ? totals.completionRate + "%" : "—"}</div><div class="l">Tasa de término</div></div>
          <div class="kpi"><div class="v">{withCues}/{catalog.length}</div><div class="l">Con sincronía</div></div>
        </section>

        <p class="caveat">
          "Horas escuchadas" suma la posición más avanzada de cada sesión, no la suma de sus
          eventos. Solo cuenta escuchas posteriores al 22 de agosto de 2026, que es cuando
          empezamos a identificar sesiones.
        </p>

        <section class="card">
          <h2>¿Hasta dónde llegan?</h2>
          <p class="note">
            Cada barra es un décimo de la pieza. Una caída fuerte entre dos barras marca el punto
            donde la gente abandona.
          </p>
          {!dropOff || dropOff.every((d) => d.reached === 0) ? (
            <p class="empty">Aún no hay escuchas registradas.</p>
          ) : (
            <div class="drop">
              {dropOff.map((d) => (
                <div class="drop-col" title={`${d.decile * 10}–${d.decile * 10 + 10}%: ${d.reached} eventos`}>
                  <div class="drop-bar" style={`height:${Math.max(3, Math.round((d.reached / maxDrop) * 100))}%`} />
                  <span class="drop-lbl">{d.decile * 10}%</span>
                </div>
              ))}
            </div>
          )}
        </section>

        <section class="card">
          <h2>Por pieza</h2>
          {!byPiece || byPiece.length === 0 ? (
            <p class="empty">Aún no hay escuchas registradas.</p>
          ) : (
            <table class="tbl">
              <thead>
                <tr><th>Pieza</th><th>Formato</th><th class="n">Plays</th><th class="n">Terminadas</th><th>Tasa</th></tr>
              </thead>
              <tbody>
                {byPiece.map((p) => {
                  const key = `${p.entityType}:${p.entityId}`;
                  const meta = titleOf.get(key);
                  return (
                    <tr>
                      <td><a href={urlFor(key)}>{meta?.title ?? key}</a></td>
                      <td class="dim">{p.kind === "audio_dialogue" ? "conversación" : "narración"}</td>
                      <td class="n mono">{p.plays}</td>
                      <td class="n mono">{p.completions}</td>
                      <td>
                        <div class="rate">
                          <div class="rate-track"><div class="rate-fill" style={`width:${p.completionRate}%`} /></div>
                          <span class="mono">{p.completionRate}%</span>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </section>

        <section class="card">
          <h2>Interacciones</h2>
          {!events || events.length === 0 ? (
            <p class="empty">Aún no hay eventos.</p>
          ) : (
            <ul class="ev">
              {events.map((e) => (
                <li><span>{e.event}</span><b class="mono">{e.count.toLocaleString("es-MX")}</b></li>
              ))}
            </ul>
          )}
        </section>

        <section class="card">
          <h2>Salud del podcast</h2>
          <p class="note">
            Se revisa solo cada seis horas. Comprueba lo que un validador de feeds no comprueba:
            que cada URL de transcripción <em>resuelva</em>, no solo que el tag exista. Así se
            encontraron las 26 rotas del feed en inglés, que tenían certificación PSP-1.
          </p>
          {!monitor ? (
            <p class="empty">Todavía no ha corrido. La primera pasada es a los pocos minutos de la hora en punto.</p>
          ) : (
            <>
              <p class={monitor.ok ? "mon-ok" : "mon-bad"}>
                {monitor.ok ? "Todo bien" : "Hay fallas"} · última revisión {new Date(monitor.at).toLocaleString("es-MX")}
              </p>
              {monitor.feeds.map((f) => (
                <div class="mon">
                  <h3>{f.locale}</h3>
                  <ul class="mon-list">
                    {f.checks.map((c) => (
                      <li class={c.ok ? "is-ok" : c.warn ? "is-warn" : "is-bad"}>
                        <span class="mon-dot" />
                        <span class="mon-name">{c.name}</span>
                        <span class="mon-detail">{c.detail}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </>
          )}
        </section>

        <section class="card">
          <h2>Descargas del podcast</h2>
          <p class="note">
            Contadas en nuestro propio servidor, no reportadas por Spotify ni Apple: ninguna de
            las dos expone esas cifras por API. Como el audio lo servimos nosotros, cada
            reproducción desde cualquier app pasa por aquí — incluidas apps donde nunca nos dimos
            de alta. Una descarga es un oyente que se llevó al menos un minuto de audio de una
            pieza en un día, que es la regla de la IAB; sin eso, las decenas de peticiones
            parciales de una sola escucha se contarían como decenas de descargas.
          </p>
          {!dlTotals || dlTotals.downloads === 0 ? (
            <p class="empty">Aún no hay descargas registradas.</p>
          ) : (
            <>
              <section class="kpis kpis--3">
                <div class="kpi"><div class="v">{dlTotals.downloads.toLocaleString("es-MX")}</div><div class="l">Descargas</div></div>
                <div class="kpi"><div class="v">{dlTotals.gigabytes} GB</div><div class="l">Transferidos</div></div>
                <div class="kpi"><div class="v">{dlTotals.requests.toLocaleString("es-MX")}</div><div class="l">Peticiones crudas</div></div>
              </section>

              <div class="split">
                <div>
                  <h3>Por app</h3>
                  {!dlClients || dlClients.length === 0 ? <p class="empty">—</p> : (
                    <ul class="bars">
                      {dlClients.map((c) => (
                        <li>
                          <span class="bars__k">{c.client}</span>
                          <span class="bars__track"><span class="bars__fill" style={`width:${Math.round((c.downloads / maxDlClient) * 100)}%`} /></span>
                          <b class="mono">{c.downloads}</b>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <div>
                  <h3>Por país</h3>
                  {!dlCountries || dlCountries.length === 0 ? <p class="empty">—</p> : (
                    <ul class="bars">
                      {dlCountries.map((c) => (
                        <li>
                          <span class="bars__k">{countryName(c.country)}</span>
                          <span class="bars__track"><span class="bars__fill" style={`width:${Math.round((c.downloads / maxDlCountry) * 100)}%`} /></span>
                          <b class="mono">{c.downloads}</b>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>

              {dlEpisodes && dlEpisodes.length > 0 && (
                <table class="tbl" style="margin-top:1rem">
                  <thead><tr><th>Episodio</th><th>Formato</th><th>Idioma</th><th class="n">Descargas</th></tr></thead>
                  <tbody>
                    {dlEpisodes.map((e) => {
                      const meta = titleOf.get(`${e.entityType}:${e.entityId}`);
                      return (
                        <tr>
                          <td>{meta?.title ?? `${e.entityType} ${e.entityId}`}</td>
                          <td class="dim">{e.kind === "audio_dialogue" ? "conversación" : "narración"}</td>
                          <td class="dim">{e.locale}</td>
                          <td class="n mono">{e.downloads}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              )}
            </>
          )}
        </section>

        <section class="card">
          <h2>Qué está a prueba</h2>
          <p class="hint">
            Un brazo gana sólo cuando tiene suficientes piezas Y le saca al otro más que el umbral.
            Con cinco piezas a la semana, el número más alto de hoy casi siempre es ruido.
          </p>
          {experiments.length === 0 && <p class="dim">Sin experimentos configurados.</p>}
          {experiments.map((e) => (
            <div class="exp">
              <div class="exp-head">
                <strong>{e.key}</strong>
                <span class="dim">{e.description}</span>
              </div>
              <table class="tbl">
                <thead>
                  <tr>
                    <th>Brazo</th>
                    <th class="n">Piezas</th>
                    <th class="n">{e.surface === "audio" ? "Descargas" : "Clics"}</th>
                    <th class="n">Por pieza</th>
                  </tr>
                </thead>
                <tbody>
                  {e.arms.map((a) => (
                    <tr class={a.arm === e.winner ? "win" : undefined}>
                      <td>{a.arm}{a.arm === e.winner && " 🏆"}</td>
                      <td class="n mono">{a.subjects}</td>
                      <td class="n mono">{a.outcome}</td>
                      <td class="n mono">{a.perSubject.toFixed(2)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class={e.winner ? "ok" : "dim"}>{e.verdict}</p>
            </div>
          ))}
        </section>

        <section class="card">
          <h2>Catálogo</h2>
          <table class="tbl">
            <thead><tr><th>Pieza</th><th>Tipo</th><th class="n">Min</th><th>Sincronía</th></tr></thead>
            <tbody>
              {catalog.map((c: any) => (
                <tr>
                  <td><a href={c.entity_type === "columna" ? `/columnas/${c.slug}` : `/a-fondo/${c.slug}`}>{c.title}</a></td>
                  <td class="dim">{c.entity_type}</td>
                  <td class="n mono">{Math.round((c.duration_s ?? 0) / 60)}</td>
                  <td>{c.cue_map_json ? <span class="ok">sí</span> : <span class="no">no</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>
    </AdminLayout>
  )
}

<style>
  .au { max-width: 60rem; }
  .au h1 { font-size: 1.5rem; letter-spacing: -0.02em; margin: 0 0 0.2rem; }
  .lead { font-size: 0.82rem; color: var(--admin-text-soft); margin: 0 0 1.25rem; }

  .kpis { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; margin-bottom: 1.25rem; }
  @media (min-width: 700px) { .kpis { grid-template-columns: repeat(7, 1fr); } }
  .kpi { border: 1px solid var(--admin-border); border-radius: 0.7rem; padding: 0.8rem 0.7rem; background: var(--admin-surface); }
  .kpi .v { font-size: 1.3rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .kpi .l { font-size: 0.62rem; color: var(--admin-text-soft); text-transform: uppercase; letter-spacing: 0.03em; margin-top: 0.15rem; }

  .caveat { font-size: 0.7rem; color: var(--admin-text-soft); line-height: 1.45; margin: -0.6rem 0 1.1rem; }
  .card { border: 1px solid var(--admin-border); border-radius: 0.8rem; padding: 1rem; background: var(--admin-surface); margin-bottom: 1rem; }
  .card h2 { font-size: 0.85rem; margin: 0 0 0.3rem; }
  .note { font-size: 0.7rem; color: var(--admin-text-soft); margin: 0 0 0.8rem; line-height: 1.4; }
  .empty { font-size: 0.85rem; color: var(--admin-text-soft); margin: 0; }
  .mono { font-variant-numeric: tabular-nums; }

  .drop { display: flex; align-items: flex-end; gap: 0.35rem; height: 8rem; padding-bottom: 1.1rem; }
  .drop-col { flex: 1; min-width: 0; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; position: relative; }
  .drop-bar { width: 100%; background: var(--rhino); border-radius: 3px 3px 0 0; }
  .drop-lbl { position: absolute; bottom: -1.05rem; font-size: 0.55rem; color: var(--admin-text-soft); font-variant-numeric: tabular-nums; }

  .tbl { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .tbl th { text-align: left; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-soft); font-weight: 600; padding: 0 0.5rem 0.4rem; border-bottom: 1px solid var(--admin-border); }
  .tbl td { padding: 0.5rem; border-top: 1px solid var(--admin-border); vertical-align: middle; }
  .tbl a { color: inherit; }
  .tbl .n { text-align: right; }
  .dim { color: var(--admin-text-soft); font-size: 0.74rem; }
  .hint { font-size: 0.7rem; color: var(--admin-text-soft); margin: 0 0 0.7rem; line-height: 1.4; }
  .exp { margin-bottom: 1rem; }
  .exp:last-child { margin-bottom: 0; }
  .exp-head { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline; margin-bottom: 0.3rem; font-size: 0.78rem; }
  .exp .win { font-weight: 600; }
  .exp p { font-size: 0.72rem; margin: 0.3rem 0 0; }
  .ok { color: var(--rhino); font-weight: 600; }
  .no { color: var(--admin-text-soft); }

  .rate { display: flex; align-items: center; gap: 0.5rem; }
  .rate-track { flex: 1; min-width: 3rem; height: 0.4rem; border-radius: 999px; background: var(--admin-surface-2); overflow: hidden; }
  .rate-fill { height: 100%; background: var(--rhino); border-radius: 999px; }

  .ev { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .mon-ok { font-size: 0.8rem; font-weight: 700; color: var(--rhino); margin: 0 0 0.7rem; }
  .mon-bad { font-size: 0.8rem; font-weight: 700; color: #c0392b; margin: 0 0 0.7rem; }
  .mon { margin-bottom: 0.8rem; }
  .mon-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .mon-list li { display: grid; grid-template-columns: 0.55rem 12rem 1fr; align-items: center; gap: 0.5rem; font-size: 0.76rem; }
  @media (max-width: 620px) { .mon-list li { grid-template-columns: 0.55rem 1fr; } .mon-detail { grid-column: 2; color: var(--admin-text-soft); } }
  .mon-dot { width: 0.55rem; height: 0.55rem; border-radius: 999px; background: var(--admin-text-soft); }
  .is-ok .mon-dot { background: var(--rhino); }
  .is-warn .mon-dot { background: #d68910; }
  .is-bad .mon-dot { background: #c0392b; }
  .mon-detail { color: var(--admin-text-soft); overflow: hidden; text-overflow: ellipsis; }

  .kpis--3 { grid-template-columns: repeat(3, 1fr); margin-bottom: 1rem; }
  @media (min-width: 700px) { .kpis--3 { grid-template-columns: repeat(3, 1fr); } }
  .split { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 720px) { .split { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
  .card h3 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-soft); margin: 0 0 0.5rem; }
  .bars { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .bars li { display: grid; grid-template-columns: 7.5rem 1fr auto; align-items: center; gap: 0.5rem; font-size: 0.78rem; }
  .bars__k { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bars__track { height: 0.45rem; border-radius: 999px; background: var(--admin-surface-2); overflow: hidden; }
  .bars__fill { display: block; height: 100%; background: var(--rhino); border-radius: 999px; }

  .ev li { display: flex; align-items: baseline; gap: 0.4rem; border: 1px solid var(--admin-border); border-radius: 999px; padding: 0.25rem 0.7rem; font-size: 0.76rem; }
</style>
