---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

let messages: any[] = [];
if (authorized && env?.DB) {
  const res = await env.DB.prepare("SELECT * FROM contact_messages ORDER BY created_at DESC").all();
  messages = res?.results ?? [];
}
---

<AdminLayout title="Contacto — Admin" active="/admin/contacto" authorized={authorized}>
  {
    !authorized ? (
      <AdminLogin />
    ) : (
      <>
        <h1>Mensajes de contacto <span class="count-badge">{messages.filter((m: any) => !m.read_at).length}</span></h1>

        {messages.length === 0 && <p class="empty-state">Nada por aquí todavía.</p>}

        <div class="list">
          {messages.map((m: any) => (
            <div class={`msg-card ${m.read_at ? "msg-card--read" : ""}`} data-id={m.id}>
              <p class="meta">
                {new Date(m.created_at).toLocaleString("es-MX")} · <a href={`mailto:${m.email}`}>{m.email}</a>
              </p>
              <h3>{m.name}</h3>
              <p>{m.message}</p>
              {!m.read_at && <button class="mark-read" data-id={m.id}>Marcar como leído</button>}
            </div>
          ))}
        </div>
      </>
    )
  }

  <script define:vars={{ token }}>
    document.querySelectorAll(".mark-read").forEach((btn) => {
      btn.addEventListener("click", async () => {
        await fetch(`/api/contact/${btn.dataset.id}/read?token=${encodeURIComponent(token)}`, { method: "POST" });
        btn.closest(".msg-card")?.classList.add("msg-card--read");
        btn.remove();
      });
    });
  </script>
</AdminLayout>

<style>
  h1 { font-size: 1.3rem; margin: 0 0 0.75rem; }
  .count-badge {
    background: var(--admin-surface-2);
    color: var(--admin-text-soft);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .empty-state {
    border: 1px dashed var(--admin-border);
    border-radius: 0.7rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--admin-text-soft);
  }
  .list { display: grid; gap: 0.75rem; }
  .msg-card {
    border: 1px solid var(--admin-border);
    border-radius: 0.8rem;
    background: var(--admin-surface);
    padding: 1rem;
  }
  .msg-card--read { opacity: 0.6; }
  .meta { font-size: 0.72rem; color: var(--admin-text-soft); margin: 0 0 0.3rem; }
  h3 { font-size: 1rem; margin: 0 0 0.4rem; }
  .mark-read {
    margin-top: 0.6rem;
    background: var(--rhino);
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    cursor: pointer;
  }
</style>
