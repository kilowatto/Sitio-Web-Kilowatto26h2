---
import Base from "../../layouts/Base.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";

const token = checkAdminAuth(Astro, env);
const authorized = !!token;

let fotosCount = 0;
let entidadesCount = 0;
let prensaCount = 0;
if (authorized && env?.DB) {
  const [f, e, p] = await Promise.all([
    env.DB.prepare("SELECT COUNT(*) AS n FROM photos WHERE approval_status = 'pending'").first(),
    env.DB.prepare("SELECT COUNT(*) AS n FROM entities WHERE approval_status = 'pending'").first(),
    env.DB.prepare("SELECT COUNT(*) AS n FROM press_mentions WHERE status = 'pending'").first(),
  ]);
  fotosCount = (f as any)?.n ?? 0;
  entidadesCount = (e as any)?.n ?? 0;
  prensaCount = (p as any)?.n ?? 0;
}

const sections = [
  { href: "/admin/fotos", label: "Fotos", count: fotosCount, desc: "Revisar y aprobar fotos subidas" },
  { href: "/admin/entidades", label: "Entidades", count: entidadesCount, desc: "Tooltips de Wikidata pendientes" },
  { href: "/admin/prensa", label: "Prensa", count: prensaCount, desc: "Menciones de prensa detectadas" },
];
---

<Base title="Panel de administración">
  <div class="container admin-hub">
    {
      !authorized ? (
        <AdminLogin />
      ) : (
        <>
          <h1>Panel de administración</h1>
          <div class="sections">
            {sections.map((s) => (
              <a href={s.href} class="section-card">
                {s.count > 0 && <span class="badge">{s.count}</span>}
                <h2>{s.label}</h2>
                <p>{s.desc}</p>
              </a>
            ))}
          </div>
        </>
      )
    }
  </div>
</Base>

<style>
  .admin-hub {
    padding-block: var(--space-4);
  }
  .sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .section-card {
    position: relative;
    display: block;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    padding: var(--space-2);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .section-card:hover {
    border-color: var(--rhino);
  }
  .section-card h2 {
    margin: 0 0 0.3rem;
    font-size: 1.1rem;
  }
  .section-card p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .badge {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    background: var(--rhino);
    color: #fff;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
