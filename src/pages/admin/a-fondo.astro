---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";
import { displayViewCount } from "../../lib/investigaciones-query";

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

let pending: any[] = [];
let published: any[] = [];
let faqsByInvestigacion = new Map<number, any[]>();

if (authorized && env?.DB) {
  const [pendingRes, publishedRes] = await Promise.all([
    env.DB.prepare(`SELECT * FROM investigaciones WHERE status IN ('pending_approval', 'draft') ORDER BY created_at DESC`).all(),
    env.DB.prepare(
      `SELECT id, slug, title, published_at, view_count, display_seed, read_minutes FROM investigaciones WHERE status = 'published' ORDER BY published_at DESC LIMIT 10`
    ).all(),
  ]);
  pending = pendingRes.results ?? [];
  published = publishedRes.results ?? [];

  if (published.length > 0) {
    const ids = published.map((r: any) => r.id);
    const placeholders = ids.map(() => "?").join(",");
    const faqsRes = await env.DB.prepare(
      `SELECT investigacion_id, id, question, answer_html FROM investigacion_faqs WHERE investigacion_id IN (${placeholders}) ORDER BY investigacion_id, position`
    )
      .bind(...ids)
      .all<any>();
    for (const f of faqsRes.results ?? []) {
      const list = faqsByInvestigacion.get(f.investigacion_id) ?? [];
      list.push(f);
      faqsByInvestigacion.set(f.investigacion_id, list);
    }
  }
}
---

{
  !authorized ? (
    <AdminLogin />
  ) : (
    <AdminLayout title="A Fondo con Kilowatto — Admin" active="/admin/a-fondo">
      <section class="panel">
        <h1>A Fondo con Kilowatto</h1>
        <p class="hint">
          Estas piezas no se generan desde aquí con un botón — Claude las produce en una conversación (8-10 agentes
          de investigación + fact-check adversarial, con tu tema), y aterrizan aquí ya completas para tu revisión.
          Abre la vista previa para verla exactamente como se vería publicada (gráficas, tablas, todo) antes de
          decidir. Al aprobar, se rellena automáticamente cualquier imagen que falte (portada + una ilustración por
          gráfica) y se genera un lote de 24-48 posts programados (repartidos en más de un mes, cada uno con su
          propia imagen) que quedan pendientes de tu aprobación en <a href="/admin/social">/admin/social</a>.
        </p>

        <h2>Pendientes de aprobar ({pending.length})</h2>
        {pending.length === 0 ? (
          <p class="empty">No hay investigaciones esperando revisión ahora mismo.</p>
        ) : (
          <div class="drafts">
            {pending.map((r: any) => (
              <div class="draft" data-id={r.id}>
                {r.rejection_reason && <p class="flag">⚠️ Rechazada antes: {r.rejection_reason}</p>}
                <p class="draft__meta">
                  {r.read_minutes} min de lectura · estado: {r.status}
                </p>
                <input type="text" class="draft__title" value={r.title} />
                <input type="text" class="draft__subtitle" placeholder="Subtítulo (opcional)" value={r.subtitle ?? ""} />
                <textarea class="draft__summary" rows={3} placeholder="Resumen ejecutivo" set:text={r.summary} />
                <p class="draft__note">
                  El cuerpo completo (con gráficas y tablas) se edita revisando la vista previa — si necesita cambios
                  de fondo, rechaza con el motivo y Claude lo ajusta.
                </p>
                <a class="btn btn--preview" href={`/a-fondo/${r.slug}?token=${token}`} target="_blank" rel="noopener">
                  👁️ Ver vista previa completa
                </a>
                <div class="draft__actions">
                  <button type="button" class="btn btn--approve" data-action="approve" data-id={r.id}>
                    ✅ Aprobar y publicar
                  </button>
                  <button type="button" class="btn btn--reject" data-action="reject" data-id={r.id}>
                    ✕ Rechazar
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}

        <h2>Publicadas recientemente</h2>
        <ul class="recent">
          {published.map((r: any) => (
            <li>
              <a href={`/a-fondo/${r.slug}`} target="_blank" rel="noopener">
                {r.title}
              </a>{" "}
              — {r.published_at} · {displayViewCount(r).toLocaleString("es-MX")} lecturas ({r.view_count} reales,
              semilla {r.display_seed}) · {r.read_minutes} min
            </li>
          ))}
        </ul>

        <h2>FAQ por pieza</h2>
        <p class="hint">
          Editable a mano -- agrega, quita o reescribe preguntas/respuestas y guarda. "Regenerar con IA" descarta
          los cambios y vuelve a generar desde cero con el cuerpo actual de la pieza. Guardar NO retraduce
          automáticamente a los demás idiomas -- si necesitas eso, vuelve a correr la traducción de esa pieza.
        </p>
        <div class="faq-pieces">
          {published.map((r: any) => (
            <details class="faq-piece" data-faq-piece data-id={r.id}>
              <summary>{r.title} ({(faqsByInvestigacion.get(r.id) ?? []).length} preguntas)</summary>
              <div class="faq-rows" data-faq-rows>
                {(faqsByInvestigacion.get(r.id) ?? []).map((f: any) => (
                  <div class="faq-row" data-faq-row>
                    <input type="text" class="faq-row__question" placeholder="Pregunta" value={f.question} />
                    <textarea class="faq-row__answer" rows={2} placeholder="Respuesta" set:text={f.answer_html.replace(/^<p>|<\/p>$/g, "")} />
                    <button type="button" class="btn btn--remove" data-action="remove-faq-row">✕</button>
                  </div>
                ))}
              </div>
              <div class="faq-piece__actions">
                <button type="button" class="btn btn--preview" data-action="add-faq-row">+ Agregar pregunta</button>
                <button type="button" class="btn btn--approve" data-action="save-faqs">💾 Guardar</button>
                <button type="button" class="btn btn--reject" data-action="regenerate-faqs">🔁 Regenerar con IA</button>
              </div>
            </details>
          ))}
        </div>
      </section>

      <script define:vars={{ token }}>
        document.querySelectorAll('[data-action="approve"]').forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.dataset.id;
            const draft = document.querySelector(`.draft[data-id="${id}"]`);
            const title = draft.querySelector(".draft__title").value;
            const subtitle = draft.querySelector(".draft__subtitle").value;
            const summary = draft.querySelector(".draft__summary").value;
            btn.disabled = true;
            btn.textContent = "Publicando…";
            try {
              const res = await fetch(`/api/investigaciones/${id}/approve?token=${encodeURIComponent(token)}`, {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ title, subtitle, summary }),
              });
              const data = await res.json().catch(() => ({}));
              const imgParts = [];
              if (data.coverGenerated) imgParts.push("portada");
              if (data.chartsImaged) imgParts.push(`${data.chartsImaged} ilustración(es) de gráfica`);
              const imgMsg = data.imagesError
                ? `\n\nOjo: no se pudieron generar algunas imágenes (${data.imagesError}) -- reintenta desde aquí mismo si hace falta.`
                : imgParts.length
                  ? `\n\nSe generaron: ${imgParts.join(" + ")}.`
                  : "";
              const faqMsg = data.faqsError
                ? `\n\nOjo: el FAQ no se generó (${data.faqsError}) -- reintenta llamando a /api/investigaciones/${id}/generate-faqs.`
                : typeof data.faqsGenerated === "number"
                  ? `\n\nSe generaron ${data.faqsGenerated} preguntas frecuentes.`
                  : "";
              if (data.postsError) {
                alert(`Se publicó, pero el lote de posts no se generó: ${data.postsError}${imgMsg}${faqMsg}\n\nPuedes reintentarlo llamando a /api/investigaciones/${id}/generate-posts desde el admin de posting.`);
              } else if (typeof data.postsGenerated === "number") {
                alert(`Publicado. Se generaron ${data.postsGenerated} posts programados, pendientes de tu aprobación en /admin/social.${imgMsg}${faqMsg}`);
              }
              location.reload();
            } catch {
              alert("Se perdió la conexión al aprobar. Intenta de nuevo.");
              btn.disabled = false;
              btn.textContent = "✅ Aprobar y publicar";
            }
          });
        });

        function makeFaqRow(question, answer) {
          const row = document.createElement("div");
          row.className = "faq-row";
          row.dataset.faqRow = "";
          row.innerHTML = `
            <input type="text" class="faq-row__question" placeholder="Pregunta" value="${(question ?? "").replace(/"/g, "&quot;")}" />
            <textarea class="faq-row__answer" rows="2" placeholder="Respuesta">${answer ?? ""}</textarea>
            <button type="button" class="btn btn--remove" data-action="remove-faq-row">✕</button>
          `;
          return row;
        }

        document.querySelectorAll("[data-faq-piece]").forEach((piece) => {
          const id = piece.dataset.id;
          const rowsEl = piece.querySelector("[data-faq-rows]");

          piece.addEventListener("click", async (e) => {
            const btn = e.target.closest("button[data-action]");
            if (!btn) return;
            const action = btn.dataset.action;

            if (action === "remove-faq-row") {
              btn.closest("[data-faq-row]").remove();
              return;
            }

            if (action === "add-faq-row") {
              rowsEl.appendChild(makeFaqRow("", ""));
              return;
            }

            if (action === "save-faqs") {
              const faqs = Array.from(rowsEl.querySelectorAll("[data-faq-row]"))
                .map((row) => ({
                  question: row.querySelector(".faq-row__question").value.trim(),
                  answer: row.querySelector(".faq-row__answer").value.trim(),
                }))
                .filter((f) => f.question && f.answer);
              btn.disabled = true;
              btn.textContent = "Guardando…";
              try {
                await fetch(`/api/investigaciones/${id}/faqs?token=${encodeURIComponent(token)}`, {
                  method: "PUT",
                  headers: { "content-type": "application/json" },
                  body: JSON.stringify({ faqs }),
                });
                btn.textContent = "✅ Guardado";
                setTimeout(() => {
                  btn.disabled = false;
                  btn.textContent = "💾 Guardar";
                }, 1500);
              } catch {
                alert("Se perdió la conexión al guardar. Intenta de nuevo.");
                btn.disabled = false;
                btn.textContent = "💾 Guardar";
              }
            }

            if (action === "regenerate-faqs") {
              if (!confirm("Esto descarta las preguntas actuales de esta pieza y genera un set nuevo con IA. ¿Continuar?")) return;
              btn.disabled = true;
              btn.textContent = "Regenerando…";
              try {
                const res = await fetch(`/api/investigaciones/${id}/generate-faqs?token=${encodeURIComponent(token)}`, {
                  method: "POST",
                });
                const data = await res.json().catch(() => ({}));
                if (data.error) {
                  alert(`No se pudo regenerar: ${data.error}`);
                  btn.disabled = false;
                  btn.textContent = "🔁 Regenerar con IA";
                } else {
                  location.reload();
                }
              } catch {
                alert("Se perdió la conexión al regenerar. Intenta de nuevo.");
                btn.disabled = false;
                btn.textContent = "🔁 Regenerar con IA";
              }
            }
          });
        });

        document.querySelectorAll('[data-action="reject"]').forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = btn.dataset.id;
            const reason = prompt("¿Por qué la rechazas? Este motivo ayuda a que la siguiente salga mejor.") ?? "";
            btn.disabled = true;
            btn.textContent = "Rechazando…";
            try {
              await fetch(`/api/investigaciones/${id}/reject?token=${encodeURIComponent(token)}`, {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ reason }),
              });
              location.reload();
            } catch {
              alert("Se perdió la conexión al rechazar. Intenta de nuevo.");
              btn.disabled = false;
              btn.textContent = "✕ Rechazar";
            }
          });
        });
      </script>

      <style>
        .panel { max-width: 56rem; margin: 0 auto; padding: 1.5rem; }
        .hint { color: var(--ink-soft, #666); font-size: 0.9rem; margin-top: 0.25rem; }
        .empty { color: var(--ink-soft, #666); }
        .btn { border: none; border-radius: 0.5rem; padding: 0.6rem 1rem; font-weight: 600; cursor: pointer; display: inline-block; text-decoration: none; }
        .btn--preview { background: var(--mist, #f3efe8); color: var(--ink, #16130f); border: 1px solid var(--line, #ddd); }
        .btn--approve { background: #1a7f37; color: #fff; }
        .btn--reject { background: #b83b09; color: #fff; }
        .btn:disabled { opacity: 0.6; cursor: default; }
        .drafts { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 1rem; }
        .draft { border: 1px solid var(--line, #ddd); border-radius: 0.75rem; padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
        .draft__meta { font-size: 0.8rem; color: var(--ink-soft, #666); margin: 0; font-family: var(--font-mono); }
        .draft__title { font-size: 1.1rem; font-weight: 700; padding: 0.5rem; border: 1px solid var(--line, #ddd); border-radius: 0.4rem; }
        .draft__subtitle { padding: 0.5rem; border: 1px solid var(--line, #ddd); border-radius: 0.4rem; }
        .draft__summary { font-size: 0.9rem; padding: 0.5rem; border: 1px solid var(--line, #ddd); border-radius: 0.4rem; }
        .draft__note { font-size: 0.82rem; color: var(--ink-soft, #666); margin: 0; }
        .draft__actions { display: flex; gap: 0.6rem; }
        .flag { background: #fff3cd; color: #664d03; padding: 0.4rem 0.6rem; border-radius: 0.4rem; font-size: 0.85rem; }
        .recent { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
        .faq-pieces { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
        .faq-piece { border: 1px solid var(--line, #ddd); border-radius: 0.6rem; padding: 0.8rem 1rem; }
        .faq-piece summary { cursor: pointer; font-weight: 600; }
        .faq-rows { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.8rem; }
        .faq-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.4rem 0.6rem; align-items: start; }
        .faq-row__question { grid-column: 1; padding: 0.45rem; border: 1px solid var(--line, #ddd); border-radius: 0.4rem; font-weight: 600; }
        .faq-row__answer { grid-column: 1; padding: 0.45rem; border: 1px solid var(--line, #ddd); border-radius: 0.4rem; font-size: 0.9rem; resize: vertical; }
        .faq-row .btn--remove { grid-row: 1 / span 2; background: transparent; color: #b83b09; border: 1px solid var(--line, #ddd); }
        .faq-piece__actions { display: flex; gap: 0.6rem; margin-top: 0.8rem; flex-wrap: wrap; }
      </style>
    </AdminLayout>
  )
}
