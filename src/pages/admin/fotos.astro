---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

let pending: any[] = [];
let approved: any[] = [];
let allPeopleNames: string[] = [];
let photoPeopleMap = new Map<number, any[]>();
if (authorized && env?.DB) {
  const [pendingRes, approvedRes, peopleRes, photoPeopleRes] = await Promise.all([
    env.DB.prepare("SELECT * FROM photos WHERE approval_status = 'pending' ORDER BY uploaded_at").all(),
    env.DB.prepare("SELECT * FROM photos WHERE approval_status = 'approved' ORDER BY approved_at DESC").all(),
    env.DB.prepare("SELECT name FROM people ORDER BY name").all(),
    env.DB.prepare(
      `SELECT pp.photo_id, p.id, p.name FROM photo_people pp JOIN people p ON p.id = pp.person_id`
    ).all(),
  ]);
  pending = pendingRes?.results ?? [];
  approved = approvedRes?.results ?? [];
  allPeopleNames = (peopleRes?.results ?? []).map((r: any) => r.name);
  for (const row of (photoPeopleRes?.results ?? []) as any[]) {
    if (!photoPeopleMap.has(row.photo_id)) photoPeopleMap.set(row.photo_id, []);
    photoPeopleMap.get(row.photo_id)!.push({ id: row.id, name: row.name });
  }
}

const clearCount = pending.filter((p: any) => p.minor_flag !== "flagged").length;
---

<AdminLayout title="Revisión de fotos — Admin" active="/admin/fotos" authorized={authorized}>
  <div class="container admin">
    {
      !authorized ? (
        <AdminLogin />
      ) : (
        <>
          <p class="admin-nav"><a href="/admin">← Panel de administración</a></p>
          <h1>Fotos pendientes de aprobar ({pending.length})</h1>
          <p class="hint">
            Las marcadas <strong>"posible menor"</strong> siempre necesitan un segundo clic de confirmación,
            una por una — nunca se publican de golpe. Las demás sí puedes seleccionarlas y aprobarlas en lote.
          </p>

          <div class="upload-album-row">
            <label for="album-input">Álbum</label>
            <input type="text" id="album-input" placeholder="álbum (ej: familia)" value="familia" />
          </div>

          <div id="dropzone" class="dropzone">
            <input type="file" id="batch-input" accept="image/*" multiple hidden />
            <p class="dropzone-label">
              <strong>Arrastra tus fotos aquí</strong> (1 a 150 a la vez) <br class="dropzone-br" />
              o toca para elegirlas desde tu iPhone/computadora
            </p>
            <div id="upload-progress" class="upload-progress" hidden>
              <div class="upload-progress-bar"><div id="upload-progress-fill" class="upload-progress-fill"></div></div>
              <p id="upload-status" class="upload-status"></p>
            </div>
          </div>

          <details class="zip-fallback">
            <summary>¿Prefieres subir un .zip?</summary>
            <form id="upload-form" class="upload-form">
              <input type="file" id="zip-input" accept=".zip" required />
              <button type="submit">Subir zip</button>
              <span id="zip-upload-status"></span>
            </form>
          </details>

          <p class="hint upload-note">
            JPG/PNG se procesan aquí mismo (caption + EXIF + flag de menor, igual que siempre). HEIC y video todavía
            necesitan el script local — este formulario los reporta como omitidos en vez de fallar.
          </p>

          {clearCount > 0 && (
            <div class="batch-bar">
              <button id="select-all-clear" type="button">
                Seleccionar todas las sin marcar ({clearCount})
              </button>
              <button id="approve-batch" type="button" disabled>
                Aprobar seleccionadas (<span id="batch-count">0</span>)
              </button>
            </div>
          )}

          <div class="grid">
            {pending.map((p: any) => {
              const flagged = p.minor_flag === "flagged";
              return (
                <div class={`photo-card ${flagged ? "photo-card--flagged" : ""}`} data-id={p.id}>
                  {!flagged && <input type="checkbox" class="select-box" data-id={p.id} />}
                  <img src={`/media/${p.r2_key}?w=400`} alt={p.ai_caption || ""} loading="lazy" />
                  <p class="caption">{p.ai_caption || "(sin caption)"}</p>
                  <p class="meta">
                    {p.taken_city ?? "ciudad desconocida"} · {p.taken_date ?? "fecha desconocida"}
                  </p>
                  <p class="flag">{flagged ? "⚠️ Posible menor / incierto" : "✅ Sin menores detectados"}</p>
                  <div class="actions">
                    {flagged ? (
                      <button class="approve-flagged" data-id={p.id} data-step="1">
                        Aprobar
                      </button>
                    ) : (
                      <button class="approve-single" data-id={p.id}>
                        Aprobar
                      </button>
                    )}
                    <button class="reject" data-id={p.id}>
                      Rechazar
                    </button>
                  </div>
                </div>
              );
            })}
          </div>

          <h2>Fotos aprobadas ({approved.length})</h2>
          <p class="hint">
            Ya están o pudieron estar públicas en la galería. "Desaprobar" las regresa a pendientes (reversible).
            "Borrar" las elimina para siempre — el archivo y el registro, sin vuelta atrás. "Foto de perfil" la suma
            al grupo que rota en el home (junto con las que la IA ya detectó solas).
          </p>

          <div class="reprocess-bar">
            <button id="reprocess-btn" type="button">🔄 Reprocesar todas con la IA nueva (lugar, naranja, tono)</button>
            <p id="reprocess-status" class="hint"></p>
          </div>

          <datalist id="people-datalist">
            {allPeopleNames.map((n: string) => <option value={n} />)}
          </datalist>

          <div class="grid">
            {approved.map((p: any) => (
              <div class="photo-card" data-id={p.id}>
                <img src={`/media/${p.r2_key}?w=400`} alt={p.caption || p.ai_caption || ""} loading="lazy" />

                <label class="profile-check">
                  <input type="checkbox" class="profile-toggle" data-id={p.id} checked={!!p.is_profile_photo} />
                  Foto de perfil (home)
                </label>

                <textarea class="caption-edit" data-id={p.id} rows="2">{p.caption ?? p.ai_caption ?? ""}</textarea>
                <button class="polish-caption" data-id={p.id} type="button">
                  ✨ Pulir y traducir
                </button>
                <p class="polish-status" data-id={p.id} />
                <p class="hint mention-hint">Escribe @ seguido del nombre real de la persona en el texto (ej. "@Rocío") para etiquetarla — no escribas @Nombre literal.</p>

                <p class="meta">
                  {p.taken_city ?? "ciudad desconocida"} · {p.taken_date ?? "fecha desconocida"}
                </p>

                <div class="people-tags" data-id={p.id}>
                  {(photoPeopleMap.get(p.id) ?? []).map((person: any) => (
                    <span class="person-chip" data-person-id={person.id}>
                      {person.name}
                      <button class="untag-person" data-id={p.id} data-person-id={person.id} type="button">
                        ×
                      </button>
                    </span>
                  ))}
                </div>
                <div class="tag-input-row">
                  <input
                    type="text"
                    class="tag-input"
                    data-id={p.id}
                    list="people-datalist"
                    placeholder="Nombre de la persona…"
                  />
                  <button class="tag-person" data-id={p.id} type="button">
                    + Marcar
                  </button>
                </div>

                <div class="actions">
                  <button class="unapprove" data-id={p.id}>
                    Desaprobar
                  </button>
                  <button class="delete-photo" data-id={p.id} data-step="1">
                    Borrar
                  </button>
                </div>
              </div>
            ))}
          </div>
        </>
      )
    }
  </div>

  <script define:vars={{ token }}>
    document.getElementById("reprocess-btn")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const status = document.getElementById("reprocess-status");
      if (btn.disabled) return;
      btn.disabled = true;
      let afterId = 0;
      let total = 0;
      try {
        while (true) {
          status.textContent = `Reprocesando… ${total} hechas hasta ahora.`;
          const res = await fetch(
            `/api/photos/reprocess-approved?token=${encodeURIComponent(token)}&afterId=${afterId}`,
            { method: "POST" }
          );
          const data = await res.json();
          if (!res.ok) {
            status.textContent = "Error: " + (data.error || res.statusText);
            break;
          }
          total += data.total;
          afterId = data.lastId;
          if (data.done) {
            status.textContent = `Listo: ${total} fotos reprocesadas.`;
            setTimeout(() => location.reload(), 1500);
            break;
          }
        }
      } catch (err) {
        status.textContent = "Se perdió la conexión — intenta de nuevo (retoma donde se quedó).";
      } finally {
        btn.disabled = false;
      }
    });

    document.getElementById("upload-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fileInput = document.getElementById("zip-input");
      const albumInput = document.getElementById("album-input");
      const status = document.getElementById("zip-upload-status");
      const file = fileInput.files[0];
      if (!file) return;

      status.textContent = `Subiendo ${(file.size / 1024 / 1024).toFixed(1)} MB… esto puede tardar varios minutos con muchas fotos.`;
      const fd = new FormData();
      fd.append("zip", file);

      try {
        const res = await fetch(
          `/api/photos/upload-zip?token=${encodeURIComponent(token)}&album=${encodeURIComponent(albumInput.value || "familia")}`,
          { method: "POST", body: fd }
        );
        const data = await res.json();
        if (!res.ok) {
          status.textContent = "Error: " + (data.error || res.statusText);
          return;
        }
        const dupNote = data.duplicates ? `, ${data.duplicates} duplicadas` : "";
        status.textContent = `Listo: ${data.processed} procesadas, ${data.skipped} omitidas${dupNote} (HEIC/video/error/duplicado).`;
        if (data.skippedFiles?.length) console.log("Omitidas:", data.skippedFiles);
        setTimeout(() => location.reload(), 2000);
      } catch (err) {
        status.textContent = "Error de red: " + err.message;
      }
    });

    // Direct multi-file upload: drag-and-drop 1-150 photos, or tap to pick from the
    // iPhone's native multi-select photo picker (no zip step needed). Uploaded in small
    // chunks (8 files/request) rather than one giant request, both to stay well under
    // Workers' request-size limits and to show real incremental progress.
    (() => {
      const dropzone = document.getElementById("dropzone");
      const input = document.getElementById("batch-input");
      const progress = document.getElementById("upload-progress");
      const progressFill = document.getElementById("upload-progress-fill");
      const status = document.getElementById("upload-status");
      if (!dropzone || !input) return;

      const CHUNK_SIZE = 8;
      let uploading = false;

      dropzone.addEventListener("click", () => {
        if (!uploading) input.click();
      });
      dropzone.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropzone.classList.add("dropzone--active");
      });
      dropzone.addEventListener("dragleave", () => dropzone.classList.remove("dropzone--active"));
      dropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzone.classList.remove("dropzone--active");
        if (!uploading && e.dataTransfer?.files?.length) uploadFiles([...e.dataTransfer.files]);
      });
      input.addEventListener("change", () => {
        if (input.files?.length) uploadFiles([...input.files]);
      });

      async function uploadFiles(files) {
        const images = files.filter((f) => f.type.startsWith("image/") || /\.(jpe?g|png)$/i.test(f.name));
        if (images.length === 0) {
          alert("No se encontraron JPG/PNG en lo que soltaste/elegiste.");
          return;
        }
        uploading = true;
        dropzone.classList.add("dropzone--busy");
        progress.hidden = false;

        const album = document.getElementById("album-input")?.value || "familia";
        let done = 0;
        let processedTotal = 0;
        let skippedTotal = 0;
        let duplicatesTotal = 0;
        const allSkipped = [];

        for (let i = 0; i < images.length; i += CHUNK_SIZE) {
          const chunk = images.slice(i, i + CHUNK_SIZE);
          const fd = new FormData();
          chunk.forEach((f) => fd.append("files", f));

          status.textContent = `Subiendo ${done}/${images.length}…`;
          try {
            const res = await fetch(
              `/api/photos/upload-batch?token=${encodeURIComponent(token)}&album=${encodeURIComponent(album)}`,
              { method: "POST", body: fd }
            );
            const data = await res.json();
            if (res.ok) {
              processedTotal += data.processed ?? 0;
              skippedTotal += data.skipped ?? 0;
              duplicatesTotal += data.duplicates ?? 0;
              if (data.skippedFiles?.length) allSkipped.push(...data.skippedFiles);
            } else {
              allSkipped.push(`(lote ${i / CHUNK_SIZE + 1}: ${data.error || res.statusText})`);
            }
          } catch (err) {
            allSkipped.push(`(lote ${i / CHUNK_SIZE + 1}: error de red — ${err.message})`);
          }
          done += chunk.length;
          progressFill.style.width = `${Math.round((done / images.length) * 100)}%`;
        }

        const dupNote = duplicatesTotal ? `, ${duplicatesTotal} duplicadas` : "";
        status.textContent = `Listo: ${processedTotal} procesadas, ${skippedTotal} omitidas${dupNote}.`;
        if (allSkipped.length) console.log("Omitidas:", allSkipped);
        uploading = false;
        dropzone.classList.remove("dropzone--busy");
        setTimeout(() => location.reload(), 1500);
      }
    })();

    function removeCard(id) {
      document.querySelector(`.photo-card[data-id="${id}"]`)?.remove();
      updateBatchCount();
    }

    // Flagged photos: click once to arm ("¿Seguro?"), click again within the same
    // page (no native dialog) to actually approve. Always two deliberate clicks,
    // never a single one, for anything the AI couldn't clearly clear.
    document.querySelectorAll(".approve-flagged").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (btn.dataset.step === "1") {
          btn.dataset.step = "2";
          btn.textContent = "¿Seguro? Sin menores — confirmar";
          btn.classList.add("armed");
          return;
        }
        const id = btn.dataset.id;
        const res = await fetch(`/api/photos/${id}/approve?token=${encodeURIComponent(token)}&confirm=si`, {
          method: "POST",
        });
        if (res.ok) removeCard(id);
        else alert("No se pudo aprobar: " + (await res.text()));
      });
    });

    document.querySelectorAll(".approve-single").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const res = await fetch(`/api/photos/${id}/approve?token=${encodeURIComponent(token)}`, { method: "POST" });
        if (res.ok) removeCard(id);
        else alert("No se pudo aprobar: " + (await res.text()));
      });
    });

    document.querySelectorAll(".reject").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        await fetch(`/api/photos/${id}/reject?token=${encodeURIComponent(token)}`, { method: "POST" });
        removeCard(id);
      });
    });

    document.querySelectorAll(".unapprove").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        await fetch(`/api/photos/${id}/unapprove?token=${encodeURIComponent(token)}`, { method: "POST" });
        removeCard(id);
      });
    });

    // Permanent deletion: same two-click "arm" pattern as the flagged-photo approval —
    // never a single click for something irreversible.
    document.querySelectorAll(".delete-photo").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (btn.dataset.step === "1") {
          btn.dataset.step = "2";
          btn.textContent = "¿Seguro? Borrar para siempre";
          btn.classList.add("armed");
          return;
        }
        const id = btn.dataset.id;
        const res = await fetch(`/api/photos/${id}/delete?token=${encodeURIComponent(token)}`, { method: "POST" });
        if (res.ok) removeCard(id);
        else alert("No se pudo borrar: " + (await res.text()));
      });
    });

    document.querySelectorAll(".profile-toggle").forEach((box) => {
      box.addEventListener("change", async () => {
        const id = box.dataset.id;
        await fetch(`/api/photos/${id}/set-profile?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ isProfilePhoto: box.checked }),
        });
      });
    });

    document.querySelectorAll(".polish-caption").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const textarea = document.querySelector(`.caption-edit[data-id="${id}"]`);
        const statusEl = document.querySelector(`.polish-status[data-id="${id}"]`);
        const caption = textarea?.value?.trim();
        if (!caption) {
          statusEl.textContent = "Escribe algo primero.";
          return;
        }
        if (btn.disabled) return;
        btn.disabled = true;
        statusEl.textContent = "Puliendo y traduciendo a 11 idiomas… (puede tardar 20-30 segundos)";
        let res, data;
        try {
          res = await fetch(`/api/photos/${id}/polish-caption?token=${encodeURIComponent(token)}`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ caption }),
          });
          data = await res.json();
        } catch (err) {
          btn.disabled = false;
          statusEl.textContent = "Se perdió la conexión — intenta de nuevo.";
          return;
        }
        btn.disabled = false;
        if (!res.ok) {
          statusEl.textContent = "Error: " + (data.error ?? "desconocido");
          return;
        }
        textarea.value = data.polished;
        statusEl.textContent = "Listo — pulido y traducido.";
      });
    });

    function renderPersonChip(container, id, personId, name) {
      const chip = document.createElement("span");
      chip.className = "person-chip";
      chip.dataset.personId = personId;
      chip.textContent = name + " ";
      const removeBtn = document.createElement("button");
      removeBtn.className = "untag-person";
      removeBtn.type = "button";
      removeBtn.dataset.id = id;
      removeBtn.dataset.personId = personId;
      removeBtn.textContent = "×";
      removeBtn.addEventListener("click", async () => {
        await fetch(`/api/photos/${id}/people?token=${encodeURIComponent(token)}&personId=${personId}`, {
          method: "DELETE",
        });
        chip.remove();
      });
      chip.appendChild(removeBtn);
      container.appendChild(chip);
    }

    document.querySelectorAll(".tag-person").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const input = document.querySelector(`.tag-input[data-id="${id}"]`);
        const name = input?.value?.trim();
        if (!name) return;
        const res = await fetch(`/api/photos/${id}/people?token=${encodeURIComponent(token)}`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name }),
        });
        const data = await res.json();
        if (res.ok) {
          renderPersonChip(document.querySelector(`.people-tags[data-id="${id}"]`), id, data.personId, data.name);
          input.value = "";
          const datalist = document.getElementById("people-datalist");
          if (datalist && ![...datalist.options].some((o) => o.value === data.name)) {
            const opt = document.createElement("option");
            opt.value = data.name;
            datalist.appendChild(opt);
          }
        }
      });
    });

    document.querySelectorAll(".untag-person").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const personId = btn.dataset.personId;
        await fetch(`/api/photos/${id}/people?token=${encodeURIComponent(token)}&personId=${personId}`, {
          method: "DELETE",
        });
        btn.closest(".person-chip")?.remove();
      });
    });

    function updateBatchCount() {
      const checked = document.querySelectorAll(".select-box:checked").length;
      const countEl = document.getElementById("batch-count");
      const btn = document.getElementById("approve-batch");
      if (countEl) countEl.textContent = String(checked);
      if (btn) btn.disabled = checked === 0;
    }

    document.querySelectorAll(".select-box").forEach((box) => {
      box.addEventListener("change", updateBatchCount);
    });

    document.getElementById("select-all-clear")?.addEventListener("click", () => {
      document.querySelectorAll(".select-box").forEach((box) => (box.checked = true));
      updateBatchCount();
    });

    document.getElementById("approve-batch")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const ids = Array.from(document.querySelectorAll(".select-box:checked")).map((b) => b.dataset.id);
      btn.disabled = true;
      btn.textContent = `Aprobando ${ids.length}…`;
      for (const id of ids) {
        const res = await fetch(`/api/photos/${id}/approve?token=${encodeURIComponent(token)}`, { method: "POST" });
        if (res.ok) removeCard(id);
      }
      location.reload();
    });
  </script>
</AdminLayout>

<style>
  .admin {
    padding-block: var(--space-4);
  }

  .admin-nav {
    margin-bottom: var(--space-2);
    font-size: 0.85rem;
  }

  .hint {
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .mention-hint {
    font-size: 0.72rem;
    margin: 0.2rem 0 0.5rem;
  }

  .upload-album-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-2);
  }
  .upload-album-row label { font-size: 0.85rem; color: var(--ink-soft); }
  .upload-album-row input[type="text"] {
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    padding: 0.4rem 0.6rem;
    width: 12rem;
  }

  .dropzone {
    margin: 0.6rem 0 0;
    padding: var(--space-3) var(--space-2);
    border: 2px dashed var(--line);
    border-radius: 0.6rem;
    background: var(--mist);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .dropzone--active { border-color: var(--rhino); background: color-mix(in srgb, var(--rhino) 8%, var(--mist)); }
  .dropzone--busy { cursor: default; }
  .dropzone-label { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }
  .dropzone-label strong { color: var(--ink); }
  .dropzone-br { display: none; }

  .upload-progress { margin-top: 0.8rem; }
  .upload-progress-bar {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--paper);
    overflow: hidden;
  }
  .upload-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--rhino);
    transition: width 0.2s ease;
  }
  .upload-status { margin: 0.4rem 0 0; font-size: 0.85rem; color: var(--ink-soft); }

  .zip-fallback {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }
  .zip-fallback summary {
    cursor: pointer;
    color: var(--ink-soft);
  }

  .upload-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0.6rem 0 0;
    padding: var(--space-2);
    background: var(--mist);
    border-radius: 0.5rem;
  }

  .upload-form button {
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: 0.4rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  .upload-note {
    font-size: 0.8rem;
  }

  .reprocess-bar {
    margin: 0.6rem 0 var(--space-2);
  }
  .reprocess-bar button {
    background: var(--rhino);
    color: #fff;
    border: none;
    border-radius: 0.4rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .reprocess-bar button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .batch-bar {
    display: flex;
