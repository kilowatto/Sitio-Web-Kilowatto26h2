---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminLogin from "../../components/AdminLogin.astro";
import { env } from "cloudflare:workers";
import { checkAdminAuth } from "../../lib/admin-auth";

const token = await checkAdminAuth(Astro, env);
const authorized = !!token;

let pending: any[] = [];
let approved: any[] = [];
if (authorized && env?.DB) {
  const [p, a] = await Promise.all([
    env.DB.prepare("SELECT * FROM entities WHERE approval_status = 'pending' ORDER BY created_at").all(),
    env.DB.prepare("SELECT * FROM entities WHERE approval_status = 'approved' ORDER BY name").all(),
  ]);
  pending = p?.results ?? [];
  approved = a?.results ?? [];
}
---

<AdminLayout title="Entidades — Admin" active="/admin/entidades" authorized={authorized}>
  {
    !authorized ? (
      <AdminLogin />
    ) : (
      <>
        <h1>Entidades pendientes <span class="count-badge">{pending.length}</span></h1>
        <form id="fetch-form">
          <input type="text" id="fetch-name" placeholder="Nombre exacto tal como aparece en el sitio" />
          <button type="submit">Buscar en Wikidata</button>
        </form>

        {pending.length === 0 && <p class="empty-state">Nada pendiente ahora mismo.</p>}

        <div class="list">
          {pending.map((e: any) => (
            <div class="entity-card" data-swipe-delete>
              <div data-swipe-content class="entity-card-content">
                {e.image_url && <img src={e.image_url} alt="" loading="lazy" />}
                <div>
                  <h3>{e.name}</h3>
                  <p>{e.description}</p>
                  <p class="meta">
                    {e.link_type} · <a href={e.link_url} target="_blank" rel="noopener">{e.link_url}</a>
                  </p>
                  <div class="actions">
                    <button class="approve" data-id={e.id}>Aprobar</button>
                    <button class="reject" data-id={e.id}>Rechazar</button>
                  </div>
                </div>
              </div>
              <button class="swipe-delete-action reject" data-id={e.id}>Rechazar</button>
            </div>
          ))}
        </div>

        <h2>Aprobadas <span class="count-badge">{approved.length}</span></h2>
        <ul class="approved-list">
          {approved.map((e: any) => (
            <li>
              <strong>{e.name}</strong> — {e.link_type} {e.internal_path ?? e.link_url}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <script define:vars={{ token }}>
    document.getElementById("fetch-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = document.getElementById("fetch-name").value.trim();
      if (!name) return;
      const res = await fetch(`/api/entities/fetch?token=${encodeURIComponent(token)}`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ name }),
      });
      if (res.ok) location.reload();
      else alert("No se encontró: " + (await res.text()));
    });

    document.querySelectorAll(".approve").forEach((btn) => {
      btn.addEventListener("click", async () => {
        await fetch(`/api/entities/${btn.dataset.id}/approve?token=${encodeURIComponent(token)}`, { method: "POST" });
        location.reload();
      });
    });
    document.querySelectorAll(".reject").forEach((btn) => {
      btn.addEventListener("click", async () => {
        await fetch(`/api/entities/${btn.dataset.id}/reject?token=${encodeURIComponent(token)}`, { method: "POST" });
        btn.closest(".entity-card")?.remove();
      });
    });
  </script>
</AdminLayout>

<style>
  h1, h2 { font-size: 1.3rem; margin: 1.5rem 0 0.75rem; }
  h1 { margin-top: 0; }
  .count-badge {
    background: var(--admin-surface-2);
    color: var(--admin-text-soft);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  #fetch-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.75rem 1.25rem;
  }
  #fetch-name {
    flex: 1;
    min-width: 14rem;
    max-width: 24rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--admin-border);
    border-radius: 0.5rem;
    background: var(--admin-surface);
    color: var(--admin-text);
  }
  #fetch-form button {
    background: var(--rhino);
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    padding: 0.6rem 1.1rem;
    cursor: pointer;
    font-family: inherit;
    font-weight: 600;
    min-height: 2.75rem;
  }
  .empty-state {
    border: 1px dashed var(--admin-border);
    border-radius: 0.7rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--admin-text-soft);
  }
  .list { display: grid; gap: 0.75rem; }
  .entity-card {
    border: 1px solid var(--admin-border);
    border-radius: 0.8rem;
    background: var(--admin-surface);
  }
  .entity-card-content { display: flex; gap: 1rem; padding: 1rem; border-radius: 0.8rem; background: var(--admin-surface); }
  .entity-card img { width: 5rem; height: 5rem; object-fit: cover; border-radius: 0.5rem; flex-shrink: 0; }
  .meta { font-size: 0.78rem; color: var(--admin-text-soft); }
  .actions { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
  .actions button {
    border: none;
    border-radius: 0.5rem;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
    min-height: 2.5rem;
  }
  .approve { background: var(--rhino); color: #fff; }
  .reject { background: var(--admin-surface-2); color: var(--admin-text); }
  .approved-list { font-size: 0.9rem; color: var(--admin-text-soft); padding-left: 1.2rem; }
</style>
