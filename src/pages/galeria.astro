---
import Site from "../layouts/Site.astro";
import { env } from "cloudflare:workers";
import { CAPTION_FAILURE_SENTINEL } from "../lib/photo-caption";

let photos: any[] = [];
if (env?.DB) {
  const res = await env.DB
    .prepare("SELECT * FROM photos WHERE approval_status = 'approved' ORDER BY taken_date DESC")
    .all();
  photos = res?.results ?? [];
}

const albums = [...new Set(photos.map((p: any) => p.album).filter(Boolean))];

function formatMonthYear(dateStr: string | null): string {
  if (!dateStr) return "";
  const d = new Date(dateStr + "T00:00:00");
  if (Number.isNaN(d.getTime())) return "";
  const formatted = new Intl.DateTimeFormat("es-MX", { month: "long", year: "numeric" }).format(d);
  return formatted.charAt(0).toUpperCase() + formatted.slice(1);
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "Galería — Kilowatto",
  associatedMedia: photos.map((p: any) => {
    const caption = p.caption || (p.ai_caption === CAPTION_FAILURE_SENTINEL ? "" : p.ai_caption) || "";
    return {
      "@type": "ImageObject",
      contentUrl: `https://kilowatto.com/media/${p.r2_key}`,
      description: caption,
      ...(p.taken_city ? { contentLocation: { "@type": "Place", name: p.taken_city } } : {}),
      ...(p.taken_date ? { dateCreated: p.taken_date } : {}),
    };
  }),
};
---

<Site
  title="Galería — Esteban Rey"
  description="Fotografías de Esteban Rey (Kilowatto): trayectoria, empresas, Yucatech Festival y vida personal."
  active="/galeria"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Galería</p>
      <h1>Momentos, no solo hechos.</h1>
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      {
        albums.length > 0 && (
          <div class="filters">
            <button class="filter active" data-album="all">
              Todas
            </button>
            {albums.map((a: any) => (
              <button class="filter" data-album={a}>
                {a}
              </button>
            ))}
          </div>
        )
      }

      {
        photos.length === 0 ? (
          <p class="hero__sub">Todavía no hay fotos aprobadas para mostrar aquí.</p>
        ) : (
          <div class="masonry">
            {photos.map((p: any) => {
              const caption = p.caption || (p.ai_caption === CAPTION_FAILURE_SENTINEL ? "" : p.ai_caption) || "";
              const monthYear = formatMonthYear(p.taken_date);
              const meta = [p.taken_city, monthYear].filter(Boolean).join(" · ");
              return (
                <figure
                  class="masonry__item"
                  data-album={p.album ?? ""}
                  data-full={`/media/${p.r2_key}?w=1400`}
                  data-caption={caption}
                  data-meta={meta}
                  tabindex="0"
                >
                  <img
                    src={`/media/${p.r2_key}?w=500`}
                    srcset={`/media/${p.r2_key}?w=300 300w, /media/${p.r2_key}?w=500 500w, /media/${p.r2_key}?w=800 800w, /media/${p.r2_key}?w=1100 1100w`}
                    sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
                    alt={caption}
                    loading="lazy"
                  />
                  {(caption || meta) && (
                    <figcaption>
                      {meta && <span class="meta-line">{meta}</span>}
                      {caption && <span class="caption-line">{caption}</span>}
                    </figcaption>
                  )}
                </figure>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <div id="lightbox" class="lightbox" hidden>
    <button class="lightbox__close" type="button" aria-label="Cerrar">×</button>
    <figure class="lightbox__figure">
      <img id="lightbox-img" alt="" />
      <figcaption id="lightbox-caption"></figcaption>
    </figure>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
    const items = document.querySelectorAll<HTMLElement>(".masonry__item");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const album = btn.dataset.album;
        items.forEach((item) => {
          item.style.display = album === "all" || item.dataset.album === album ? "" : "none";
        });
      });
    });

    let activeItem: HTMLElement | null = null;
    function closeActive() {
      activeItem?.classList.remove("is-revealed");
      activeItem = null;
    }
    items.forEach((item) => {
      item.addEventListener("click", (e) => {
        if (!window.matchMedia("(hover: none)").matches) return;
        if (item === activeItem) return;
        e.preventDefault();
        closeActive();
        item.classList.add("is-revealed");
        activeItem = item;
      });
    });
    document.addEventListener("click", (e) => {
      if (activeItem && !activeItem.contains(e.target as Node)) closeActive();
    });

    const lightbox = document.getElementById("lightbox") as HTMLElement;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const lightboxCaption = document.getElementById("lightbox-caption") as HTMLElement;

    function openLightbox(item: HTMLElement) {
      lightboxImg.src = item.dataset.full ?? "";
      lightboxImg.alt = item.dataset.caption ?? "";
      lightboxCaption.innerHTML = "";
      if (item.dataset.meta) {
        const metaEl = document.createElement("span");
        metaEl.className = "meta-line";
        metaEl.textContent = item.dataset.meta;
        lightboxCaption.appendChild(metaEl);
      }
      if (item.dataset.caption) {
        const capEl = document.createElement("span");
        capEl.className = "caption-line";
        capEl.textContent = item.dataset.caption;
        lightboxCaption.appendChild(capEl);
      }
      lightbox.hidden = false;
    }
    function closeLightbox() {
      lightbox.hidden = true;
      lightboxImg.src = "";
    }

    items.forEach((item) => {
      item.addEventListener("click", (e) => {
        const isTouchFirstTap = window.matchMedia("(hover: none)").matches && item !== activeItem;
        if (isTouchFirstTap) return;
        openLightbox(item);
      });
      item.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openLightbox(item);
        }
      });
    });
    document.querySelector(".lightbox__close")?.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !lightbox.hidden) closeLightbox();
    });
  </script>
</Site>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-3);
  }

  .filter {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    cursor: pointer;
    color: var(--ink-soft);
  }

  .filter.active {
    /* var(--ember), not --rhino -- white text on the brighter orange fails WCAG contrast
       (3.04:1, needs 4.5:1); ember is the same brand family at a shade dark enough to pass. */
    background: var(--ember);
    border-color: var(--ember);
    color: #fff;
  }

  .masonry {
    columns: 1;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .masonry {
      columns: 2;
    }
  }

  @media (min-width: 960px) {
    .masonry {
      columns: 3;
    }
  }

  .masonry__item {
    margin: 0 0 var(--space-2);
    break-inside: avoid;
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .masonry__item img {
    width: 100%;
    display: block;
  }

  .masonry__item figcaption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    color: #fff;
    padding: 1.5rem 0.75rem 0.6rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .masonry__item .meta-line {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    opacity: 0.85;
  }

  .masonry__item .caption-line {
    font-size: 0.82rem;
  }

  .masonry__item:hover figcaption,
  .masonry__item:focus-within figcaption,
  .masonry__item.is-revealed figcaption {
    opacity: 1;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(10, 8, 6, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: var(--space-2);
  }
  /* [hidden] and .lightbox{display:flex} share the same specificity, so author CSS wins
     the cascade and the modal stays visible regardless of the attribute unless this rule
     (attribute + class = higher specificity) explicitly restores the native behavior. */
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__figure {
    max-width: 90vw;
    max-height: 90vh;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .lightbox__figure img {
    max-width: 90vw;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 0.4rem;
  }
  .lightbox__figure figcaption {
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.6rem;
  }
  .lightbox__figure .meta-line {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--volt);
  }
  .lightbox__figure .caption-line {
    font-size: 0.95rem;
  }
  .lightbox__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem;
  }
</style>
