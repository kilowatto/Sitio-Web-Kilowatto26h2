---
import Site from "../../layouts/Site.astro";
import FamilyTreeNode from "../../components/FamilyTreeNode.astro";
import { env } from "cloudflare:workers";
import { localeFromParam } from "../../lib/locales";
import { loadTranslations } from "../../lib/i18n";

const locale = localeFromParam(Astro.params.locale);
if (!locale || locale.canonical) return Astro.redirect("/familia", 302);

let family: any[] = [];
let tr = new Map<string, string>();
if (env?.DB) {
  const res = await env.DB.prepare("SELECT * FROM family_members ORDER BY sort_order").all();
  family = res?.results ?? [];
  tr = await loadTranslations(env.DB, "family_members", locale.code);
}

const byId = new Map(family.map((f: any) => [f.id, f]));
const parentIds = new Set(family.flatMap((f: any) => [f.parent_1_id, f.parent_2_id]).filter(Boolean));
const roots = family.filter((f: any) => !parentIds.has(f.id));
---

<Site title="Familia — Esteban Rey" active="/familia" locale={locale.code} dir={locale.rtl ? "rtl" : "ltr"}>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Kilowatto</p>
      <h1>Kilowatto</h1>
    </div>
  </section>
  <section class="chapter">
    <div class="container tree-wrap">
      <ul class="tree">
        {roots.map((r: any) => <FamilyTreeNode node={r} byId={byId} tr={tr} />)}
      </ul>
    </div>
  </section>
</Site>
