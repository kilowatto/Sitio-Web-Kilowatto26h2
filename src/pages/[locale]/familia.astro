---
import Site from "../../layouts/Site.astro";
import { env } from "cloudflare:workers";
import { localeFromParam } from "../../lib/locales";
import { loadTranslations, t } from "../../lib/i18n";

const locale = localeFromParam(Astro.params.locale);
if (!locale || locale.canonical) return Astro.redirect("/familia", 302);

let family: any[] = [];
let tr = new Map<string, string>();
if (env?.DB) {
  const res = await env.DB.prepare("SELECT * FROM family_members ORDER BY sort_order").all();
  family = res?.results ?? [];
  tr = await loadTranslations(env.DB, "family_members", locale.code);
}

function formatDates(f: any) {
  if (!f.birth_date && !f.death_date) return null;
  return `${f.birth_date ?? "?"}${f.death_date ? ` – ${f.death_date}` : ""}`;
}
---

<Site title="Familia — Esteban Rey" active="/familia" locale={locale.code} dir={locale.rtl ? "rtl" : "ltr"}>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Kilowatto</p>
      <h1>Kilowatto</h1>
    </div>
  </section>
  <section class="chapter">
    <div class="container">
      <ul class="cards">
        {
          family.map((f: any) => (
            <li class="card">
              <p class="eyebrow">{t(tr, f.id, "relationship", f.relationship)}</p>
              <h3>
                {f.full_name}
                {f.nickname && ` "${f.nickname}"`}
              </h3>
              {formatDates(f) && <p class="row__range">{formatDates(f)}</p>}
              {f.bio && <p>{t(tr, f.id, "bio", f.bio)}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Site>
