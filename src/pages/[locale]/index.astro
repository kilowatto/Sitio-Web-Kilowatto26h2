  },
};

const he = HOME_EXTRA[locale.code] ?? SPANISH_HOME_EXTRA;
---

<Site title="Esteban Rey — Kilowatto" active={`/${locale.code}`} locale={locale.code} dir={locale.rtl ? "rtl" : "ltr"}>
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <p class="eyebrow">Esteban Rey · CEO, Ignia Cloud</p>
        <h1>Serio.<br />Pero no solemne.</h1>
        <Spark />
        <p class="hero__sub">{bio}</p>
      </div>
      {heroPhoto && (
        <img
          class="hero__photo"
          src={`/media/${heroPhoto.r2_key}?w=500`}
          srcset={`/media/${heroPhoto.r2_key}?w=500 500w, /media/${heroPhoto.r2_key}?w=900 900w`}
          sizes="(max-width: 720px) 100vw, 22rem"
          alt="Esteban Rey"
          fetchpriority="high"
        />
      )}
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      <p class="eyebrow">{he.trayectoriaEyebrow}</p>
      <h2>{he.trayectoriaHeadline}</h2>
      <Trayectoria companies={localizedCompanies} hoyLabel={he.trayectoriaHoy} caption={he.trayectoriaCaption} rtl={locale.rtl} />
      <p class="see-more"><a href={`/${locale.code}/trayectoria`}>{he.trayectoriaCta}</a></p>
    </div>
  </section>

  <PullQuote placement="home" locale={locale.code} />

  {projects.length > 0 && (
    <section class="chapter chapter--mist">
      <div class="container">
        <p class="eyebrow">{pl.eyebrow}</p>
        <ul class="cards">
          {
            projects.slice(0, 5).map((p: any) => (
              <li class="card project-card">
                {p.image_r2_key && (
                  <img
                    src={`/media/${p.image_r2_key}?w=600`}
                    srcset={`/media/${p.image_r2_key}?w=500 500w, /media/${p.image_r2_key}?w=800 800w, /media/${p.image_r2_key}?w=1100 1100w`}
                    sizes="(max-width: 640px) 100vw, 50vw"
                    alt={`Screenshot of ${p.name}`}
                    loading="lazy"
                    class="project-card__image"
                  />
                )}
                <div class="project-card__body">
                  {p.role && <p class="eyebrow">{t(projectsTr, p.id, "role", p.role)}</p>}
                  <h3>{p.name}</h3>
                  {p.summary && <p>{t(projectsTr, p.id, "summary", p.summary)}</p>}
                  <p>
                    <a href={p.url} target="_blank" rel="noopener">
                      {p.url.replace(/^https?:\/\//, "")}
                    </a>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="see-more"><a href={`/${locale.code}/empresas`}>→</a></p>
      </div>
    </section>
  )}

  <section class="chapter">
    <div class="container chapter--split">
      <div>
        <p class="eyebrow">{he.yucatechEyebrow}</p>
        <h2>{he.yucatechHeading}</h2>
        <p>{he.yucatechBody}</p>
        <p class="see-more"><a href={`/${locale.code}/yucatech`}>{he.yucatechCta}</a></p>
      </div>
    </div>
  </section>

  <section class="chapter faq-section">
    <div class="container">
      <p class="eyebrow">{he.faqEyebrow}</p>
      <h2>{he.faqHeading}</h2>
      <div class="faq-list">
        {he.faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="chapter chapter--mist larry-intro">
    <div class="container larry-intro__inner">
      <img src="/larry/larry-gym.webp" alt="" width="220" height="220" loading="lazy" />
      <div>
        <p class="eyebrow">{he.larryEyebrow}</p>
        <h2>Larry</h2>
        <p class="hero__sub">{he.larryBody}</p>
      </div>
    </div>
  </section>
</Site>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-4);
  }
  .hero__inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-3);
  }
  .hero__photo {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.75rem;
  }
  @media (min-width: 900px) {
    .hero__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .hero__photo {
      flex-shrink: 0;
    }
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 9vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0.3em 0 0;
  }
  .hero .spark {
    margin: var(--space-2) 0;
    max-width: 20rem;
  }
  .hero__sub {
    max-width: var(--measure);
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .see-more a {
    color: var(--ember);
    font-weight: 600;
    text-decoration: none;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
  .faq-item {
    border: 1px solid var(--line);
    padding: 0.9rem 1.1rem;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .faq-item p {
    margin: 0.75rem 0 0;
    color: var(--ink-soft);
  }

  .larry-intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .larry-intro__inner img {
    width: 9rem;
    height: 9rem;
    border-radius: 999px;
    object-fit: cover;
    border: 3px solid var(--rhino);
  }
  .larry-intro h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0.1em 0;
  }
  @media (min-width: 640px) {
    .larry-intro__inner {
      flex-direction: row;
      text-align: left;
    }
  }
</style>
