---
import Site from "../../layouts/Site.astro";
import Spark from "../../components/Spark.astro";
import PullQuote from "../../components/PullQuote.astro";
import Trayectoria from "../../components/Trayectoria.astro";
import { env } from "cloudflare:workers";
import { localeFromParam } from "../../lib/locales";
import { loadTranslations, t } from "../../lib/i18n";
import { projectsLabels } from "../../lib/nav-labels";
import { BOT_SCAN_RE, ENV_SCAN_RE, LOCALE_GUESS_RE } from "../../lib/bot-scan";

const locale = localeFromParam(Astro.params.locale);
// A single unmatched path segment (a broken link, a typo, anything) structurally matches
// this dynamic [locale] route too — it must NOT silently redirect home as if it were a
// real locale (confirmed live 2026-07-22: this swallowed every genuine 404 on the site,
// including the custom src/pages/404.astro page, which never got a chance to render).
// Only a recognized-but-canonical locale (e.g. someone typed /es-MX explicitly) should
// redirect — anything else is a real 404. A single-segment WordPress/vuln-scanner probe
// (/wp-login.php, ...) ALSO structurally matches this route (before it ever reaches
// [...slug].astro, which only sees paths this route doesn't claim) — same bot-scan checks
// as there, see src/lib/bot-scan.ts. /.env gets its own honeypot; a 2-letter locale GUESS
// this site doesn't serve (/pl/, /th/, a bare /es/) gets a different joke page too.
if (!locale) {
  if (ENV_SCAN_RE.test(Astro.url.pathname)) {
    Astro.response.status = 200;
    return Astro.rewrite("/fake-env");
  }
  if (BOT_SCAN_RE.test(Astro.url.pathname)) {
    Astro.response.status = 200;
    return Astro.rewrite("/no-wordpress");
  }
  if (LOCALE_GUESS_RE.test(Astro.params.locale ?? "")) {
    Astro.response.status = 200;
    return Astro.rewrite("/no-locale-guess");
  }
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
if (locale.canonical) return Astro.redirect("/", 302);

let profile: any = null;
let companies: any[] = [];
let projects: any[] = [];
let heroPhoto: any = null;
let profileTr = new Map<string, string>();
let companiesTr = new Map<string, string>();
let projectsTr = new Map<string, string>();

if (env?.DB) {
  const [profileRes, companiesRes, projectsRes, heroPhotoRes] = await Promise.all([
    env.DB.prepare("SELECT * FROM profile WHERE id = 1").first(),
    env.DB.prepare("SELECT * FROM companies ORDER BY sort_order").all(),
    // Same self-updating list as /empresas — only ever shows projects the weekly refresh
    // worker last confirmed reachable. See src/lib/projects-refresh.ts.
    env.DB.prepare("SELECT * FROM projects WHERE is_reachable = 1 ORDER BY sort_order").all(),
    env.DB.prepare(
      "SELECT r2_key FROM photos WHERE approval_status = 'approved' AND (solo_subject = 1 OR is_profile_photo = 1) ORDER BY RANDOM() LIMIT 1"
    ).first(),
  ]);
  profile = profileRes;
  companies = companiesRes?.results ?? [];
  projects = projectsRes?.results ?? [];
  heroPhoto = heroPhotoRes;
  [profileTr, companiesTr, projectsTr] = await Promise.all([
    loadTranslations(env.DB, "profile", locale.code),
    loadTranslations(env.DB, "companies", locale.code),
    loadTranslations(env.DB, "projects", locale.code),
  ]);
}

const bio = t(profileTr, 1, "bio_short", profile?.bio_short) ?? "25+ years building technology, companies, and teams across Latin America.";
const pl = projectsLabels(locale.code);
const localizedCompanies = companies.map((c: any) => ({
  ...c,
  role: t(companiesTr, c.id, "role", c.role),
}));

