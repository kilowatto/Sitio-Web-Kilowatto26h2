<Site
  title={`${nl.comida} — Esteban Rey`}
  description="Marquesitas tabasqueñas, tacos al pastor en El Farolito, once tipos de arroz a la paella con receta, y los restaurantes de sushi favoritos de Esteban Rey: El Japonez, Sushi Ran en Sausalito y Kunio en San Ángel."
  active="/comida"
  locale={locale.code}
  dir={locale.rtl ? "rtl" : "ltr"}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">{content.pageEyebrow}</p>
      <h1>{content.pageTitle}</h1>
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      <p class="eyebrow">{content.marquesitaEyebrow}</p>
      <img
        src="/comida/marquesita.webp"
        alt={content.marquesitaAlt}
        loading="eager"
        width="900"
        height="1600"
        class="hero-photo"
      />
      {content.marquesitaIntro.map((p) => <p class="hero__sub">{p}</p>)}
      <ul class="facts-list">
        {content.marquesitaFacts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      <p class="eyebrow">{content.amashitoEyebrow}</p>
      <img
        src="/comida/chile-amashito.webp"
        alt={content.amashitoAlt}
        loading="lazy"
        width="900"
        height="1200"
        class="hero-photo"
      />
      {content.amashitoIntro.map((p) => <p class="hero__sub">{p}</p>)}
      <ul class="facts-list">
        {content.amashitoFacts.map((f) => <li>{f}</li>)}
      </ul>
      <h3 class="recipe-heading">{content.amashitoRecipeHeading}</h3>
      <ol class="facts-list recipe-steps">
        {content.amashitoSteps.map((s) => <li>{s}</li>)}
      </ol>
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      <p class="eyebrow">{content.pastorEyebrow}</p>
      <img
        src="/comida/tacos-al-pastor.webp"
        alt={content.pastorAlt}
        loading="lazy"
        width="900"
        height="1008"
        class="hero-photo"
      />
      {content.pastorIntro.map((p) => <p class="hero__sub">{p}</p>)}
      <ul class="facts-list">
        {content.pastorFacts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      <p class="eyebrow">{content.paellaEyebrow}</p>
      <img
        src="/comida/paella-marinera.webp"
        alt={content.paellaAlt1}
        loading="lazy"
        width="1600"
        height="1200"
        class="hero-photo"
      />
      {content.paellaIntro.map((p) => <p class="hero__sub">{p}</p>)}
      <figure class="paella-detalle">
        <img
          src="/comida/paella-marinera-detalle.webp"
          alt={content.paellaAlt2}
          loading="lazy"
          width="1600"
          height="1200"
        />
        <figcaption>{content.paellaDetalleCaption}</figcaption>
      </figure>
      <ul class="facts-list">
        {content.paellaFacts.map((f) => <li>{f}</li>)}
      </ul>
      <h3 class="recipe-heading">{content.paellaRecipeHeading}</h3>
      <div class="paella-grid">
        {content.paellaTypes.map((t) => (
          <article class="paella-card">
            <h4>{t.name}</h4>
            <p>{t.description}</p>
            <p class="paella-ingredients"><strong>Ingredientes:</strong> {t.ingredients.join(", ")}.</p>
            <ol class="facts-list recipe-steps">
              {t.steps.map((s) => <li>{s}</li>)}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  {content.restaurants.map((r, i) => (
    <section class={`chapter ${i % 2 === 0 ? "chapter--mist" : ""}`}>
      <div class="container">
        <p class="eyebrow">{r.eyebrow}</p>
        <h2>{r.name}</h2>
        {r.body.map((p) => <p class="hero__sub">{p}</p>)}
