      facts: [
        "Está escondido en San Ángel, uno de los barrios más coloniales y menos \"sushi\" de la Ciudad de México — la frescura del pescado ahí compite directamente con el empedrado de las calles.",
        "Es de esos lugares que casi nadie conoce por accidente — siempre llegas porque alguien de confianza te lo recomendó primero.",
        "La discreción es casi parte del menú: ni el letrero grita, ni el lugar presume — deja que el nigiri hable solo.",
      ],
    },
  ],
  closingEyebrow: "Mi favorito de todos",
  closingHeading: "Nigiri de salmón con wasabi",
  closing: [
    "Si me preguntan cuál es mi platillo favorito de todos, sin pensarlo mucho: nigiri de salmón, con un toque de wasabi. Simple, directo, sin nada de más.",
    "Y aunque el sushi se lleve la corona, también soy fan absoluto de los poke bowls — con arroz de coliflor, salmón, atún, elote y edamame. ¿Por qué estaré gordo?",
  ],
  salmonAlt: "Dos platos de salmón: uno con caviar negro, otro estilo aguachile con jalapeño relleno",
  salmonCaption:
    "Arriba, salmón cortado fino en sashimi con una línea generosa de caviar negro encima — la sal y el estallido del caviar contra la grasa del salmón es una combinación que no falla nunca. Abajo, salmón y atún estilo aguachile, curtidos en cítrico hasta quedar casi translúcidos, coronados con rodajas de jalapeño relleno para el toque picante. Dos formas distintas de tratar el mismo pescado, y las dos ganan.",
};

// A single-element array in the source (e.g. a one-paragraph intro) sometimes comes back from
// the model as a bare string instead of a 1-item array — confirmed live on the equivalent
// avestruces page. Coerce that one specific, safe case back into shape before the strict check
// below, instead of discarding an entire good translation over it.
function normalizeShape(es: any, raw: any): any {
  if (Array.isArray(es)) {
    if (es.length === 1 && typeof raw === "string") return [raw];
    if (Array.isArray(raw)) return raw.map((item, i) => normalizeShape(es[i] ?? es[0], item));
    return raw;
  }
  if (es && typeof es === "object" && raw && typeof raw === "object") {
    const result: any = {};
    for (const k of Object.keys(es)) result[k] = normalizeShape(es[k], raw[k]);
    return result;
  }
  return raw;
}

function shapeMatches(es: any, raw: any): boolean {
  if (Array.isArray(es)) {
    return Array.isArray(raw) && raw.length === es.length && es.every((v, idx) => shapeMatches(v, raw[idx]));
  }
  if (es && typeof es === "object") {
    return raw && typeof raw === "object" && Object.keys(es).every((k) => shapeMatches(es[k], raw[k]));
  }
  return raw === null || typeof raw === "string";
}

// The 70B model occasionally drops a single closing "]" when generating a large nested
// array-of-objects blob (observed consistently on the last restaurant's "facts" array).
// JSON.parse's own error position points at the offending character — inserting "]" right
// before it repairs this exact failure mode without guessing blindly.
function parseWithBracketRepair(text: string): any {
  try {
    return JSON.parse(text);
  } catch (e) {
    const m = /position (\d+)/.exec(String((e as Error)?.message ?? e));
    if (!m) return null;
    const pos = Number(m[1]);
    try {
      return JSON.parse(text.slice(0, pos) + "]" + text.slice(pos));
    } catch {
      return null;
    }
  }
}

const CACHE_KEY = `kw:static:comida:${locale.code}:v3`;
let content = ES_CONTENT;

if (env?.KILOWATTO_KV) {
  const cached = await env.KILOWATTO_KV.get(CACHE_KEY, "json");
  if (cached) {
    content = cached as typeof ES_CONTENT;
  } else if (env?.AI) {
    const voice = VOICE_INSTRUCTIONS[locale.code] ?? `Translate to ${locale.code}.`;
    const prompt = `${voice}\n\nTraduce este objeto JSON (español mexicano) a ${locale.code}. NO traduzcas los nombres propios "El Japonez", "Sushi Ran", "Kunio", "Yoshi Tome", "Takanori Wada", "San Ángel", "Sausalito", "OpenTable Diners' Choice", "Bib Gourmand", "San Francisco Chronicle", "amashito", "amaxito", "chiltepín", "Larry", "El Farolito", "Condesa", "Insurgentes", "Pedregal", ni los términos culinarios "paella", "paellera", "arroz a la paella", "patella", "socarrat", "garrofón", "ferraura", "arroz bomba", "senia", "alioli", "arroz a banda", "arroz al horno", ni las URLs (campos "url"/"urlLabel" que empiecen con "http" o contengan un dominio) — cópialas literalmente. Mantén exactamente las mismas claves y la misma cantidad de elementos en cada arreglo. Devuelve SOLO el objeto JSON traducido, sin texto adicional ni bloques de código:\n\n${JSON.stringify(ES_CONTENT)}`;

    try {
      const result: any = await env.AI.run("@cf/meta/llama-3.3-70b-instruct-fp8-fast", {
        messages: [{ role: "user", content: prompt }],
        max_tokens: 14000,
      });
      const parsed =
        typeof result?.response === "object"
          ? result.response
          : parseWithBracketRepair(typeof result?.response === "string" ? (result.response.match(/\{[\s\S]*\}/)?.[0] ?? "null") : "null");
      const raw = parsed && typeof parsed === "object" ? normalizeShape(ES_CONTENT, parsed) : parsed;
      if (raw && typeof raw === "object" && shapeMatches(ES_CONTENT, raw)) {
        content = raw;
        await env.KILOWATTO_KV.put(CACHE_KEY, JSON.stringify(raw), { expirationTtl: 60 * 60 * 24 * 30 });
      }
    } catch {
      // fall back to Spanish silently
    }
  }
}
