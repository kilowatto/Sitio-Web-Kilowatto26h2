          <p class="see-more">
            <a href={r.url} target="_blank" rel="noopener">{r.urlLabel} →</a>
          </p>
        )}
        <ul class="facts-list">
          {r.facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </section>
  ))}

  <section class="chapter">
    <div class="container">
