// Some single-element arrays (e.g. caracaraIntro, a one-paragraph intro) come back from the
// model as a bare string instead of a 1-item array — confirmed live for Arabic, which otherwise
// translated the whole rest of the page correctly. Coerce that one specific, safe case back into
// shape before the strict check below, instead of discarding an entire good translation over it.
function normalizeShape(es: any, raw: any): any {
  if (Array.isArray(es)) {
    if (es.length === 1 && typeof raw === "string") return [raw];
    if (Array.isArray(raw)) return raw.map((item, i) => normalizeShape(es[i] ?? es[0], item));
    return raw;
  }
  if (es && typeof es === "object" && raw && typeof raw === "object") {
    const result: any = {};
    for (const k of Object.keys(es)) result[k] = normalizeShape(es[k], raw[k]);
    return result;
  }
  return raw;
}

// Recursively checks that a translated blob has the same shape (keys, array lengths) as the
// Spanish source — needed once `alts` nested an object inside the otherwise-flat content shape.
function shapeMatches(es: any, raw: any): boolean {
  if (Array.isArray(es)) {
    if (es.length > 0 && Array.isArray(es[0])) {
      return Array.isArray(raw) && raw.length === es.length;
    }
    return Array.isArray(raw) && raw.length === es.length;
  }
  if (es && typeof es === "object") {
    return raw && typeof raw === "object" && Object.keys(es).every((k) => shapeMatches(es[k], raw[k]));
  }
  return typeof raw === "string";
}

// The full ES_CONTENT object got big enough after the Mortis redesign (~26KB of JSON) that a
// single from-scratch translation call now reliably exceeds Workers AI's own request timeout
// (AiError 3046) on EVERY locale, not just occasionally — confirmed live. Splitting into several
// smaller parallel calls keeps each one comfortably under the timeout, and caching each chunk
// separately means one slow/failing chunk doesn't force a full-page re-translation next time —
// it just falls back to Spanish for that chunk's keys while the rest stays translated.
const CACHE_VERSION = "v10";
const CHUNK_COUNT = 5;

function chunkBySize<T extends Record<string, any>>(obj: T, count: number): Partial<T>[] {
  const entries = Object.entries(obj).sort((a, b) => JSON.stringify(b[1]).length - JSON.stringify(a[1]).length);
  const chunks: Partial<T>[] = Array.from({ length: count }, () => ({}) as Partial<T>);
  const sizes = new Array(count).fill(0);
  for (const [key, value] of entries) {
    let minIdx = 0;
    for (let i = 1; i < count; i++) if (sizes[i] < sizes[minIdx]) minIdx = i;
    (chunks[minIdx] as any)[key] = value;
    sizes[minIdx] += JSON.stringify(value).length;
  }
  return chunks;
}

let content: typeof ES_CONTENT = { ...ES_CONTENT };

if (env?.KILOWATTO_KV) {
  const voice = VOICE_INSTRUCTIONS[locale.code] ?? `Translate to ${locale.code}.`;
  const chunks = chunkBySize(ES_CONTENT, CHUNK_COUNT);

  await Promise.all(
    chunks.map(async (chunk, i) => {
      const chunkKey = `kw:static:avestruces:${locale.code}:${CACHE_VERSION}:c${i}`;
      const cached = await env.KILOWATTO_KV!.get(chunkKey, "json");
      if (cached) {
        Object.assign(content, cached);
        return;
      }
      if (!env?.AI) return;
      try {
        const result: any = await env.AI.run("@cf/meta/llama-3.3-70b-instruct-fp8-fast", {
          messages: [
            {
              role: "user",
              content: `${voice}\n\nTraduce este objeto JSON (español mexicano) a ${locale.code}. No traduzcas los nombres propios "Luke", "Leia", "Yoda", "Red Leader", "Red Two", "Qui-Gon Jinn", "Ezra", "Zeb", "Sabine", "Hera", "Jacen", "Plo Koon" ni "Morai". Mantén los tokens literales "{{AGE}}" y "{{OWL}}" exactamente iguales, sin traducirlos ni moverlos de posición dentro de su oración. Mantén exactamente las mismas claves y la misma cantidad de elementos en cada arreglo. Devuelve SOLO el objeto JSON traducido, sin texto adicional:\n\n${JSON.stringify(chunk)}`,
            },
          ],
          max_tokens: 4500,
        });
        const parsed =
          typeof result?.response === "object"
            ? result.response
            : parseJsonWithBracketRepair(result?.response?.match(/\{[\s\S]*\}/)?.[0] ?? "null");
        const raw = parsed && typeof parsed === "object" ? normalizeShape(chunk, parsed) : parsed;
        if (raw && typeof raw === "object" && shapeMatches(chunk, raw)) {
          Object.assign(content, raw);
          await env.KILOWATTO_KV!.put(chunkKey, JSON.stringify(raw), { expirationTtl: 60 * 60 * 24 * 30 });
        }
        // Shape mismatch: leave this chunk's keys at their ES_CONTENT default (already in `content`).
      } catch {
        // Includes AiError 3046 (request timeout) on just this chunk — falls back to Spanish for
        // only these keys, not the whole page.
      }
    })
  );
}

const age = formatAge(locale.code);
const introWithAge = content.intro.map((p) => p.replace("{{AGE}}", age));
