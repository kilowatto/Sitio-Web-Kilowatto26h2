  en: [["year", "years"], ["month", "months"], ["day", "days"], ["hour", "hours"], ["min", "min"], ["sec", "sec"]],
  "pt-BR": [["ano", "anos"], ["mês", "meses"], ["dia", "dias"], ["hora", "horas"], ["min", "min"], ["seg", "seg"]],
  fr: [["an", "ans"], ["mois", "mois"], ["jour", "jours"], ["heure", "heures"], ["min", "min"], ["sec", "sec"]],
