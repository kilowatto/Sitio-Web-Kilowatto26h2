  <script define:vars={{ jacenLabels, jacenAnd: JACEN_AND }}>
    function breakdown(birth, now) {
      let years = now.getUTCFullYear() - birth.getUTCFullYear();
      let months = now.getUTCMonth() - birth.getUTCMonth();
      let anchor = new Date(
        Date.UTC(birth.getUTCFullYear() + years, birth.getUTCMonth() + months, birth.getUTCDate(), birth.getUTCHours(), birth.getUTCMinutes(), birth.getUTCSeconds())
      );
      if (anchor.getTime() > now.getTime()) {
        months -= 1;
        if (months < 0) {
          months = 11;
          years -= 1;
        }
        anchor = new Date(
          Date.UTC(birth.getUTCFullYear() + years, birth.getUTCMonth() + months, birth.getUTCDate(), birth.getUTCHours(), birth.getUTCMinutes(), birth.getUTCSeconds())
        );
      }
      let rest = now.getTime() - anchor.getTime();
      const days = Math.floor(rest / 86_400_000);
      rest -= days * 86_400_000;
      const hours = Math.floor(rest / 3_600_000);
      rest -= hours * 3_600_000;
      const minutes = Math.floor(rest / 60_000);
      rest -= minutes * 60_000;
      const seconds = Math.floor(rest / 1000);
      return [years, months, days, hours, minutes, seconds];
    }

    function render(el, birth) {
      const values = breakdown(birth, new Date());
      let started = false;
      const parts = [];
      values.forEach((v, i) => {
        if (!started && v === 0 && i < values.length - 1) return;
        started = true;
        const [one, many] = jacenLabels[i];
        const unit = v === 1 ? one : many;
        parts.push(unit ? `${v} ${unit}` : `${v}`);
      });
      const text = parts.length > 1 ? `${parts.slice(0, -1).join(", ")} ${jacenAnd} ${parts[parts.length - 1]}`.replace(/\s+/g, " ").trim() : parts[0];
      el.textContent = text;
    }

    const el = document.getElementById("jacen-age");
    const birthAttr = el?.dataset.birth;
    if (el && birthAttr) {
      const birth = new Date(birthAttr);
      render(el, birth);
      setInterval(() => render(el, birth), 1000);
    }
  </script>

  <script>
    // Scroll-scrubbed hero: a tall sticky section maps scroll progress to a frame index in an
    // image sequence, drawn to a <canvas>. History here (see git log on the root /avestruces.astro
    // this was ported from): a first pass used exactly this technique but blocked canvas readiness
    // on nothing and preloaded all 50 frames in one blind loop — the failure mode on real mobile
    // connections was frames arriving too slowly to keep up with scroll, not a flaw in the
    // image-sequence idea itself. A second pass switched to a single scrubbed <video>, which fixed
    // the loading-speed problem but traded it for three separate real bugs, each confirmed live: no
    // Range support meant `seekable` reported [0,0] forever; sparse keyframes made arbitrary seeks
    // slow; and Chrome's power-saving policy can flat-out reject the muted "prime" autoplay
    // (`AbortError: video-only background media was paused to save power`) with no fallback. Images
    // have none of those failure modes — no autoplay policy, no seek/keyframe mechanics — so this
    // reverts to an image sequence, fixing the ORIGINAL problem instead: frames are served via
    // Cloudflare Images (AVIF/WebP negotiated per Accept header), and drawing always uses the
    // nearest already-loaded frame rather than freezing on a stale one while the target frame is
    // still in flight. The <img> fallback is the DEFAULT rendered state — this script only hides it
    // once the canvas has a real first frame to show.
    (() => {
      const heroSection = document.getElementById("scrub-hero") as HTMLElement | null;
      const canvas = document.getElementById("scrub-canvas") as HTMLCanvasElement | null;
      const fallback = document.getElementById("scrub-fallback") as HTMLImageElement | null;
      const overlay = document.getElementById("scrub-overlay") as HTMLElement | null;
      if (!heroSection || !canvas || !fallback) return;

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const conn = (navigator as any).connection;
      const dataSaverOn = !!(conn && (conn.saveData || /^(slow-2g|2g)$/.test(conn.effectiveType ?? "")));
      if (prefersReducedMotion || dataSaverOn) return; // keep the static fallback exactly as rendered

      const frameCount = Number(heroSection.dataset.frameCount ?? "0");
      const frameBase = heroSection.dataset.frameBase ?? "";
      const frameWidth = heroSection.dataset.frameWidth ?? "900";
      if (!frameCount) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      function frameUrl(i: number) {
        return `${frameBase}${String(i + 1).padStart(3, "0")}.jpg?w=${frameWidth}`;
      }

      const images: HTMLImageElement[] = new Array(frameCount);
      const requested: boolean[] = new Array(frameCount).fill(false);
      let loadedCount = 0;

      function requestFrame(i: number) {
        if (i < 0 || i >= frameCount || requested[i]) return;
        requested[i] = true;
        const img = new Image();
        img.src = frameUrl(i);
        img.onload = () => {
          loadedCount++;
        };
        images[i] = img;
      }

      function isLoaded(i: number): boolean {
        const img = images[i];
        return !!img && img.complete && img.naturalWidth > 0;
      }

      // Background queue for everything else, capped concurrency-by-order (the browser already
      // limits real concurrent connections per host; this just keeps request order sane so early
      // frames — the ones a visitor reaches first — tend to arrive first).
      function fillQueue() {
        for (let i = 0; i < frameCount; i++) requestFrame(i);
      }

      function sizeCanvas() {
        if (!canvas) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
      }

      function drawImage(img: HTMLImageElement) {
        if (!ctx || !canvas) return;
        const cw = canvas.width;
        const ch = canvas.height;
        const ir = img.naturalWidth / img.naturalHeight;
        const cr = cw / ch;
        let dw = cw;
        let dh = ch;
        if (ir > cr) {
          dh = ch;
          dw = ch * ir;
        } else {
          dw = cw;
          dh = cw / ir;
        }
        const dx = (cw - dw) / 2;
        const dy = (ch - dh) / 2;
        ctx.clearRect(0, 0, cw, ch);
        ctx.drawImage(img, dx, dy, dw, dh);
      }

      let displayedFrame = -1;

      // If the exact target frame hasn't arrived yet, show the nearest one that HAS — a fast
      // scroll on a slow connection then advances in visible (if slightly coarse) steps instead of
      // freezing dead on whatever loaded first until the exact target finally shows up.
      function draw(target: number) {
        requestFrame(target);
        if (isLoaded(target)) {
          if (target !== displayedFrame) {
            drawImage(images[target]);
            displayedFrame = target;
          }
          return;
        }
        for (let radius = 1; radius < frameCount; radius++) {
          const before = target - radius;
          const after = target + radius;
          if (before >= 0 && isLoaded(before)) {
            if (before !== displayedFrame) {
              drawImage(images[before]);
              displayedFrame = before;
            }
            return;
          }
          if (after < frameCount && isLoaded(after)) {
            if (after !== displayedFrame) {
              drawImage(images[after]);
              displayedFrame = after;
            }
            return;
          }
          if (before < 0 && after >= frameCount) break;
        }
      }

      let currentFrame = 0;
      let ticking = false;

      function frameForScroll(): number {
        const rect = heroSection!.getBoundingClientRect();
        const total = heroSection!.offsetHeight - window.innerHeight;
        const scrolled = -rect.top;
        const progress = Math.min(1, Math.max(0, total > 0 ? scrolled / total : 0));
        return Math.min(frameCount - 1, Math.floor(progress * frameCount));
      }

      // Short phrases that take over from the title once it's faded, each with its own
      // entrance/exit style and its own [start, end] slice of overall scroll progress (see the
      // data-start/data-end/data-effect attributes on each .scrub-phrase in the markup). Within a
      // phrase's own window, the first quarter is its entrance, the last quarter its exit, and the
      // middle half is a hold — except "letters", which staggers each character's own reveal
      // across the first 60% of the window instead of moving the whole line at once.
      const phraseEls = Array.from(document.querySelectorAll<HTMLElement>(".scrub-phrase"));
      for (const el of phraseEls) {
        if (el.dataset.effect !== "letters") continue;
        const text = el.textContent ?? "";
        el.textContent = "";
        for (const ch of text) {
          const span = document.createElement("span");
          span.className = "letter";
          span.textContent = ch === " " ? " " : ch;
          el.appendChild(span);
        }
      }

      function updatePhrases(progress: number) {
        for (const el of phraseEls) {
          const start = parseFloat(el.dataset.start ?? "0");
          const end = parseFloat(el.dataset.end ?? "1");
          const span = end - start;
          if (progress < start || progress > end || span <= 0) {
            el.style.opacity = "0";
            continue;
          }
          const local = (progress - start) / span;
          const inT = Math.min(1, local / 0.25);
          const outT = Math.min(1, Math.max(0, (local - 0.75) / 0.25));
          const visibility = Math.min(inT, 1 - outT);
          const effect = el.dataset.effect;

          // Non-letters phrases are vertically centered via "top: 50%" in CSS (see the comment
          // there on why they aren't flex-centered), so every transform here carries that
          // translateY(-50%) base alongside its own effect-specific offset.
          if (effect === "slide-left") {
            el.style.opacity = String(visibility);
            el.style.transform = `translateY(-50%) translateX(${(1 - inT) * 40 - outT * 40}px)`;
          } else if (effect === "scale") {
            const scale = Math.max(0.4, 0.5 + 0.5 * inT - 0.5 * outT);
            el.style.opacity = String(visibility);
            el.style.transform = `translateY(-50%) scale(${scale})`;
          } else if (effect === "letters") {
            el.style.opacity = "1";
            el.style.transform = "none";
            const letters = el.querySelectorAll<HTMLElement>(".letter");
            letters.forEach((letter, i) => {
              const letterStart = (i / letters.length) * 0.6;
              const letterLocal = Math.min(1, Math.max(0, (local - letterStart) / 0.15));
              const letterVisible = Math.max(0, letterLocal - outT);
              letter.style.opacity = String(letterVisible);
              letter.style.transform = `translateY(${(1 - letterLocal) * 0.3}em)`;
            });
          } else {
            el.style.opacity = String(visibility);
            el.style.transform = "translateY(-50%)";
          }
        }
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          currentFrame = frameForScroll();
          draw(currentFrame);
          // Also warm the next couple of frames in the scroll direction so continued scrolling
          // (not just the current position) tends to already have its frame ready.
          requestFrame(currentFrame + 1);
          requestFrame(currentFrame + 2);

          const rect = heroSection!.getBoundingClientRect();
          const total = heroSection!.offsetHeight - window.innerHeight;
          const progress = Math.min(1, Math.max(0, total > 0 ? -rect.top / total : 0));

          // Parallax + fade for the title overlay — gone by ~35% into the scrub so it doesn't
          // fight with the peck-zoom moment.
          if (overlay) {
            const fade = Math.max(0, 1 - progress / 0.35);
            overlay.style.opacity = String(fade);
            overlay.style.transform = `translateY(${(1 - fade) * -24}px)`;
          }
          updatePhrases(progress);
          ticking = false;
        });
      }

      // Only swap in the canvas once the first frame has actually decoded — otherwise a slow
      // connection would show a blank canvas over the (already-visible) fallback image.
      const first = new Image();
      requested[0] = true;
      images[0] = first;
      first.src = frameUrl(0);
      first.decode?.()
        .catch(() => {})
        .finally(() => {
          sizeCanvas();
          draw(0);
          canvas.classList.add("is-ready");
          fallback!.setAttribute("aria-hidden", "true");
          fillQueue();
        });

      window.addEventListener("resize", sizeCanvas);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    })();

    // Scroll-reveal: fade/slide sections in as they enter view. Only applied when the visitor
    // hasn't asked for reduced motion — see the CSS, which keeps .reveal at full opacity by
    // default and only introduces the hidden starting state inside a
    // prefers-reduced-motion:no-preference query, so this script is a pure enhancement.
    //
    // Plain scroll+rAF instead of IntersectionObserver — confirmed live that Chrome fully
    // suppresses IntersectionObserver callbacks while document.hidden is true (e.g. a
    // backgrounded tab), which would leave sections stuck invisible. A scroll listener has no
    // such dependency and degrades gracefully either way.
    (() => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const targets = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
      if (targets.length === 0) return;
      let remaining = targets.slice();
      let ticking = false;

      function checkTargets() {
        const vh = window.innerHeight;
        remaining = remaining.filter((el) => {
          const rect = el.getBoundingClientRect();
          const visible = rect.top < vh * 0.92 && rect.bottom > 0;
          if (visible) el.classList.add("is-visible");
          return !visible;
        });
        if (remaining.length === 0) {
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
        }
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          checkTargets();
          ticking = false;
        });
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      checkTargets();
    })();
  </script>

  <script>
    // Jedi ID cards: click, or Enter/Space, flips the card between photo and rank/facts. Plain
    // CSS 3D transform (rotateY + preserve-3d), no library.
    //
    // This is a role="button" div, not a real <button> — the back face can hold a real <a> link
    // out to StarWars.com/Wikipedia, and an <a> nested inside a <button> is invalid HTML (browsers
    // and screen readers handle nested interactive controls unpredictably). The link's own click
    // handler stops propagation so following it doesn't also toggle the flip.
    (() => {
      const cards = document.querySelectorAll<HTMLElement>(".jedi-card");
      cards.forEach((card) => {
        function flip() {
          const flipped = card.classList.toggle("is-flipped");
          card.setAttribute("aria-pressed", String(flipped));
        }
        card.addEventListener("click", flip);
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            flip();
          }
        });
        card.querySelectorAll<HTMLAnchorElement>(".jedi-card__link").forEach((link) => {
          link.addEventListener("click", (e) => e.stopPropagation());
        });
      });
    })();

    // Shared lightbox: every .bento-tile AND every .gallery-video on the page shares ONE gallery,
    // in document order (top to bottom, across every animal's section) — not scoped per animal —
    // so swiping from a photo keeps going into the next section's photos and videos. Clicking a
    // video plays it in place as always (unchanged); it only joins the lightbox sequence so
    // swiping past its position from a neighboring photo reaches it. ← → arrows, keyboard, and a
    // real drag-following swipe, via the native <dialog> element (focus trap and Escape-to-close
    // come free, no library needed).
    //
    // The swipe is a 3-slide track (prev/current/next side by side), not a start/end position
    // check: on pointerdown the track stops transitioning and follows the finger 1:1 via
    // pointermove, so the adjacent photo is already visible sliding in from the side — confirmed
    // live on a real phone that a release-only check (no visual feedback during the drag, and no
    // touch-action set) made the browser spend the first touch deciding whether it was a scroll
    // or a custom gesture, so it needed two tries. Claiming touch-action: pan-y on the container
    // fixes that; the live drag-follow is what makes it feel like "moving the photo".
    (() => {
      type MediaItem =
        | { type: "image"; src: string; alt: string }
        | { type: "video"; poster: string; videoSrc: string; alt: string };

      const dialog = document.getElementById("galleryLightbox") as HTMLDialogElement | null;
      const inner = document.getElementById("glInner") as HTMLElement | null;
      const track = document.getElementById("glTrack") as HTMLElement | null;
      const slidePrev = document.getElementById("glSlidePrev") as HTMLElement | null;
      const slideCurrent = document.getElementById("glSlideCurrent") as HTMLElement | null;
      const slideNext = document.getElementById("glSlideNext") as HTMLElement | null;
      const glCaption = document.getElementById("glCaption");
      const glCounter = document.getElementById("glCounter");
      const glPrev = document.getElementById("glPrev");
      const glNext = document.getElementById("glNext");
      const glClose = document.getElementById("glClose");
      if (!dialog || !inner || !track || !slidePrev || !slideCurrent || !slideNext || !glCaption || !glCounter || !glPrev || !glNext || !glClose) return;

      const mediaItems: MediaItem[] = [];
      let currentIndex = 0;

      function at(i: number) {
        const len = mediaItems.length;
        return mediaItems[((i % len) + len) % len];
      }

      function slideMarkup(item: MediaItem) {
        if (item.type === "video") {
          return `<img src="${item.poster}" alt="${item.alt}" /><button class="gl-play" type="button" aria-label="Reproducir video">▶</button>`;
        }
        return `<img src="${item.src}" alt="${item.alt}" />`;
      }

      function renderSlides() {
        const prev = at(currentIndex - 1);
        const cur = at(currentIndex);
        const next = at(currentIndex + 1);
        slidePrev!.innerHTML = slideMarkup(prev);
        slideCurrent!.innerHTML = slideMarkup(cur);
        slideNext!.innerHTML = slideMarkup(next);
        glCaption!.textContent = cur.alt;
        glCounter!.textContent = `${currentIndex + 1} / ${mediaItems.length}`;
        if (cur.type === "video") {
          slideCurrent!.querySelector(".gl-play")?.addEventListener(
            "click",
            () => {
              slideCurrent!.innerHTML = `<video controls autoplay playsinline src="${cur.videoSrc}"></video>`;
            },
            { once: true }
          );
        }
      }

      function resetTrackPosition() {
        track!.classList.remove("is-settling", "is-dragging");
        track!.style.transform = "translateX(-33.3333%)";
      }

      // transitionend is the normal completion signal, but it's not guaranteed to fire (a
      // backgrounded/throttled tab, an interrupted transition, or any number of edge cases can
      // swallow it) — runOnce() below also arms a timeout slightly longer than the transition
      // itself, so the swipe/arrow/keyboard navigation always completes instead of occasionally
      // getting stuck mid-slide with no way to tell whether it's "still animating" or just dead.
      function runOnce(fn: () => void) {
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          track!.removeEventListener("transitionend", onEnd);
          clearTimeout(timer);
          fn();
        };
        const onEnd = () => finish();
        track!.addEventListener("transitionend", onEnd, { once: true });
        const timer = setTimeout(finish, 400);
      }

      function goTo(index: number, dir: 1 | -1) {
        track!.classList.remove("is-dragging");
        track!.classList.add("is-settling");
        track!.style.transform = `translateX(${dir === 1 ? -66.6666 : 0}%)`;
        runOnce(() => {
          currentIndex = index;
          renderSlides();
          resetTrackPosition();
        });
      }

      function snapBack() {
        track!.classList.remove("is-dragging");
        track!.classList.add("is-settling");
        track!.style.transform = "translateX(-33.3333%)";
        runOnce(() => {
          track!.classList.remove("is-settling");
        });
      }

      document.querySelectorAll<HTMLElement>(".bento-tile, .gallery-video").forEach((el) => {
        if (el.classList.contains("bento-tile")) {
          const img = el.querySelector("img");
          if (!img) return;
          const idx = mediaItems.length;
          mediaItems.push({ type: "image", src: img.src, alt: img.alt });
          el.addEventListener("click", () => {
            currentIndex = idx;
            resetTrackPosition();
            renderSlides();
            dialog.showModal();
          });
        } else {
          const video = el as HTMLVideoElement;
          const source = video.querySelector("source");
          mediaItems.push({
            type: "video",
            poster: video.getAttribute("poster") ?? "",
            videoSrc: source?.getAttribute("src") ?? "",
            alt: video.dataset.alt ?? "",
          });
        }
      });

      glPrev.addEventListener("click", () => goTo((currentIndex - 1 + mediaItems.length) % mediaItems.length, -1));
      glNext.addEventListener("click", () => goTo((currentIndex + 1) % mediaItems.length, 1));
      glClose.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") goTo((currentIndex - 1 + mediaItems.length) % mediaItems.length, -1);
        if (e.key === "ArrowRight") goTo((currentIndex + 1) % mediaItems.length, 1);
      });

      let dragging = false;
      let dragStartX = 0;
      let containerWidth = 0;

      track.addEventListener("pointerdown", (e) => {
        dragging = true;
        dragStartX = e.clientX;
        containerWidth = inner!.getBoundingClientRect().width;
        track!.classList.add("is-dragging");
        track!.classList.remove("is-settling");
        track!.setPointerCapture(e.pointerId);
      });
      track.addEventListener("pointermove", (e) => {
        if (!dragging || !containerWidth) return;
        const dx = e.clientX - dragStartX;
        const dragPercent = (dx / containerWidth) * 33.3333;
        track!.style.transform = `translateX(${-33.3333 + dragPercent}%)`;
      });
      function endDrag(e: PointerEvent) {
        if (!dragging) return;
        dragging = false;
        const dx = e.clientX - dragStartX;
        const threshold = containerWidth * 0.18;
        if (dx <= -threshold) goTo((currentIndex + 1) % mediaItems.length, 1);
        else if (dx >= threshold) goTo((currentIndex - 1 + mediaItems.length) % mediaItems.length, -1);
        else snapBack();
      }
      track.addEventListener("pointerup", endDrag);
      track.addEventListener("pointercancel", endDrag);
    })();
  </script>
</Site>

