---
import Site from "../../layouts/Site.astro";
import { localeFromParam, VOICE_INSTRUCTIONS } from "../../lib/locales";
import { formatAge } from "../../lib/pet-age";
import { parseJsonWithBracketRepair } from "../../lib/ai-json-repair";
import { navLabels } from "../../lib/nav-labels";
import { env } from "cloudflare:workers";

const locale = localeFromParam(Astro.params.locale);
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
if (locale.canonical) return Astro.redirect("/avestruces", 302);
const nl = navLabels(locale.code);

// Fixed external URLs — never sent through AI translation (would risk corruption of the hrefs).
const LINKS: Record<string, { href: string; kind: "starwars" | "wikipedia" }> = {
  luke: { href: "https://en.wikipedia.org/wiki/Luke_Skywalker", kind: "wikipedia" },
  leia: { href: "https://en.wikipedia.org/wiki/Princess_Leia", kind: "wikipedia" },
  yoda: { href: "https://www.starwars.com/databank/yoda", kind: "starwars" },
  hera: { href: "https://www.starwars.com/databank/hera-syndulla", kind: "starwars" },
  quiGon: { href: "https://www.starwars.com/databank/qui-gon-jinn", kind: "starwars" },
  plokoon: { href: "https://www.starwars.com/databank/plo-koon", kind: "starwars" },
  father: { href: "https://www.starwars.com/databank/father", kind: "starwars" },
  daughter: { href: "https://www.starwars.com/databank/daughter", kind: "starwars" },
  son: { href: "https://www.starwars.com/databank/son", kind: "starwars" },
};
const MORAI_URL = "https://www.starwars.com/databank/morai";

// Fixed UTC-6 — central Mexico dropped seasonal DST nationwide in 2022.
const JACEN_BIRTH_ISO = "2026-07-27T00:23:00-06:00";
const JACEN_UNIT_LABELS: Record<string, [string, string][]> = {
