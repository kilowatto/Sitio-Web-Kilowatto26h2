---
import Site from "../../layouts/Site.astro";
import PullQuote from "../../components/PullQuote.astro";
import { env } from "cloudflare:workers";
import { localeFromParam } from "../../lib/locales";
import { loadTranslations, t } from "../../lib/i18n";
import { navLabels } from "../../lib/nav-labels";

const locale = localeFromParam(Astro.params.locale);
// See src/pages/[locale]/index.astro for why this is split — an unrecognized single path
// segment must 404, not silently redirect home as if it were a locale.
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
if (locale.canonical) return Astro.redirect("/trayectoria", 302);
const nl = navLabels(locale.code);

let timeline: any[] = [];
let tr = new Map<string, string>();
if (env?.DB) {
  const res = await env.DB.prepare("SELECT * FROM timeline_events ORDER BY event_date").all();
  timeline = res?.results ?? [];
  tr = await loadTranslations(env.DB, "timeline_events", locale.code);
}
---

<Site
  title={`${nl.trayectoria} — Esteban Rey`}
  description="La trayectoria completa de Esteban Rey (Kilowatto): de configurar firewalls a los 16 años a fundar Ignia Cloud, con más de 25 años en tecnología."
  active="/trayectoria"
  locale={locale.code}
  dir={locale.rtl ? "rtl" : "ltr"}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Trayectoria</p>
      <h1>Kilowatto</h1>
    </div>
  </section>
  <PullQuote placement="trayectoria" locale={locale.code} />
  <section class="chapter">
    <div class="container">
      <ol class="rows">
        {
          timeline.map((ev: any) => (
            <li class="row">
              <span class="row__range">{ev.event_date}</span>
              <div>
                <h3>{t(tr, ev.id, "title", ev.title)}</h3>
                {ev.description && <p class="row__summary">{t(tr, ev.id, "description", ev.description)}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Site>
