---
import Site from "../../layouts/Site.astro";
import { localeFromParam } from "../../lib/locales";
import { navLabels } from "../../lib/nav-labels";
import { loadTranslations, t } from "../../lib/i18n";
import { env } from "cloudflare:workers";

const locale = localeFromParam(Astro.params.locale);
// See src/pages/[locale]/index.astro for why this is split — an unrecognized single path
// segment must 404, not silently redirect home as if it were a locale.
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
if (locale.canonical) return Astro.redirect("/prensa", 302);
const nl = navLabels(locale.code);

let mentions: any[] = [];
let mentionsTr = new Map<string, string>();
if (env?.DB) {
  const res = await env.DB
    .prepare("SELECT * FROM press_mentions WHERE status = 'published' ORDER BY published_at DESC")
    .all();
  mentions = res?.results ?? [];
  mentionsTr = await loadTranslations(env.DB, "press_mentions", locale.code);
}

const EMPTY_STATE: Record<string, string> = {
  en: "Coming soon — the Workflow that checks the press every 6 hours isn't active yet. Once it is, every new mention will appear here with a summary and the original source.",
  "pt-BR": "Em breve — o Workflow que verifica a imprensa a cada 6 horas ainda não está ativo. Quando estiver, cada nova menção aparecerá aqui com um resumo e a fonte original.",
  fr: "Bientôt disponible — le Workflow qui vérifie la presse toutes les 6 heures n'est pas encore actif. Une fois actif, chaque nouvelle mention apparaîtra ici avec un résumé et la source originale.",
  de: "Demnächst — der Workflow, der alle 6 Stunden die Presse prüft, ist noch nicht aktiv. Sobald er es ist, erscheint hier jede neue Erwähnung mit einer Zusammenfassung und der Originalquelle.",
  ar: "قريباً — سير العمل الذي يتحقق من الصحافة كل 6 ساعات لم يتم تفعيله بعد. بمجرد تفعيله، سيظهر هنا كل ذكر جديد مع ملخص والمصدر الأصلي.",
  "zh-Hans": "即将推出 — 每6小时检查新闻的自动化流程尚未激活。激活后，每条新提及都会在此显示摘要和原始来源。",
  ja: "近日公開 — 6時間ごとにプレスをチェックするワークフローはまだ有効になっていません。有効になると、新しい言及が要約と元のソースとともにここに表示されます。",
};
const emptyState = EMPTY_STATE[locale.code] ?? "Próximamente — el pipeline de noticias se activa en la siguiente fase.";
---

<Site
  title={`${nl.prensa} — Kilowatto`}
  description="Menciones de prensa sobre Esteban Rey (Kilowatto), Ignia Cloud, Yucatech Festival y sus demás proyectos."
  active="/prensa"
  locale={locale.code}
  dir={locale.rtl ? "rtl" : "ltr"}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Kilowatto</p>
      <h1>{nl.prensa}</h1>
    </div>
  </section>
  <section class="chapter">
    <div class="container">
      {
        mentions.length === 0 ? (
          <p class="hero__sub">{emptyState}</p>
        ) : (
          <ol class="rows">
            {mentions.map((m: any) => (
              <li class="row">
                <span class="row__range">{m.published_at}</span>
                <div class="press-item">
                  {m.thumbnail_url && (
                    <a href={`/api/press/${m.id}/click`} target="_blank" rel="noopener" class="press-thumb-link">
                      <img src={m.thumbnail_url} alt="" class="press-thumb" loading="lazy" />
                    </a>
                  )}
                  <div class="press-item__text">
                    <h3>
                      <a href={`/api/press/${m.id}/click`} target="_blank" rel="noopener">
                        {t(mentionsTr, m.id, "title", m.title)}
                      </a>
                    </h3>
                    {m.summary && <p class="row__summary">{t(mentionsTr, m.id, "summary", m.summary)}</p>}
                    <p class="row__summary">
                      <a href={`/api/press/${m.id}/click`} target="_blank" rel="noopener">
                        {m.outlet}
                      </a>
                    </p>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Site>

<style>
  .press-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .press-item__text {
    min-width: 0;
    flex: 1;
  }
  .press-thumb-link {
    flex-shrink: 0;
    display: block;
  }
  .press-thumb {
    width: 6.5rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.5rem;
  }
  @media (min-width: 480px) {
    .press-thumb { width: 9rem; }
  }
  @media (min-width: 720px) {
    .press-thumb { width: 11rem; }
  }
</style>
