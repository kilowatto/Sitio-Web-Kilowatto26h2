---
import Site from "../../layouts/Site.astro";
import PullQuote from "../../components/PullQuote.astro";
import { env } from "cloudflare:workers";
import { localeFromParam } from "../../lib/locales";
import { loadTranslations, t } from "../../lib/i18n";

const locale = localeFromParam(Astro.params.locale);
// See src/pages/[locale]/index.astro for why this is split — an unrecognized single path
// segment must 404, not silently redirect home as if it were a locale.
if (!locale) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
if (locale.canonical) return Astro.redirect("/inversiones", 302);

let investments: any[] = [];
let tr = new Map<string, string>();
if (env?.DB) {
  const res = await env.DB.prepare("SELECT * FROM investments ORDER BY sort_order").all();
  investments = res?.results ?? [];
  tr = await loadTranslations(env.DB, "investments", locale.code);
}
const rest = investments.filter((i: any) => i.slug !== "orange-rhino-investments");
---

<Site
  title="Orange Rhino Investments"
  description="Orange Rhino Investments: el vehículo de inversión de Esteban Rey (Kilowatto)."
  active="/inversiones"
  locale={locale.code}
  dir={locale.rtl ? "rtl" : "ltr"}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Orange Rhino Investments</p>
      <h1>Kilowatto</h1>
    </div>
  </section>
  <PullQuote placement="inversiones" locale={locale.code} />
  <section class="chapter">
    <div class="container">
      <ul class="cards">
        {
          rest.map((i: any) => (
            <li class="card">
              <p class="eyebrow">{i.category}</p>
              <h3>{i.name}</h3>
              {i.summary && <p>{t(tr, i.id, "summary", i.summary)}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Site>
