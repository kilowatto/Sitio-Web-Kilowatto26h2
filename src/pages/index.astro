---
import Site from "../layouts/Site.astro";
import Spark from "../components/Spark.astro";
import PullQuote from "../components/PullQuote.astro";
import Trayectoria from "../components/Trayectoria.astro";
import PodcastLinks from "../components/PodcastLinks.astro";
import { env } from "cloudflare:workers";

let profile = null;
let companies: any[] = [];
let projects: any[] = [];
let heroPhoto: any = null;
let podcast: any = null;

if (env?.DB) {
  // Podcast counts for the homepage section. Cheap aggregate, and it keeps the copy honest --
  // "26 episodios" written by hand would be wrong the week after the next one ships.
  const podcastRes = await env.DB.prepare(
    `SELECT COUNT(*) AS n, CAST(SUM(duration_s) / 60 AS INT) AS minutes,
            SUM(CASE WHEN kind = 'audio_dialogue' THEN 1 ELSE 0 END) AS conversations
       FROM media_assets
      WHERE kind IN ('audio_narration','audio_dialogue') AND status = 'ready' AND locale = 'es-MX'`
  ).first<any>();

  const [profileRes, companiesRes, projectsRes, heroPhotoRes] = await Promise.all([
    env.DB.prepare("SELECT * FROM profile WHERE id = 1").first(),
    env.DB.prepare("SELECT * FROM companies ORDER BY sort_order").all(),
    // Same self-updating list as /empresas — only ever shows projects the weekly refresh
    // worker last confirmed reachable. See src/lib/projects-refresh.ts.
    env.DB.prepare("SELECT * FROM projects WHERE is_reachable = 1 ORDER BY sort_order").all(),
    env.DB.prepare(
      "SELECT r2_key FROM photos WHERE approval_status = 'approved' AND (solo_subject = 1 OR is_profile_photo = 1) ORDER BY RANDOM() LIMIT 1"
    ).first(),
  ]);
  profile = profileRes;
  companies = companiesRes?.results ?? [];
  projects = projectsRes?.results ?? [];
  heroPhoto = heroPhotoRes;
  podcast = podcastRes;
}
---

<Site
  title="Esteban Rey — Kilowatto"
  description="Esteban Rey (Kilowatto) — arquitecto de sistemas, CEO de Ignia Cloud, fundador del Yucatech Festival e inversionista serial en Orange Rhino Investments."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Esteban Rey",
    "alternateName": ["Kilowatto", "Esteban Rey Ortega"],
    "url": "https://kilowatto.com",
    "jobTitle": "CEO",
    "worksFor": { "@type": "Organization", "name": "Ignia Cloud" },
    // Wikidata entity created 2026-07-23 (Q140672978) — this is the single strongest signal
    // for Google's Knowledge Graph to disambiguate him from the same-named Venezuelan singer.
    // Real LinkedIn URL confirmed by Esteban 2026-07-25.
    "sameAs": ["https://x.com/kilowatto", "https://www.wikidata.org/wiki/Q140672978", "https://www.linkedin.com/in/kilowatto/"],
    "description": profile?.bio_short ?? undefined,
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Ignia Cloud",
    "founder": { "@type": "Person", "name": "Esteban Rey" },
    "url": "https://kilowatto.com/empresas",
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Kilowatto",
    "url": "https://kilowatto.com",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://www.google.com/search?q=site:kilowatto.com+{search_term_string}",
      "query-input": "required name=search_term_string",
    },
  })} />

  {/* Explicit disambiguation signal for Google/AI Overviews — a same-named Venezuelan
      singer-songwriter otherwise dominates the bare "Esteban Rey" query. */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "¿Quién es Esteban Rey (Kilowatto)?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Esteban Rey Ortega, conocido en la industria tecnológica como \"Kilowatto\", es un arquitecto de sistemas, CEO e inversionista serial mexicano con más de 25 años de trayectoria. Es fundador y CEO de Ignia Cloud, fundador del Yucatech Festival en Mérida, y opera Orange Rhino Investments, con participación en Cereza y DeSiCi.",
        },
      },
      {
        "@type": "Question",
        name: "¿Esteban Rey (Kilowatto) es el mismo Esteban Rey cantante?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. Existe un cantautor venezolano homónimo (proyectos musicales como Chamito Sound y Amor Cromático) que no tiene ninguna relación con Esteban Rey Ortega, el empresario tecnológico mexicano de este sitio, fundador de Ignia Cloud.",
        },
      },
      {
        "@type": "Question",
        name: "¿Por qué le dicen \"Kilowatto\" a Esteban Rey?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "\"Kilowatto\" es el apodo con el que se le conoce en la industria tecnológica mexicana desde sus inicios en cómputo y telecomunicaciones, y hoy es su marca personal.",
        },
      },
      {
        "@type": "Question",
        name: "¿Qué empresas ha fundado Esteban Rey?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Esteban Rey Ortega es fundador y CEO de Ignia Cloud (nube soberana para México y Latinoamérica, cuyas marcas incluyen a Aluna), fundador del Yucatech Festival, y tiene proyectos activos en Cereza y DeSiCi a través de su vehículo de inversión Orange Rhino Investments.",
        },
      },
    ],
  })} />

  <section class="hero">
    <div class="container hero__inner">
      <div>
        <p class="eyebrow">Esteban Rey · CEO, Ignia Cloud</p>
        <h1>Serio.<br />Pero no solemne.</h1>
        <Spark />
        <p class="hero__sub">
          {profile?.bio_short ??
            "25+ años construyendo tecnología, empresas y equipos en América Latina."}
        </p>
      </div>
      {heroPhoto && (
        <img
          class="hero__photo"
          src={`/media/${heroPhoto.r2_key}?w=500`}
          srcset={`/media/${heroPhoto.r2_key}?w=500 500w, /media/${heroPhoto.r2_key}?w=900 900w`}
          sizes="(max-width: 720px) 100vw, 22rem"
          alt="Esteban Rey"
          fetchpriority="high"
        />
      )}
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      <p class="eyebrow">Trayectoria</p>
      <h2>De configurar firewalls a los 16, a fundar la nube naranja.</h2>
      <Trayectoria companies={companies} />
      <p class="see-more"><a href="/trayectoria">Ver toda la trayectoria →</a></p>
    </div>
  </section>

  <PullQuote placement="home" />

  {projects.length > 0 && (
    <section class="chapter chapter--mist">
      <div class="container">
        <p class="eyebrow">Mis proyectos</p>
        <h2>En vivo, ahora mismo.</h2>
        <ul class="cards">
          {
            projects.slice(0, 5).map((p: any) => (
              <li class="card project-card">
                {p.image_r2_key && (
                  <img
                    src={`/media/${p.image_r2_key}?w=600`}
                    srcset={`/media/${p.image_r2_key}?w=500 500w, /media/${p.image_r2_key}?w=800 800w, /media/${p.image_r2_key}?w=1100 1100w`}
                    sizes="(max-width: 640px) 100vw, 50vw"
                    alt={`Captura de pantalla de ${p.name}`}
                    loading="lazy"
                    class="project-card__image"
                  />
                )}
                <div class="project-card__body">
                  {p.role && <p class="eyebrow">{p.role}</p>}
                  <h3>{p.name}</h3>
                  {p.summary && <p>{p.summary}</p>}
                  <p>
                    <a href={p.url} target="_blank" rel="noopener">
                      {p.url.replace(/^https?:\/\//, "")}
                    </a>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="see-more"><a href="/empresas">Ver empresas y proyectos →</a></p>
      </div>
    </section>
  )}

  {podcast && podcast.n > 0 && (
    <section class="chapter chapter--mist">
      <div class="container">
        <p class="eyebrow">El podcast</p>
        <h2>Al fondo con Kilowatto</h2>
        <p class="pod-home">
          Kilowatto y Leia conversan sobre cada investigación de <a href="/a-fondo">A fondo</a>,
          y el mismo feed lleva la lectura completa de cada una y las columnas narradas.
          {" "}{podcast.n} episodios, {podcast.minutes} minutos.
        </p>
        <PodcastLinks locale="es-MX" />
        <p class="see-more"><a href="/podcast">Ver todos los episodios →</a></p>
      </div>
    </section>
  )}

  <section class="chapter">
    <div class="container chapter--split">
      <div>
        <p class="eyebrow">Mérida, Yucatán</p>
        <h2>Yucatech Festival</h2>
        <p>
          El evento que apuesta a que el sur-sureste de México sea el próximo hub
          tecnológico de América Latina.
        </p>
        <p class="see-more"><a href="/yucatech">Conocer el festival →</a></p>
      </div>
    </div>
  </section>

  <section class="chapter faq-section">
    <div class="container">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2>Antes de que preguntes.</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>¿Quién es Esteban Rey (Kilowatto)?</summary>
          <p>
            Esteban Rey Ortega, conocido en la industria tecnológica como "Kilowatto", es un arquitecto de sistemas,
            CEO e inversionista serial mexicano con más de 25 años de trayectoria. Es fundador y CEO de Ignia Cloud,
            fundador del Yucatech Festival en Mérida, y opera Orange Rhino Investments, con participación en
            Cereza y DeSiCi.
          </p>
        </details>
        <details class="faq-item">
          <summary>¿Esteban Rey (Kilowatto) es el mismo Esteban Rey cantante?</summary>
          <p>
            No. Existe un cantautor venezolano homónimo (proyectos musicales como Chamito Sound y Amor Cromático)
            que no tiene ninguna relación con Esteban Rey Ortega, el empresario tecnológico mexicano de este sitio,
            fundador de Ignia Cloud.
          </p>
        </details>
        <details class="faq-item">
          <summary>¿Por qué le dicen "Kilowatto" a Esteban Rey?</summary>
          <p>
            "Kilowatto" es el apodo con el que se le conoce en la industria tecnológica mexicana desde sus inicios
            en cómputo y telecomunicaciones, y hoy es su marca personal.
          </p>
        </details>
        <details class="faq-item">
          <summary>¿Qué empresas ha fundado Esteban Rey?</summary>
          <p>
            Es fundador y CEO de Ignia Cloud (nube soberana para México y Latinoamérica, cuyas marcas incluyen a
            Aluna), fundador del Yucatech Festival, y tiene proyectos activos en Cereza y DeSiCi a través de su
            vehículo de inversión Orange Rhino Investments.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="chapter chapter--mist larry-intro">
    <div class="container larry-intro__inner">
      <img src="/larry/larry-gym.webp" alt="" width="220" height="220" loading="lazy" />
      <div>
        <p class="eyebrow">Tu copiloto en el sitio</p>
        <h2>Larry</h2>
        <p class="hero__sub">
          Serio, pero no solemne — como su jefe. Pregúntale lo que quieras sobre
          la trayectoria, las empresas o los proyectos.
        </p>
      </div>
    </div>
  </section>
</Site>

<style>
  .pod-home { max-width: 44rem; line-height: 1.55; }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
  .faq-item {
    border: 1px solid var(--line);
    padding: 0.9rem 1.1rem;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .faq-item p {
    margin: 0.75rem 0 0;
    color: var(--ink-soft);
  }

  .hero {
    padding-block: var(--space-5) var(--space-4);
  }

  .hero__inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-3);
  }

  .hero__photo {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  @media (min-width: 900px) {
    .hero__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .hero__photo {
      flex-shrink: 0;
    }
  }

  .hero h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 9vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0.3em 0 0;
  }

  .hero .spark {
    margin: var(--space-2) 0;
    max-width: 20rem;
  }

  .hero__sub {
    max-width: var(--measure);
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  .see-more {
    margin-top: var(--space-2);
  }

  .see-more a {
    color: var(--ember);
    font-weight: 600;
    text-decoration: none;
  }

  .larry-intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .larry-intro__inner img {
    width: 9rem;
    height: 9rem;
    border-radius: 999px;
    object-fit: cover;
    border: 3px solid var(--rhino);
  }

  .larry-intro h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0.1em 0;
  }

  @media (min-width: 640px) {
    .larry-intro__inner {
      flex-direction: row;
      text-align: left;
    }
  }
</style>
