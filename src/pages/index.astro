---
import Site from "../layouts/Site.astro";
import Spark from "../components/Spark.astro";
import { env } from "cloudflare:workers";

let profile = null;
let companies: any[] = [];
let investments: any[] = [];
let heroPhoto: any = null;

if (env?.DB) {
  const [profileRes, companiesRes, investmentsRes, heroPhotoRes] = await Promise.all([
    env.DB.prepare("SELECT * FROM profile WHERE id = 1").first(),
    env.DB.prepare("SELECT * FROM companies ORDER BY sort_order").all(),
    env.DB.prepare("SELECT * FROM investments ORDER BY sort_order").all(),
    env.DB.prepare(
      "SELECT r2_key FROM photos WHERE approval_status = 'approved' AND solo_subject = 1 ORDER BY RANDOM() LIMIT 1"
    ).first(),
  ]);
  profile = profileRes;
  companies = companiesRes?.results ?? [];
  investments = investmentsRes?.results ?? [];
  heroPhoto = heroPhotoRes;
}

const latestCompanies = companies.slice(-3).reverse();
const featuredInvestments = investments.filter((i: any) => i.slug !== "orange-rhino-investments").slice(0, 2);
---

<Site
  title="Esteban Rey — Kilowatto"
  description="Esteban Rey (Kilowatto) — arquitecto de sistemas, CEO de Ignia Cloud, fundador del Yucatech Festival e inversionista serial en Orange Rhino Investments."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Esteban Rey",
    "alternateName": ["Kilowatto", "Esteban Rey Ortega"],
    "url": "https://kilowatto.com",
    "jobTitle": "CEO",
    "worksFor": { "@type": "Organization", "name": "Ignia Cloud" },
    "sameAs": ["https://x.com/kilowatto"],
    "description": profile?.bio_short ?? undefined,
  })} />

  <section class="hero">
    <div class="container hero__inner">
      <div>
        <p class="eyebrow">Esteban Rey · CEO, Ignia Cloud</p>
        <h1>Serio.<br />Pero no solemne.</h1>
        <Spark />
        <p class="hero__sub">
          {profile?.bio_short ??
            "25+ años construyendo tecnología, empresas y equipos en América Latina."}
        </p>
      </div>
      {heroPhoto && <img class="hero__photo" src={`/media/${heroPhoto.r2_key}`} alt="Esteban Rey" />}
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      <p class="eyebrow">Trayectoria</p>
      <h2>De configurar firewalls a los 16, a fundar la nube naranja.</h2>
      <ol class="rows">
        {
          latestCompanies.map((c: any) => (
            <li class="row">
              <span class="row__range">
                {c.start_date ?? ""}
                {c.end_date ? `–${c.end_date}` : c.is_current ? "–hoy" : ""}
              </span>
              <div>
                <h3>{c.name}</h3>
                {c.role && <p class="row__role">{c.role}</p>}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="see-more"><a href="/trayectoria">Ver toda la trayectoria →</a></p>
    </div>
  </section>

  <section class="chapter chapter--mist">
    <div class="container">
      <p class="eyebrow">Orange Rhino Investments</p>
      <h2>Estrategia de mancuerna: tecnología y economía real.</h2>
      <ul class="cards">
        {
          featuredInvestments.map((i: any) => (
            <li class="card">
              <p class="eyebrow">{i.category}</p>
              <h3>{i.name}</h3>
              {i.summary && <p>{i.summary}</p>}
            </li>
          ))
        }
      </ul>
      <p class="see-more"><a href="/inversiones">Ver todas las inversiones →</a></p>
    </div>
  </section>

  <section class="chapter">
    <div class="container chapter--split">
      <div>
        <p class="eyebrow">Mérida, Yucatán</p>
        <h2>Yucatech Festival</h2>
        <p>
          El evento que apuesta a que el sur-sureste de México sea el próximo hub
          tecnológico de América Latina.
        </p>
        <p class="see-more"><a href="/yucatech">Conocer el festival →</a></p>
      </div>
    </div>
  </section>

  <section class="chapter chapter--mist larry-intro">
    <div class="container larry-intro__inner">
      <img src="/larry/larry-gym.webp" alt="" width="220" height="220" loading="lazy" />
      <div>
        <p class="eyebrow">Tu copiloto en el sitio</p>
        <h2>Larry</h2>
        <p class="hero__sub">
          Serio, pero no solemne — como su jefe. Pregúntale lo que quieras sobre
          la trayectoria, las empresas o las inversiones.
        </p>
      </div>
    </div>
  </section>
</Site>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-4);
  }

  .hero__inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-3);
  }

  .hero__photo {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  @media (min-width: 900px) {
    .hero__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .hero__photo {
      flex-shrink: 0;
    }
  }

  .hero h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 9vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0.3em 0 0;
  }

  .hero .spark {
    margin: var(--space-2) 0;
    max-width: 20rem;
  }

  .hero__sub {
    max-width: var(--measure);
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  .see-more {
    margin-top: var(--space-2);
  }

  .see-more a {
    color: var(--ember);
    font-weight: 600;
    text-decoration: none;
  }

  .larry-intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .larry-intro__inner img {
    width: 9rem;
    height: 9rem;
    border-radius: 999px;
    object-fit: cover;
    border: 3px solid var(--rhino);
  }

  .larry-intro h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0.1em 0;
  }

  @media (min-width: 640px) {
    .larry-intro__inner {
      flex-direction: row;
      text-align: left;
    }
  }
</style>
