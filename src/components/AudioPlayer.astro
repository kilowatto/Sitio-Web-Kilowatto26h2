---
// "Escucha esta columna": narration player shown above the article body.
//
// Deliberately NOT injected into body_html. Interleaving it there would mean adding a tag to
// column-layout.ts's BLOCK_RE (any top-level tag missing from that regex is silently dropped
// when blocks are rejoined -- confirmed live 2026-07-28) AND teaching
// investigacion-translate.ts to treat it as opaque. Rendering it as a sibling component
// sidesteps both silent-failure modes entirely.
//
// Synthetic-voice disclosure is part of the component, not optional chrome: Esteban chose a
// discreet permanent notice per piece (2026-08-21), and YouTube's altered-content policy plus
// plain honesty both require it wherever this audio appears.
interface Props {
  audioKey: string;
  durationSeconds?: number | null;
  vttKey?: string | null;
  label?: string;
  transcriptUrl?: string | null;
  /** Narrow variant for the investigación TOC rail, where the column is ~250px. */
  compact?: boolean;
  /** Overrides the disclosure sentence. The default names Larry and says "narrado", which is
      true of a narration and false of the two-voice conversation -- and a disclosure that
      misdescribes what you are hearing is worse than a generic one. */
  disclosure?: string;
  /** Distinguishes the narration from the conversation in telemetry. */
  kind?: "audio_narration" | "audio_dialogue";
  /** Enables paragraph highlighting + follow-scroll. [{p,start,end}] over the body's <p>s. */
  cueMap?: string | null;
  /** Identifies the piece for listening telemetry. */
  entityType?: string | null;
  entityId?: number | null;
  locale?: string;
  /** CSS selector for the article body whose <p> elements the cue map indexes. */
  bodySelector?: string;
}

const {
  audioKey,
  durationSeconds = null,
  vttKey = null,
  label = "Escucha esta columna",
  transcriptUrl = null,
  compact = false,
  disclosure = "Narrado con la voz sintética de Larry. El texto es de Esteban; la voz no es humana.",
  kind = "audio_narration",
  cueMap = null,
  entityType = null,
  entityId = null,
  locale = "es-MX",
  bodySelector = ".column-article, .ia-article",
} = Astro.props;

// The three strings the player says on its own. They were Spanish literals, which is fine on 11
// of the 12 locales' worth of pages that never had audio -- and wrong on the English ones, where
// an English narration sat under "Tu navegador no puede reproducir audio".
const UI: Record<string, { noAudio: string; download: string; transcript: string }> = {
  "es-MX": {
    noAudio: "Tu navegador no puede reproducir audio.",
    download: "Descarga el archivo",
    transcript: "Leer la transcripción",
  },
  en: {
    noAudio: "Your browser cannot play audio.",
    download: "Download the file",
    transcript: "Read the transcript",
  },
};
const ui = UI[locale] ?? UI[locale.startsWith("en") ? "en" : "es-MX"];

// Served through /media/video/[...key] -- the one route in the repo that answers Range
// requests with 206, which is what makes seeking work at all. Plain /media/[...key] buffers
// and never returns 206, so browsers report seekable = [0,0] and the scrubber is dead.
const src = `/media/video/${audioKey}`;
const vttSrc = vttKey ? `/media/video/${vttKey}` : null;

function fmtDuration(seconds: number): string {
  const m = Math.floor(seconds / 60);
  const s = Math.round(seconds % 60);
  return `${m}:${String(s).padStart(2, "0")}`;
}
---

<figure
  class={`kw-audio${compact ? " kw-audio--compact" : ""}`}
  data-kw-audio
  data-entity-type={entityType ?? undefined}
  data-kind={kind}
  data-entity-id={entityId ?? undefined}
  data-locale={locale}
  data-body-selector={bodySelector}
>
  <figcaption class="kw-audio__head">
    <span class="kw-audio__label">{label}</span>
    {durationSeconds ? <span class="kw-audio__dur">{fmtDuration(durationSeconds)}</span> : null}
  </figcaption>

  <audio class="kw-audio__el" controls preload="metadata" src={src}>
    {vttSrc ? <track kind="captions" srclang="es" label="Español" src={vttSrc} default /> : null}
    {ui.noAudio}
    <a href={src} download>{ui.download}</a>.
  </audio>

  {cueMap ? (
    <script type="application/json" data-kw-cues set:html={cueMap.replace(/</g, "\\u003c")} />
  ) : null}

  <p class="kw-audio__note">
    {disclosure}
    {transcriptUrl ? (
      <>
        {" "}
        <a href={transcriptUrl}>{ui.transcript}</a>.
      </>
    ) : null}
  </p>
</figure>

<script>
  // Paragraph sync + follow-scroll + listening telemetry.
  //
  // Highlighting is per PARAGRAPH, not per word: the narration follows an adapted script, so
  // word-level highlighting would drift onto the wrong word inside a paragraph. See
  // src/lib/cue-map.ts.
  function initKwAudio(root: HTMLElement) {
    if (root.dataset.kwInit === "1") return;
    root.dataset.kwInit = "1";

    const audio = root.querySelector<HTMLAudioElement>(".kw-audio__el");
    if (!audio) return;

    const entityType = root.dataset.entityType ?? null;
    const entityId = Number(root.dataset.entityId ?? "0");
    const locale = root.dataset.locale ?? "es-MX";
    const kind = root.dataset.kind ?? "audio_narration";

    // ---- telemetry ----
    // A per-load random id. Without it "hours listened" is uncomputable: summing the position
    // of every event counts one listener who reached 7:00 as 0 + 100 + 200 + 300 + 400
    // seconds. With it, the total is the sum of each session's FURTHEST position.
    // Not a user id and not persisted -- it dies with the page, and nothing links two visits.
    const sessionId = (crypto.randomUUID?.() ?? String(Math.random())).slice(0, 18);
    const sent = new Set<number>();
    function send(event: string) {
      if (!entityType || !entityId) return;
      const payload = JSON.stringify({
        entityType, entityId, locale, event, kind,
        sessionId,
        position: Math.round(audio!.currentTime),
        duration: Math.round(audio!.duration || 0),
        pathname: location.pathname,
      });
      // sendBeacon survives page unload, which is exactly when "pause" and the final progress
      // event fire. fetch() would be cancelled.
      try {
        if (navigator.sendBeacon) {
          navigator.sendBeacon("/api/audio-event", new Blob([payload], { type: "application/json" }));
        } else {
          fetch("/api/audio-event", { method: "POST", body: payload, keepalive: true });
        }
      } catch {}
    }

    audio.addEventListener("play", () => send("play"));
    audio.addEventListener("pause", () => { if (!audio.ended) send("pause"); });
    audio.addEventListener("ended", () => send("ended"));
    audio.addEventListener("ratechange", () => send("ratechange"));
    // A "seeked" right after a pure play/pause isn't a real seek; only report a jump.
    let lastTime = 0;
    audio.addEventListener("timeupdate", () => { lastTime = audio.currentTime; });
    audio.addEventListener("seeked", () => {
      if (Math.abs(audio.currentTime - lastTime) > 2) send("seek");
    });

    // ---- paragraph sync ----
    const cueEl = root.querySelector<HTMLScriptElement>("[data-kw-cues]");
    let cues: { p: number; start: number; end: number }[] = [];
    try { cues = JSON.parse(cueEl?.textContent || "[]"); } catch { cues = []; }

    const body = document.querySelector<HTMLElement>(root.dataset.bodySelector || ".column-article");
    const paras = body ? Array.from(body.querySelectorAll<HTMLElement>("p")) : [];

    // Follow-scroll is opt-in per session and yields to the reader: once they scroll
    // themselves, stop yanking the page around until playback is restarted.
    let follow = true;
    let activeIdx = -1;
    let programmaticScroll = false;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    window.addEventListener("scroll", () => { if (!programmaticScroll) follow = false; }, { passive: true });
    audio.addEventListener("play", () => { follow = true; });

    audio.addEventListener("timeupdate", () => {
      // progress milestones, once each
      const d = audio.duration || 0;
      if (d > 0) {
        const pct = Math.floor((audio.currentTime / d) * 100);
        for (const m of [25, 50, 75]) {
          if (pct >= m && !sent.has(m)) { sent.add(m); send("progress"); }
        }
      }

      if (cues.length === 0 || paras.length === 0) return;
      const t = audio.currentTime;
      const cue = cues.find((c) => t >= c.start && t <= c.end);
      const idx = cue ? cue.p : -1;
      if (idx === activeIdx) return;

      if (activeIdx >= 0 && paras[activeIdx]) paras[activeIdx].classList.remove("kw-audio-active");
      activeIdx = idx;
      if (idx < 0 || !paras[idx]) return;
      paras[idx].classList.add("kw-audio-active");

      if (follow) {
        const rect = paras[idx].getBoundingClientRect();
        // Only scroll when the paragraph is actually out of a comfortable reading band --
        // otherwise the page twitches on every cue change.
        if (rect.top < 80 || rect.bottom > window.innerHeight - 80) {
          programmaticScroll = true;
          paras[idx].scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "center" });
          setTimeout(() => { programmaticScroll = false; }, 800);
        }
      }
    });
  }

  document.querySelectorAll<HTMLElement>("[data-kw-audio]").forEach(initKwAudio);
</script>

<style>
  .kw-audio {
    margin: 0 0 var(--space-3);
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: var(--mist);
    max-width: var(--measure);
  }
  .kw-audio__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 0.6rem;
  }
  .kw-audio__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .kw-audio__dur {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
  }
  /* width:100% keeps the native control from overflowing the reading column on narrow
     viewports -- the default intrinsic width of <audio> is wider than 390px. */
  .kw-audio__el {
    width: 100%;
    display: block;
  }
  .kw-audio__note {
    margin: 0.6rem 0 0;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  /* The highlighted paragraph is in the article body, not inside this component, so the rule
     has to be global -- a scoped selector gets a [data-astro-cid-*] attribute the article's
     <p> elements don't carry, and would silently match nothing. */
  :global(p.kw-audio-active) {
    background: color-mix(in srgb, var(--volt) 22%, transparent);
    box-shadow: -0.6rem 0 0 color-mix(in srgb, var(--volt) 22%, transparent),
      0.6rem 0 0 color-mix(in srgb, var(--volt) 22%, transparent);
    border-radius: 2px;
    transition: background 0.25s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(p.kw-audio-active) { transition: none; }
  }

  /* Sidebar rail variant: no card chrome competing with the TOC, and the disclosure
     shrinks to a single line so it doesn't push the section list down the page. */
  .kw-audio--compact {
    max-width: none;
    margin-bottom: var(--space-2);
    padding: 0 0 var(--space-2);
    background: none;
    border: none;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
  }
  .kw-audio--compact .kw-audio__head { margin-bottom: 0.45rem; }
  .kw-audio--compact .kw-audio__label { font-size: 0.62rem; }
  .kw-audio--compact .kw-audio__el { height: 2.2rem; }
  .kw-audio--compact .kw-audio__note { font-size: 0.62rem; margin-top: 0.4rem; }
</style>
