---
// Shared between /prensa (page 1) and /prensa/[page] so pagination markup, click-through
// links, and the infinite-scroll script only exist in one place.
//
// SEO approach: real server-rendered pages at /prensa, /prensa/2, /prensa/3... each with a
// self-referencing canonical (handled automatically by Base.astro from Astro.url.pathname)
// and plain <a href> links a crawler can follow with zero JS. On top of that, JS progressively
// enhances the experience into infinite scroll for human visitors: it fetches the next page's
// real HTML, lifts out its <li> rows, appends them, and pushState's the URL forward — so a
// human never has to click "next", but nothing here depends on JS running to be indexable.
interface Props {
  mentions: any[];
  currentPage: number;
  totalPages: number;
  basePath: string; // e.g. "/prensa" or "/en/prensa" — no trailing slash
}

const { mentions, currentPage, totalPages, basePath } = Astro.props;

function pageUrl(n: number) {
  return n <= 1 ? basePath : `${basePath}/${n}`;
}

const hasNext = currentPage < totalPages;
const nextPage = currentPage + 1;
---

<ol class="rows" id="press-list">
  {mentions.map((m: any) => (
    <li class="row">
      <span class="row__range">{m.published_at}</span>
      <div class="press-item">
        {m.thumbnail_url && (
          <a
            href={`/api/press/${m.id}/click`}
            target="_blank"
            rel="noopener"
            class="press-thumb-link"
            aria-label={m.title}
          >
            <img src={m.thumbnail_url} alt="" class="press-thumb" loading="lazy" />
          </a>
        )}
        <div class="press-item__text">
          <h3>
            <a href={`/api/press/${m.id}/click`} target="_blank" rel="noopener">
              {m.title}
            </a>
          </h3>
          {m.summary && <p class="row__summary">{m.summary}</p>}
          <p class="row__summary">
            <a href={`/api/press/${m.id}/click`} target="_blank" rel="noopener">
              {m.outlet}
            </a>
          </p>
        </div>
      </div>
    </li>
  ))}
</ol>

{totalPages > 1 && (
  <nav class="pagination" aria-label="Paginación de prensa">
    {currentPage > 1 ? (
      <a href={pageUrl(currentPage - 1)} rel="prev">← Anterior</a>
    ) : (
      <span />
    )}
    <span class="pagination__pages">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) =>
        p === currentPage ? (
          <span class="pagination__current" aria-current="page">{p}</span>
        ) : (
          <a href={pageUrl(p)}>{p}</a>
        )
      )}
    </span>
    {hasNext ? (
      <a href={pageUrl(nextPage)} rel="next" id="press-next-link" data-next-page={nextPage}>Siguiente →</a>
    ) : (
      <span />
    )}
  </nav>
)}

{hasNext && <div id="press-scroll-sentinel"></div>}

{hasNext && (
  <script define:vars={{ basePath, nextPage }}>
    (() => {
      let loading = false;
      let nextPageNum = nextPage;
      const sentinel = document.getElementById("press-scroll-sentinel");
      const list = document.getElementById("press-list");
      if (!sentinel || !list) return;

      const observer = new IntersectionObserver(
        async (entries) => {
          if (!entries[0].isIntersecting || loading) return;
          loading = true;
          const nextUrl = nextPageNum <= 1 ? basePath : `${basePath}/${nextPageNum}`;
          try {
            const res = await fetch(nextUrl);
            if (!res.ok) {
              observer.disconnect();
              return;
            }
            const html = await res.text();
            const doc = new DOMParser().parseFromString(html, "text/html");
            const newItems = doc.querySelectorAll("#press-list > li");
            newItems.forEach((li) => list.appendChild(li.cloneNode(true)));
            history.pushState({}, "", nextUrl);

            const nav = document.querySelector(".pagination");
            if (nav) nav.style.display = "none";

            if (doc.getElementById("press-next-link")) {
              nextPageNum += 1;
            } else {
              observer.disconnect();
              sentinel.remove();
            }
          } catch {
            observer.disconnect();
          } finally {
            loading = false;
          }
        },
        { rootMargin: "800px" }
      );
      observer.observe(sentinel);
    })();
  </script>
)}

<style>
  .press-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .press-item__text {
    min-width: 0;
    flex: 1;
  }
  .press-thumb-link {
    flex-shrink: 0;
    display: block;
  }
  .press-thumb {
    width: 6.5rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.5rem;
  }
  @media (min-width: 480px) {
    .press-thumb { width: 9rem; }
  }
  @media (min-width: 720px) {
    .press-thumb { width: 11rem; }
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .pagination a {
    color: var(--ember);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .pagination__pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .pagination__pages a,
  .pagination__current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.4rem;
    border-radius: 0.4rem;
  }
  .pagination__current {
    background: var(--rhino);
    color: #fff;
    font-weight: 700;
  }
  #press-scroll-sentinel {
    height: 1px;
  }
</style>
