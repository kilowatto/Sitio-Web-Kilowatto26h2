---
import { env } from "cloudflare:workers";

interface Props {
  companies: any[];
  hoyLabel?: string;
  caption?: string;
  rtl?: boolean;
}
const {
  companies,
  hoyLabel = "Hoy",
  caption = "Cuando dos tramos coinciden en el tiempo, esos roles se llevaron en paralelo — no es una carrera en línea recta.",
  rtl = false,
} = Astro.props;
const posProp = rtl ? "right" : "left";

let photoRows: any[] = [];
if (env?.DB) {
  const res = await env.DB.prepare(
    "SELECT r2_key, taken_date, caption, ai_caption FROM photos WHERE approval_status = 'approved' AND minor_flag = 'clear' AND taken_date IS NOT NULL ORDER BY taken_date"
  ).all();
  photoRows = res?.results ?? [];
}

const now = new Date();
const HOY = now.getFullYear() + now.getMonth() / 12;

function parseYear(value: string | null): number | null {
  if (!value) return null;
  const monthMatch = /^(\d{4})-(\d{2})$/.exec(value);
  if (monthMatch) {
    return parseInt(monthMatch[1], 10) + (parseInt(monthMatch[2], 10) - 1) / 12;
  }
  const year = parseInt(value, 10);
  return Number.isNaN(year) ? null : year;
}

const rows = (companies ?? []).filter((c: any) => c.show_in_timeline !== 0);

const parsedAll = rows
  .map((c: any) => {
    const start = parseYear(c.start_date);
    const isOngoing = !c.end_date && !!c.is_current;
    const end = isOngoing ? HOY : parseYear(c.end_date) ?? (start != null ? start + 1 : null);
    return { ...c, start, end, isOngoing, isAdvisory: !!c.is_advisory };
  })
  .filter((c: any) => c.start != null)
  .sort((a: any, b: any) => a.start - b.start);

const START_YEAR = parsedAll.length
  ? Math.floor(Math.min(...parsedAll.map((c: any) => c.start)))
  : Math.floor(HOY);
const AXIS_END_YEAR = Math.ceil(HOY) + 1;
const PXY = 42;
const AXIS_H = Math.round((AXIS_END_YEAR - START_YEAR) * PXY);

function px(year: number) {
  return Math.round((year - START_YEAR) * PXY);
}

function assignLanes(items: any[]) {
  const laneEnds: number[] = [];
  return items.map((item) => {
    let lane = laneEnds.findIndex((endYear) => endYear <= item.start);
    if (lane === -1) {
      lane = laneEnds.length;
      laneEnds.push(item.end);
    } else {
      laneEnds[lane] = item.end;
    }
    return { ...item, lane };
  });
}

const opAssigned = assignLanes(parsedAll.filter((c: any) => !c.isAdvisory));
const advAssigned = assignLanes(parsedAll.filter((c: any) => c.isAdvisory));

const OP_LANES = opAssigned.length ? Math.max(...opAssigned.map((c: any) => c.lane + 1)) : 1;
const ADV_LANES = advAssigned.length ? Math.max(...advAssigned.map((c: any) => c.lane + 1)) : 0;

const LABEL_W = 28;
const OP_X = LABEL_W + 18;
const OP_W = 12;
const OP_GAP = 4;
const ADV_GAP_BEFORE = ADV_LANES > 0 ? 14 : 0;
const ADV_W = 7;
const ADV_GAP = 4;
const ADV_X = OP_X + OP_LANES * OP_W + Math.max(0, OP_LANES - 1) * OP_GAP + ADV_GAP_BEFORE;
const AXIS_COL_W =
  ADV_X + ADV_LANES * ADV_W + Math.max(0, ADV_LANES - 1) * ADV_GAP + (ADV_LANES > 0 ? 10 : 18);

const TONES: Record<string, string> = {
  ula: "color-mix(in oklch, var(--ink) 82%, var(--ember) 18%)",
  prochemex: "color-mix(in oklch, var(--ink) 60%, var(--ember) 40%)",
  desici: "color-mix(in oklch, var(--ink) 72%, var(--ember) 28%)",
  "desici-consejero": "color-mix(in oklch, var(--ink) 72%, var(--ember) 28%)",
  oncloud: "color-mix(in oklch, var(--ink) 40%, var(--ember) 60%)",
  octapus: "color-mix(in oklch, var(--ink) 45%, var(--ember) 55%)",
  "orange-rhino": "color-mix(in oklch, var(--ember) 35%, var(--rhino) 65%)",
  pilou: "var(--volt)",
  finsus: "color-mix(in oklch, var(--rhino) 68%, var(--ink) 32%)",
  "ignia-cloud": "var(--rhino)",
  cereza: "var(--ink-soft)",
};
const FALLBACK_TONE = "color-mix(in oklch, var(--ink) 50%, var(--ember) 50%)";

function place(items: any[], x: number, w: number) {
  return items.map((c: any) => {
    const top = px(c.start);
    const bottom = c.isOngoing ? AXIS_H : px(c.end);
    const height = Math.max(bottom - top, 10);
    return {
      ...c,
      top,
      bottom,
      height,
      left: x + c.lane * (w + (w === OP_W ? OP_GAP : ADV_GAP)),
      width: w,
      color: TONES[c.slug] ?? FALLBACK_TONE,
    };
  });
}

const opEntries = place(opAssigned, OP_X, OP_W);
const advEntries = place(advAssigned, ADV_X, ADV_W);
const allEntries = [...opEntries, ...advEntries].sort((a, b) => a.start - b.start);

const TICK_STEP = 4;
const ticks: number[] = [];
for (let y = Math.ceil(START_YEAR / TICK_STEP) * TICK_STEP; y < HOY - 0.5; y += TICK_STEP) {
  ticks.push(y);
}
if (!ticks.includes(START_YEAR)) ticks.unshift(START_YEAR);
const hoyTop = px(HOY);

const photos = photoRows
  .map((p: any) => {
    const m = /^(\d{4})-(\d{2})/.exec(p.taken_date ?? "");
    if (!m) return null;
    const year = parseInt(m[1], 10) + (parseInt(m[2], 10) - 1) / 12;
    return { r: p.r2_key, y: year, a: p.caption || p.ai_caption || "" };
  })
  .filter(Boolean);
---

<div class="kw-trayectoria">
  <div class="kw-photo-bg" id="kw-photo-bg" aria-hidden="true">
    <div class="kw-photo-layer kw-photo-layer--a"></div>
    <div class="kw-photo-layer kw-photo-layer--b"></div>
    <div class="kw-photo-scrim"></div>
  </div>
  <script type="application/json" id="kw-photos-data" set:html={JSON.stringify(photos).replace(/</g, "\\u003c")} />

  <p class="kw-caption">{caption}</p>

  <div class="kw-shell">
    <div class="kw-axis" id="kw-axis" style={`width:${AXIS_COL_W}px;height:${AXIS_H}px`} data-start-year={START_YEAR} data-hoy={HOY.toFixed(3)} data-pxy={PXY} data-hoy-label={hoyLabel}>
      {ticks.map((y) => (
        <div class="kw-tick" style={`top:${px(y)}px;${posProp}:0;text-align:${rtl ? "right" : "left"}`}>
          <span>{y}</span>
        </div>
      ))}
      <div class="kw-tick kw-tick--hoy" style={`top:${hoyTop}px;${posProp}:0;text-align:${rtl ? "right" : "left"}`}>
        <span>{hoyLabel}</span>
      </div>

      <div class="kw-spine" style={`${posProp}:${LABEL_W + 4}px;height:${AXIS_H}px`}></div>
      <div class="kw-spine-fill" id="kw-spine-fill" style={`${posProp}:${LABEL_W + 4}px`}></div>

      {opEntries.map((e) => (
        <div
          class={`kw-op-bar ${e.isOngoing ? "is-open" : "is-closed"}`}
          title={`${e.name} — ${e.role ?? ""}`}
          style={`top:${e.top}px;${posProp}:${e.left}px;width:${e.width}px;height:${e.height}px;color:${e.color}`}
          data-top={e.top}
          data-bottom={e.bottom}
        >
          <div class="kw-op-ghost"></div>
          <div class="kw-op-fill"></div>
        </div>
      ))}

      {advEntries.map((e) => (
        <div
          class="kw-adv-bar"
          title={`${e.name} — ${e.role ?? ""}`}
          style={`top:${e.top}px;${posProp}:${e.left}px;width:${e.width}px;height:${e.height}px;color:${e.color}`}
          data-top={e.top}
          data-bottom={e.bottom}
        ></div>
      ))}
    </div>

    <div class="kw-summary">
      <p class="kw-summary-year" id="kw-summary-year">—</p>
      <div id="kw-summary-rows">
        {allEntries.map((e) => (
          <div class="kw-summary-row" data-top={e.top} data-bottom={e.bottom}>
            <span class="kw-summary-dot" style={`background:${e.color}`}></span>
            <div class="kw-summary-text">
              <strong>{e.name}</strong>
              {e.role && <span>{e.role}</span>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style define:vars={{ axisColW: `${AXIS_COL_W}px`, scrimDir: rtl ? "left" : "right" }}>
  .kw-trayectoria {
    position: relative;
  }

  .kw-photo-bg {
    display: none;
  }

  @media (min-width: 900px) {
    .kw-photo-bg {
      display: block;
      position: absolute;
      inset: -24px;
      overflow: hidden;
      z-index: 0;
      pointer-events: none;
    }
  }

  .kw-photo-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    filter: blur(9px) saturate(1.05);
    transform: scale(1.08);
    transition: opacity 1.8s ease;
  }
  .kw-photo-layer.is-visible {
    opacity: 1;
  }
  .kw-photo-layer.is-animating {
    animation: kw-ken-burns 16s ease-in-out forwards;
  }
  @keyframes kw-ken-burns {
    from {
      transform: scale(1.06) translate(0, 0);
    }
    to {
      transform: scale(1.14) translate(-1.5%, 1.5%);
    }
  }
  .kw-photo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to var(--scrimDir),
      var(--paper) 0%,
      color-mix(in oklch, var(--paper) 60%, transparent) 40%,
      color-mix(in oklch, var(--paper) 22%, transparent) 100%
    );
  }
  @media (prefers-reduced-motion: reduce) {
    .kw-photo-bg {
      display: none !important;
    }
  }

  .kw-caption {
    position: relative;
    z-index: 1;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 30rem;
    margin: 0 0 var(--space-3);
  }

  .kw-shell {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .kw-axis {
    position: relative;
    flex: 0 0 var(--axisColW);
  }

  .kw-tick {
    position: absolute;
    width: 26px;
    transform: translateY(-50%);
  }
  .kw-tick span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .kw-tick--hoy span {
    color: var(--rhino);
    font-weight: 500;
  }

  .kw-spine {
    position: absolute;
    top: 0;
    width: 2px;
    background: var(--line);
  }
  .kw-spine-fill {
    position: absolute;
    top: 0;
    width: 2px;
    height: 0;
    background: var(--rhino);
    transition: height 0.12s linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .kw-spine-fill,
    .kw-op-fill {
      transition: none;
    }
  }

  .kw-op-bar {
    position: absolute;
    border-radius: 1px;
  }
  .kw-op-ghost {
    position: absolute;
    inset: 0;
    border: 1.5px solid currentColor;
    opacity: 0.26;
  }
  .kw-op-bar.is-open .kw-op-ghost {
    -webkit-mask-image: linear-gradient(to bottom, black 82%, transparent);
    mask-image: linear-gradient(to bottom, black 82%, transparent);
  }
  .kw-op-bar.is-closed .kw-op-ghost {
    border-bottom-width: 3px;
  }
  .kw-op-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    background: currentColor;
    transition: height 0.12s linear;
  }

  .kw-adv-bar {
    position: absolute;
    border: 1.5px dashed currentColor;
    border-radius: 1px;
    opacity: 0.28;
    transition: opacity 0.2s ease;
  }
  .kw-adv-bar.is-revealed {
    opacity: 1;
  }

  .kw-summary {
    flex: 1 1 200px;
    max-width: 380px;
    min-width: 0;
    position: sticky;
    top: 24px;
    align-self: flex-start;
    background: var(--mist);
    border: 1px solid var(--line);
    padding: 20px;
    min-height: 92px;
  }
  .kw-summary-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--ember);
    margin: 0 0 14px;
  }
  .kw-summary-row {
    display: none;
    gap: 10px;
    align-items: flex-start;
    padding: 9px 0;
    border-top: 1px solid var(--line);
  }
  .kw-summary-row.is-active {
    display: flex;
  }
  #kw-summary-rows .kw-summary-row.is-active:first-of-type {
    border-top: none;
    padding-top: 0;
  }
  .kw-summary-dot {
    flex: 0 0 8px;
    width: 8px;
    height: 8px;
    margin-top: 5px;
    border-radius: 50%;
  }
  .kw-summary-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .kw-summary-text strong {
    font-size: 0.94rem;
    font-weight: 600;
  }
  .kw-summary-text span {
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  @media (max-width: 460px) {
    .kw-shell {
      gap: 14px;
    }
    .kw-summary {
      padding: 16px;
    }
  }
</style>

<script>
  function initTrayectoria() {
    const axis = document.getElementById("kw-axis");
    if (!axis) return;

    const axisH = axis.querySelector<HTMLElement>(".kw-spine")?.style.height;
    const AXIS_H = axisH ? parseFloat(axisH) : axis.scrollHeight;

    const opBars = Array.from(axis.querySelectorAll<HTMLElement>(".kw-op-bar"));
    const advBars = Array.from(axis.querySelectorAll<HTMLElement>(".kw-adv-bar"));
    const spineFill = document.getElementById("kw-spine-fill");
    const summaryRows = Array.from(document.querySelectorAll<HTMLElement>(".kw-summary-row"));
    const yearLabelEl = document.getElementById("kw-summary-year");

    const startYear = parseFloat(axis.dataset.startYear ?? "0");
    const pxy = parseFloat(axis.dataset.pxy ?? "42");
    const hoy = parseFloat(axis.dataset.hoy ?? "0");
    const hoyLabel = axis.dataset.hoyLabel ?? "Hoy";

    // Ambient photo backdrop: desktop only, and only when the viewer hasn't
    // asked for reduced motion (it's a slow crossfade + zoom, purely decorative).
    const photosDataEl = document.getElementById("kw-photos-data");
    const allPhotos: { r: string; y: number; a: string }[] = photosDataEl
      ? JSON.parse(photosDataEl.textContent || "[]")
      : [];
    const photoBg = document.getElementById("kw-photo-bg");
    const layerA = photoBg?.querySelector<HTMLElement>(".kw-photo-layer--a");
    const layerB = photoBg?.querySelector<HTMLElement>(".kw-photo-layer--b");
    const photosEnabled =
      allPhotos.length > 0 &&
      layerA &&
      layerB &&
      window.matchMedia("(min-width: 900px)").matches &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let activeLayer: "a" | "b" = "a";
    function showPhoto(photo: { r: string; y: number; a: string } | null) {
      if (!photo || !layerA || !layerB) return;
      const nextEl = activeLayer === "a" ? layerB : layerA;
      const prevEl = activeLayer === "a" ? layerA : layerB;
      nextEl.style.backgroundImage = `url(/media/${photo.r}?w=900)`;
      nextEl.classList.remove("is-animating");
      void nextEl.offsetWidth;
      nextEl.classList.add("is-animating", "is-visible");
      prevEl.classList.remove("is-visible");
      activeLayer = activeLayer === "a" ? "b" : "a";
    }

    function pickPhoto(sweepYear: number, ranges: { start: number; end: number }[]) {
      if (!allPhotos.length) return null;
      let pool = allPhotos.filter((p) => ranges.some((r) => p.y >= r.start && p.y <= r.end));
      if (!pool.length) {
        const sorted = [...allPhotos].sort((a, b) => Math.abs(a.y - sweepYear) - Math.abs(b.y - sweepYear));
        pool = sorted.slice(0, Math.min(5, sorted.length));
      }
      return pool[Math.floor(Math.random() * pool.length)];
    }

    let lastYearBucket: number | null = null;
    let lastRanges: { start: number; end: number }[] = [];

    function cyclePhoto() {
      if (!photosEnabled) return;
      const sweepYear = lastYearBucket ?? startYear;
      showPhoto(pickPhoto(sweepYear, lastRanges));
    }

    if (photosEnabled) {
      window.setInterval(cyclePhoto, 9000);
    }

    let raf: number | null = null;

    function update() {
      raf = null;
      const rect = axis!.getBoundingClientRect();
      const vh = window.innerHeight || 800;
      const revealY = vh * 0.6;
      const sweepPx = Math.max(0, Math.min(AXIS_H, revealY - rect.top));

      if (spineFill) spineFill.style.height = `${sweepPx}px`;

      for (const bar of opBars) {
        const top = parseFloat(bar.dataset.top ?? "0");
        const fill = bar.querySelector<HTMLElement>(".kw-op-fill");
        if (fill) {
          const height = parseFloat(bar.style.height);
          const revealed = Math.max(0, Math.min(height, sweepPx - top));
          fill.style.height = `${revealed}px`;
        }
      }

      for (const bar of advBars) {
        const top = parseFloat(bar.dataset.top ?? "0");
        bar.classList.toggle("is-revealed", sweepPx >= top);
      }

      const sweepYear = startYear + sweepPx / pxy;
      const ranges: { start: number; end: number }[] = [];
      for (const row of summaryRows) {
        const top = parseFloat(row.dataset.top ?? "0");
        const bottom = parseFloat(row.dataset.bottom ?? "0");
        const isActive = sweepPx >= top && sweepPx <= bottom;
        row.classList.toggle("is-active", isActive);
        if (isActive) ranges.push({ start: startYear + top / pxy, end: startYear + bottom / pxy });
      }

      if (photosEnabled) {
        lastRanges = ranges;
        const bucket = Math.floor(sweepYear);
        if (bucket !== lastYearBucket) {
          lastYearBucket = bucket;
          showPhoto(pickPhoto(sweepYear, ranges));
        }
      }

      if (yearLabelEl) {
        yearLabelEl.textContent = sweepYear >= hoy - 0.5 ? hoyLabel : String(Math.floor(sweepYear));
      }
    }

    function onScroll() {
      if (raf != null) return;
      raf = requestAnimationFrame(update);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTrayectoria);
  } else {
    initTrayectoria();
  }
</script>
