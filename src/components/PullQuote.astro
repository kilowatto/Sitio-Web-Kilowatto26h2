---
import { env } from "cloudflare:workers";
import { loadTranslations, t } from "../lib/i18n";

interface Props {
  placement: string;
  locale?: string;
}

const { placement, locale = "es-MX" } = Astro.props;

let quote: any = null;
if (env?.DB) {
  quote = await env.DB.prepare("SELECT * FROM quotes WHERE placement = ? ORDER BY sort_order LIMIT 1")
    .bind(placement)
    .first();
}

let text: string | null = quote?.text ?? null;
if (quote && locale !== "es-MX" && env?.DB) {
  const tr = await loadTranslations(env.DB, "quotes", locale);
  text = t(tr, quote.id, "text", quote.text);
}
---

{
  text && (
    <blockquote class="pull-quote">
      <p>“{text}”</p>
      <cite>— Esteban Rey</cite>
    </blockquote>
  )
}

<style>
  .pull-quote {
    margin: var(--space-4) auto;
    max-width: var(--measure);
    padding-left: var(--space-3);
    border-left: 3px solid var(--rhino);
  }
  .pull-quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--ink);
  }
  .pull-quote cite {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-style: normal;
    color: var(--ink-soft);
  }
</style>
