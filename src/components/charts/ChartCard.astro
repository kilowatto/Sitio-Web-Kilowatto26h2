---
// Shared shell for every chart in an investigación: title, description, the
// actual chart (passed as the default slot), and a source note. Reveals on
// scroll via IntersectionObserver, same trigger-once pattern for every chart
// on the page (one shared observer, not one per card).
import BarChart from "./BarChart.astro";
import TimelineChart from "./TimelineChart.astro";
import RadarChart from "./RadarChart.astro";
import ComparisonCards from "./ComparisonCards.astro";
import TableChart from "./TableChart.astro";
import DonutChart from "./DonutChart.astro";
import LineChart from "./LineChart.astro";
import HeatmapChart from "./HeatmapChart.astro";
import ScatterChart from "./ScatterChart.astro";
import FunnelChart from "./FunnelChart.astro";
import DumbbellChart from "./DumbbellChart.astro";
import GaugeChart from "./GaugeChart.astro";
import TreemapChart from "./TreemapChart.astro";
import { chartToTable } from "../../lib/chart-table";

export type ChartType =
  | "bar"
  | "timeline"
  | "radar"
  | "cards"
  | "table"
  | "donut"
  | "line"
  | "heatmap"
  | "scatter"
  | "funnel"
  | "dumbbell"
  | "gauge"
  | "treemap";

interface Props {
  chartKey: string;
  title: string;
  description?: string | null;
  sourceNote?: string | null;
  chartType: ChartType;
  data: any;
  imageR2Key?: string | null;
}

const { chartKey, title, description, sourceNote, chartType, data, imageR2Key } = Astro.props;

// The accessible alternative to the chart, rendered server-side from the same data. Null for
// chart types that aren't tabular (cards) or whose data didn't parse.
const table = chartToTable(chartType, data);
---

<figure class="chart-card" data-chart-card data-chart-key={chartKey} id={`chart-${chartKey}`}>
  {imageR2Key && (
    <img
      src={`/media/${imageR2Key}?w=1200`}
      srcset={`/media/${imageR2Key}?w=800 800w, /media/${imageR2Key}?w=1400 1400w`}
      sizes="(min-width: 900px) 46rem, 100vw"
      alt=""
      loading="lazy"
      class="chart-card__image"
    />
  )}
  <p class="chart-card__title">{title}</p>
  {description && <p class="chart-card__desc">{description}</p>}
  <div class="chart-card__body">
    {chartType === "bar" && <BarChart data={data} />}
    {chartType === "timeline" && <TimelineChart data={data} />}
    {chartType === "radar" && <RadarChart data={data} />}
    {chartType === "cards" && <ComparisonCards data={data} />}
    {chartType === "table" && <TableChart data={data} />}
    {chartType === "donut" && <DonutChart data={data} />}
    {chartType === "line" && <LineChart data={data} />}
    {chartType === "heatmap" && <HeatmapChart data={data} />}
    {chartType === "scatter" && <ScatterChart data={data} />}
    {chartType === "funnel" && <FunnelChart data={data} />}
    {chartType === "dumbbell" && <DumbbellChart data={data} />}
    {chartType === "gauge" && <GaugeChart data={data} />}
    {chartType === "treemap" && <TreemapChart data={data} />}
  </div>
  {table && (
    <details class="chart-card__data">
      <summary>Ver los datos</summary>
      <div class="chart-card__data-scroll">
        <table>
          <caption class="visually-hidden">{title}</caption>
          <thead>
            <tr>{table.headers.map((h) => <th scope="col">{h}</th>)}</tr>
          </thead>
          <tbody>
            {table.rows.map((row) => (
              <tr>
                {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
  {sourceNote && <figcaption class="chart-card__source">{sourceNote}</figcaption>}
</figure>

<noscript>
  <style>
    .chart-card { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<style>
  .chart-card {
    margin: var(--space-4) 0;
    background: var(--mist);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    padding: 1.5rem 1.5rem 1.2rem;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    /* Safety net, not the fix itself: RadarChart's axis labels are absolutely
       positioned by percentage and can reach past the plot's edge on narrow
       viewports with long label text (confirmed live 2026-08-21, a real ~10px
       page-level horizontal scroll on mobile). Clipping here contains any
       chart's overflow at the card boundary -- tables/etc. still scroll fine
       internally via their own overflow-x:auto wrapper, unaffected by this. */
    overflow-x: hidden;
  }
  .chart-card.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  /* Without JS the IntersectionObserver never adds .in-view, so every chart stays at
     opacity:0 -- invisible, along with its data table. Confirmed live 2026-08-22: 8 of 8 cards
     invisible with scripting off, which is what an RSS reader, a text browser and most
     crawlers see. `scripting: none` covers those; the <noscript> block covers browsers that
     don't support the media query but do have JS switched off. The reveal is an enhancement,
     never a precondition for the content existing. */
  @media (scripting: none) {
    .chart-card {
      opacity: 1;
      transform: none;
    }
  }
  /* The data table. Open/closed is native <details> -- no JS, so it works in an RSS reader
     and with scripting off, which is the whole point of having it. */
  .chart-card__data {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }
  .chart-card__data > summary {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ember);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
  }
  .chart-card__data > summary::-webkit-details-marker { display: none; }
  .chart-card__data > summary::before {
    content: "▸";
    transition: transform 0.15s;
  }
  .chart-card__data[open] > summary::before { transform: rotate(90deg); }
  .chart-card__data-scroll { overflow-x: auto; margin-top: 0.5rem; }
  .chart-card__data table {
    border-collapse: collapse;
    font-size: 0.8rem;
    width: 100%;
  }
  .chart-card__data th,
  .chart-card__data td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .chart-card__data thead th {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .chart-card__data tbody th { font-weight: 600; }
  .chart-card__data td { font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) {
    .chart-card__data > summary::before { transition: none; }
  }

  .chart-card__image {
    display: block;
    width: calc(100% + 3rem);
    margin: -1.5rem -1.5rem 1.2rem;
    max-height: 16rem;
    object-fit: cover;
    border-radius: 0.6rem 0.6rem 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .chart-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  .chart-card__title {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    color: var(--ember);
    margin: 0 0 0.3rem;
  }
  .chart-card__desc {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 1.1rem;
    max-width: 38rem;
  }
  .chart-card__body {
    width: 100%;
    overflow-x: auto;
  }
  .chart-card__source {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin-top: 0.9rem;
  }
  .chart-card__source :global(a) {
    color: var(--ember);
  }
</style>

<script>
  if (!(window as any).__chartCardObserver) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    (window as any).__chartCardObserver = observer;
    if (!reduce) {
      document.querySelectorAll("[data-chart-card]").forEach((el) => observer.observe(el));
    } else {
      document.querySelectorAll("[data-chart-card]").forEach((el) => el.classList.add("in-view"));
    }
  }
</script>
