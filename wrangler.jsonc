{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kilowatto-com",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "kilowatto.com", "custom_domain": true },
    { "pattern": "www.kilowatto.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kilowatto-db",
      "database_id": "329e214b-e162-4955-ab8a-ccb257a81ea7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kilowatto-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KILOWATTO_KV",
      "id": "aac7c9dd450b4290adb5ab2a8264a9ae"
    },
    {
      "binding": "SESSION",
      "id": "1b7577c9bd244263883d8320e6020ecf"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "kilowatto-embeddings"
    },
    {
      "binding": "BRAND_FEEDBACK",
      "index_name": "kilowatto-brand-feedback"
    },
    {
      "binding": "PHOTO_VOICE",
      "index_name": "kilowatto-photo-voice"
    },
    {
      "binding": "PHOTO_DEDUP",
      "index_name": "kilowatto-photo-dedup"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "images": {
    "binding": "IMAGES"
  },
  "analytics_engine_datasets": [
    {
      "binding": "BRAND_ANALYTICS",
      "dataset": "kilowatto_brand_posts"
    },
    {
      "binding": "PAGE_ANALYTICS",
      "dataset": "kilowatto_page_views"
    }
  ]
  // TRANSLATE_INVESTIGACION_WORKFLOW is intentionally NOT declared here -- its class only
  // exists in dist/server/translate-investigacion-workflow.mjs, written post-build by
  // scripts/make-scheduled-entry.mjs (same reasoning as that file's `scheduled` export).
  // Declaring the binding here with no matching class would break `astro dev`/miniflare, which
  // reads this file directly. The real deploy config is dist/server/wrangler.json, see
  // package.json's "deploy" script.
}
